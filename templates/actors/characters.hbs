    {{!       ABA DE COMBATE (VERSÃO OTIMIZADA v3 - CARD UNIFICADO) }}
    {{! ========================================================= }}
    <div class="tab combat-tab" data-group="primary" data-tab="combat">

      {{! ========================================================= }}
      {{!       CONTAINER DE 2 COLUNAS (ESQUERDA ESTREITA)            }}
      {{! ========================================================= }}
      <div class="combat-main-content">

        {{! --- COLUNA DA ESQUERDA (ESTREITA) --- }}
        <div class="combat-left-column">

          {{! ================================================= }}
          {{!     PAINEL DE RD   }}
          {{! ================================================= }}
          <div class="gum-block dr-location-block">
            <div class="block-header">
              <h4>
                <span class="dr-header-title">Tabela de RD</span>
                <span class="dr-header-subtitle">{{bodyProfileLabel}}</span>
              </h4>
              <div class="header-controls">
                <a class="view-hit-locations" title="Editar Modificadores de RD"><i class="fas fa-edit"></i></a>
              </div>
            </div>
            
<ol class="dr-location-list">
              {{#each drDisplayRows as |row|}}
                {{#if row.isGroup}}
                  <li class="dr-location-row dr-group" data-group-id="{{row.id}}">
                    <div class="dr-row-main">
                      <div class="dr-row-start">
                      <button class="dr-group-toggle" type="button" title="Expandir grupo">
                        <i class="fas fa-chevron-right"></i>
                      </button>
                      <span class="location-name">{{row.label}}</span>
                      </div>
                      <span class="location-dr-value">{{row.base}}</span>
                    </div>
                    {{#if row.extraLine}}
                      <div class="dr-row-extra">{{row.extraLine}}</div>
                    {{/if}}
                    <ol class="dr-group-children">
                      {{#each row.children as |child|}}
                        <li class="dr-location-row is-child {{#if child.extraLine}}has-extra{{/if}}" data-location-key="{{child.key}}">
                          <div class="dr-row-main">
                            <span class="location-name">{{child.label}}</span>
                            <span class="location-dr-value">{{child.base}}</span>
                          </div>
                          {{#if child.extraLine}}
                            <div class="dr-row-extra is-child">{{child.extraLine}}</div>
                          {{/if}}
                        </li>

                      {{/each}}
                    </ol>
                  </li>
                {{else}}
                  <li class="dr-location-row {{#if row.extraLine}}has-extra{{/if}}" data-location-key="{{row.key}}">
                    <div class="dr-row-main">
                      <span class="location-name">{{row.label}}</span>
                      <span class="location-dr-value">{{row.base}}</span>
                    </div>
                    {{#if row.extraLine}}
                      <div class="dr-row-extra">{{row.extraLine}}</div>
                    {{/if}}
                  </li>
                {{/if}}
              {{/each}}
            </ol>
          </div>
</div>

        {{! --- COLUNA DA DIREITA (LARGA) --- }}
        <div class="combat-right-column">

          <div class="combat-area-label" aria-hidden="true"><span>Controle de Combate</span></div>

          {{!-- Grupo fixo de Registros de Combate --}}
          <div class="attack-group-list-v2 combat-fixed-groups-list">
            <details class="attack-group-details gum-unified-section combat-fixed-group wounds-box" data-group-id="wounds-group" {{collapsibleState "wounds-group" @root.collapsedData}}>
              <summary class="group-summary gum-unified-header">
                <div class="summary-left"><i class="fas fa-chevron-right indicator"></i><i class="fas fa-bandage item-icon"></i><span class="group-name">Ferimentos</span></div>
                <div class="summary-right"><span class="group-tag">{{preparedWounds.length}} card(s)</span><a class="add-wound" title="Adicionar Ferimento"><i class="fas fa-plus"></i></a></div>
              </summary>
              <div class="group-content wound-list">
                <div class="wound-grid">
                  {{#each preparedWounds}}
                    <article class="wound-card" data-wound-id="{{this.id}}" title="{{this.woundTooltip}}" aria-label="Ferimento: {{this.woundTooltip}}">
                      <i class="fas {{this.natureIcon}} wound-nature-icon" title="{{this.natureTooltip}}" aria-label="{{this.natureTooltip}}"></i>
                      <div class="wound-value-controls">
                        <button type="button" class="adjust-wound wound-adjust" data-adjustment="-1" title="Diminuir ferimento em uma unidade" aria-label="Diminuir ferimento em uma unidade"><i class="fas fa-minus" aria-hidden="true"></i></button>
                        <strong class="wound-value" aria-label="Valor restante: {{this.remaining}}">{{this.remaining}}</strong>
                        <button type="button" class="adjust-wound wound-adjust" data-adjustment="1" title="Aumentar ferimento em uma unidade" aria-label="Aumentar ferimento em uma unidade"><i class="fas fa-plus" aria-hidden="true"></i></button>
                      </div>
                      <div class="item-controls wound-controls">
                        <div class="gum-action-menu js-action-menu">
                          <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="Opções do ferimento" aria-label="Opções do ferimento" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                          <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="Ações do ferimento">
                            <a class="item-control edit-wound gum-action-menu__item" role="menuitem" title="Editar"><i class="fas fa-edit"></i><span>Editar</span></a>
                            <a class="item-control delete-wound gum-action-menu__item is-danger" role="menuitem" title="Excluir"><i class="fas fa-trash"></i><span>Excluir</span></a>
                          </div>
                        </div>
                      </div>
                    </article>
                  {{else}}<div class="placeholder-text">Nenhum ferimento registrado.</div>{{/each}}
                </div>
              </div>
            </details>
            <details class="attack-group-details gum-unified-section combat-meters-box combat-fixed-group" data-group-id="combat-meters-group" {{collapsibleState "combat-meters-group" @root.collapsedData}}>
              <summary class="group-summary gum-unified-header">
                <div class="summary-left">
                  <i class="fas fa-chevron-right indicator"></i>
                  <i class="fas fa-clipboard-list item-icon"></i>
                  <span class="group-name">Registros de Combate</span>
                </div>
                <div class="summary-right">
                  <span class="group-tag">{{preparedCombatMeters.length}} registro(s)</span>
 
                  <a class="add-combat-meter" title="Adicionar Registro"><i class="fas fa-plus"></i></a>
                </div>
              </summary>
              <div class="group-content combat-meter-group-content">
                <div class="combat-meter-grid">
                  {{#each preparedCombatMeters}}
                    <article class="meter-card combat-meter-card" data-meter-id="{{this.id}}" title="{{this.meter.name}} — referência {{this.meter.max}}, RD {{this.meter.dr}}" aria-label="Registro {{this.meter.name}}: valor {{this.meter.current}}, referência {{this.meter.max}}, RD {{this.meter.dr}}">
                      <header class="combat-meter-card-header">
                        <i class="fas fa-clipboard-list combat-meter-icon" aria-hidden="true"></i>
                        <strong class="combat-meter-name">{{this.meter.name}}</strong>
                        <div class="item-controls combat-meter-controls">
                          <div class="gum-action-menu js-action-menu">
                            <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="Opções do registro" aria-label="Opções do registro" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                            <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="Ações do registro">
                              <a class="item-control edit-combat-meter gum-action-menu__item" role="menuitem" title="Editar"><i class="fas fa-edit"></i><span>Editar</span></a>
                              <a class="item-control delete-combat-meter gum-action-menu__item is-danger" role="menuitem" title="Excluir"><i class="fas fa-trash"></i><span>Excluir</span></a>
                            </div>
                          </div>
                        </div>
                                              </header>
                      <div class="combat-meter-value-controls">
                        <button type="button" class="adjust-combat-meter combat-meter-adjust" data-adjustment="-1" title="Diminuir valor em uma unidade" aria-label="Diminuir {{this.meter.name}} em uma unidade"><i class="fas fa-minus" aria-hidden="true"></i></button>
                        <strong class="combat-meter-value" aria-label="Valor atual: {{this.meter.current}}">{{this.meter.current}}</strong>
                        <button type="button" class="adjust-combat-meter combat-meter-adjust" data-adjustment="1" title="Aumentar valor em uma unidade" aria-label="Aumentar {{this.meter.name}} em uma unidade"><i class="fas fa-plus" aria-hidden="true"></i></button>
                      </div>
                      <div class="combat-meter-meta" aria-hidden="true"><span>ref. <strong>{{this.meter.max}}</strong></span><span class="combat-meter-meta-separator">·</span><span>RD <strong>{{this.meter.dr}}</strong></span></div>
                    </article>
                  {{else}}<div class="placeholder-text combat-meter-placeholder">Nenhum registro criado.</div>{{/each}}
                </div>
              </div>
            </details>
          </div>



          <div class="combat-area-label" aria-hidden="true"><span>Ações de Combate</span></div>

          {{!-- Grupo fixo de Favoritos de Combate --}}
          <div class="attack-group-list-v2 combat-favorites-list">
            <details class="attack-group-details gum-unified-section combat-fixed-group combat-favorites-wrapper" data-group-id="combat-favorites-root" {{collapsibleState "combat-favorites-root" @root.collapsedData}}>
              <summary class="group-summary gum-unified-header" style="background: var(--gum-bg-cabecalho);">
                <div class="summary-left">
                  <i class="fas fa-chevron-right indicator"></i>
                  <i class="fas fa-star item-icon"></i>
                  <span class="group-name">Favoritos</span>
                </div>
                <div class="summary-right">
                  <span class="group-tag">{{combatFavoriteGroupKeys.length}} grupo(s)</span>
                </div>
              </summary>
              <div class="group-content combat-favorites-root-content">
            {{#each combatFavoriteGroupKeys as |groupName groupIndex|}}
              {{#with (lookup @root.combatFavoritesByGroup groupName)}}
              <details class="attack-group-details gum-unified-section" data-group-id="combat-favorites-group-{{groupIndex}}" {{collapsibleState (concat "combat-favorites-group-" groupIndex) @root.collapsedData}}>
                <summary class="group-summary gum-unified-header">
                  <div class="summary-left">
                    <i class="fas fa-chevron-right indicator"></i>
                    <i class="fas fa-star item-icon"></i>
                    <span class="group-name">{{groupName}}</span>
                  </div>
                  <div class="summary-right">
                    <span class="group-tag">
                      {{this.length}} favorito(s)</span>
                  </div>
                </summary>
                <div class="group-content">
                  {{#each this}}
                    {{#if (or (eq this.type "advantage") (eq this.type "disadvantage"))}}
                    <li class="item characteristic-card" data-item-id="{{this.id}}" draggable="true">
                      <img src="{{this.img}}" class="item-icon" alt="{{this.name}}"/>
                      <div class="card-info">
                        <div class="card-main">
                          <span class="item-name"><a class="item-quick-view" title="Visualizar Descrição">{{this.name}}{{#if this.system.specialization}} ({{this.system.specialization}}){{/if}} {{#if this.system.level}}{{this.system.level}}{{/if}}</a></span>
                          {{#if this.system.characteristics}}<span class="characteristic-notes">{{this.system.characteristics}}</span>{{/if}}
                        </div>
                        <div class="card-details">
                          {{#if this.system.self_control_roll}}<a class="rollable card-cr" title="Teste de Autocontrole" data-type="attribute" data-roll-value="{{this.system.self_control_roll}}" data-label="Autocontrole: {{this.name}}" data-item-id="{{this.id}}">CR: {{this.system.self_control_roll}}</a>{{/if}}
                              <span class="card-points" title="Custo em Pontos">{{characteristicPoints this}} pts</span>
                        </div>
                      </div>
                      <div class="item-controls"><a class="item-edit" title="Editar"><i class="fas fa-edit"></i></a><a class="item-delete" title="Deletar"><i class="fas fa-trash"></i></a></div>
                    </li>
                    {{/if}}

                    {{#if (eq this.type "skill")}}
                    <li class="item skill-tree-item {{this.indentClass}} {{#if this.isTrunk}}is-trunk{{/if}}" data-item-id="{{this._id}}" data-item-type="skill" draggable="true">
                      <div class="st-item-icon item-quick-view" style="background-image: url('{{this.img}}');" title="Visualizar Perícia"></div>
                      <div class="st-item-name">
                       <h4 class="item-quick-view" title="Clique para ver detalhes">
                          {{this.name}}
                        </h4>
                        <div class="st-inheritance-path">
                          <div class="st-meta">
                            {{#unless this.isTrunk}}<span>[{{this.skillListDisplay.difficulty}}]</span>{{/unless}}
                          </div>
                          {{#if (ne this.skillListDisplay.nhMod 0)}}
                          <span class="path-node mod" title="Modificador Base">
                            <i class="fas fa-adjust"></i>
                            <span class="path-val">{{#if (gte this.skillListDisplay.nhMod 0)}}+{{/if}}{{this.skillListDisplay.nhMod}}</span>
                          </span>
                          {{/if}}
                          {{#if (ne this.skillListDisplay.treeDefaultMod 0)}}
                          <span class="path-node mod" title="Pré-definido da Árvore (aplicado somente a esta perícia)">
                            <i class="fas fa-tree"></i>
                            <span class="path-val">{{#if (gte this.skillListDisplay.treeDefaultMod 0)}}+{{/if}}{{this.skillListDisplay.treeDefaultMod}}</span>
                          </span>
                          {{/if}}
                          <span class="path-node self" title="Base: {{this.skillListDisplay.baseAttribute}}">
                            <i class="fas fa-chevron-right path-separator"></i> {{this.skillListDisplay.baseAttribute}}
                            <span class="path-val">{{#if (gte this.skillListDisplay.skillLevel 0)}}+{{/if}}{{this.skillListDisplay.skillLevel}}</span>
                          </span>
                            {{#if (or this.modifierIndicators.included.visible this.modifierIndicators.roll.visible)}}<span class="skill-modifier-indicators">
                            {{#if this.modifierIndicators.included.visible}}<span class="skill-modifier-tag is-included" title="{{this.modifierIndicators.included.title}}" aria-label="{{this.modifierIndicators.included.title}}">NH</span>{{/if}}
                            {{#if this.modifierIndicators.roll.visible}}<span class="skill-modifier-tag is-roll {{this.modifierIndicators.roll.className}}" title="{{this.modifierIndicators.roll.title}}" aria-label="{{this.modifierIndicators.roll.title}}">ROL {{#if (gte this.modifierIndicators.roll.total 0)}}+{{/if}}{{this.modifierIndicators.roll.total}}</span>{{/if}}
                          </span>{{/if}}
                        </div>
                      </div>
                      <div class="st-nh-box">
                        <span>NH</span>
                        <a class="rollable" data-roll-value="{{#if this.tree_final_nh}}{{this.tree_final_nh}}{{else}}{{this.system.final_nh}}{{/if}}" data-label="Teste de {{this.name}}" data-type="skill" data-item-id="{{this._id}}" data-attribute-key="{{this.skillListDisplay.baseAttribute}}">{{#if this.tree_final_nh}}{{this.tree_final_nh}}{{else}}{{this.system.final_nh}}{{/if}}</a>
                      </div>
                      <div class="st-controls">
                        <a class="item-control item-edit" title="Editar Ficha"><i class="fas fa-edit"></i></a>
                        <a class="item-control item-delete" title="Excluir"><i class="fas fa-trash"></i></a>
                      </div>
                    </li>
                    {{/if}}

                    {{#if (or (eq this.type "spell") (eq this.type "power"))}}
                    <div class="item-wrapper item spell-row-v3 spell-card-two-line" data-item-id="{{this.id}}" draggable="true">
                      <div class="spell-card-primary">
                        <img class="spell-thumb" src="{{this.img}}" alt="{{this.name}}">

                        <div class="spell-name-stack">
                          <h4 class="spell-name item-quick-view" title="Visualizar Card">{{this.name}}</h4>
                          <div class="spell-school-line">
                            {{#if (eq this.type "spell")}}{{this.system.source}} · {{this.system.spell_class}} · {{this.system.spell_school}}{{/if}}
                            {{#if (eq this.type "power")}}{{this.system.source}} · {{this.system.spell_class}}{{/if}}
                          </div>
                        </div>

                        <div class="spell-primary-stats">
                          <div class="spell-meta-cell spell-pill-stat">
                            <span class="spell-meta-label">NH</span>
                            <a class="rollable spell-meta-value" data-type="{{this.type}}" data-roll-value="{{this.system.final_nh}}" data-label="Teste de {{this.name}}" data-item-id="{{this.id}}">{{this.system.final_nh}}</a>
                          </div>

                          {{#if this.system.uses_attack}}
                          <div class="spell-meta-cell spell-pill-stat attack">
                            <span class="spell-meta-label">Atq</span>
                            {{#if this.system.attack_nh}}
                            <a class="rollable spell-meta-value" data-type="attack" data-attack-type="{{this.system.attack_type}}" data-attribute-key="{{this.system.attack_roll.skill_name}}" data-roll-value="{{this.system.attack_nh}}" data-label="Ataque de {{this.name}}" data-item-id="{{this.id}}" title="{{this.system.attack_roll.resolved_skill_name}}">{{this.system.attack_nh}}</a>
                            {{else}}
                            <span class="spell-meta-value" title="Configure uma perícia de ataque.">—</span>
                            {{/if}}
                          </div>
                          {{/if}}

                          <div class="spell-meta-cell spell-pill-stat damage">
                            <span class="spell-meta-label">Dano</span>
                            {{#if this.system.damage.formula}}
                            <a class="rollable-damage spell-meta-value" title="Rolar Dano" data-item-id="{{this.id}}">{{this.system.damage.formula}} {{this.system.damage.type}}{{#if this.system.damage.scaling}} ({{this.system.damage.scaling}}){{/if}}</a>
                            {{else}}
                            <span class="spell-meta-value">—</span>
                            {{/if}}
                          </div>
                        </div>

                        <div class="item-controls spell-controls-row">
                          <div class="gum-action-menu js-action-menu">
                            <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="Opções" aria-label="Opções" role="button" aria-haspopup="true" aria-expanded="false">
                              <i class="fas fa-ellipsis-v"></i>
                            </a>
                            <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="Ações">
                              <a class="item-control item-quick-view gum-action-menu__item" role="menuitem" title="Visualizar"><i class="fas fa-eye"></i><span>Visualizar</span></a>
                              <a class="item-control item-edit gum-action-menu__item" role="menuitem" title="Editar"><i class="fas fa-edit"></i><span>Editar</span></a>
                              <a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem" title="Deletar"><i class="fas fa-trash"></i><span>Deletar</span></a>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="spell-card-secondary">
                        {{#if (eq this.type "spell")}}
                        <span><strong>Conj.</strong> {{this.system.casting_time}}</span>
                        <span><strong>Duração</strong> {{this.system.duration}}</span>
                        <span><strong>Custo</strong> {{this.system.mana_cost}}</span>
                        <span><strong>Mant.</strong> {{this.system.mana_maint}}</span>
                        {{/if}}
                        {{#if (eq this.type "power")}}
                        <span><strong>Ativ.</strong> {{this.system.activation_time}}</span>
                        <span><strong>Duração</strong> {{this.system.duration}}</span>
                        <span><strong>Custo</strong> {{this.system.activation_cost}}</span>
                        <span><strong>Mant.</strong> {{this.system.maint_cost}}</span>
                        {{/if}}
                        {{#if this.system.uses_attack}}
                        <span class="spell-attack-source"><strong>Perícia</strong> {{#if this.system.attack_roll.resolved_skill_name}}{{this.system.attack_roll.resolved_skill_name}}{{else}}{{this.system.attack_roll.skill_name}}{{/if}}</span>
                        {{/if}}
                        {{#if this.system.damage.follow_up_damage.formula}}
                        <span class="spell-damage-extra"><strong>FU</strong> {{this.system.damage.follow_up_damage.formula}} {{this.system.damage.follow_up_damage.type}}{{#if this.system.damage.follow_up_damage.scaling}} ({{this.system.damage.follow_up_damage.scaling}}){{/if}}</span>
                        {{/if}}
                        {{#if this.system.damage.fragmentation_damage.formula}}
                        <span class="spell-damage-extra"><strong>FR</strong> {{this.system.damage.fragmentation_damage.formula}} {{this.system.damage.fragmentation_damage.type}}{{#if this.system.damage.fragmentation_damage.scaling}} ({{this.system.damage.fragmentation_damage.scaling}}){{/if}}</span>
                        {{/if}}
                      </div>
                    </div>
                    {{/if}}
                  {{/each}}
                </div>
              </details>
              {{/with}}
            {{/each}}
                {{#unless combatFavoriteGroupKeys}}
                  <div class="placeholder-text" style="color:#c2c2c2">Nenhum favorito marcado para combate.</div>
                {{/unless}}
              </div>
            </details>
          </div>

          {{!-- Bloco de Lista de ataque --}}
    <div class="attack-group-list-v2 combat-actions-list">
    {{#each attackGroups as |group|}}
    {{!-- USANDO group.id EM VEZ DE group.name --}}
    <details class="attack-group-details gum-unified-section" data-group-id="attack-group-{{group.id}}" {{collapsibleState (concat "attack-group-" group.id) @root.collapsedData}}>
    
        <summary class="group-summary gum-unified-header">
            <div class="summary-left">
            <i class="fas fa-chevron-right indicator"></i>
            <i class="fas fa-khanda-alt item-icon"></i> 
            <span class="group-name">{{group.name}}</span>
            </div>
            
            <div class="summary-right">
            {{#if (gt group.weight 0)}}
                <span class="group-tag weight">{{group.weight}} kg</span>
            {{/if}}
            {{#if (gt group.defense_bonus 0)}}
                <span class="group-tag db" title="Bônus de Defesa">BD +{{group.defense_bonus}}</span>
            {{/if}}
            <a class="item-control item-edit" data-item-id="{{group.id}}" title="Abrir Ficha do Item">
                <i class="fas fa-cog"></i>
            </a>
            </div>
        </summary>

        <div class="group-content">
            {{#each group.attacks as |attack|}}
              <div class="attack-row item-row attack-card-two-line attack-card-two-line--{{attack.attack_type}}" data-attack-id="{{attack.id}}" data-item-id="{{attack.itemId}}">
                <div class="attack-card-primary">
                  <div class="attack-icon">
                    {{#if (eq attack.attack_type "melee")}}<i class="fas fa-swords" title="Corpo a Corpo"></i>{{/if}}
                    {{#if (eq attack.attack_type "ranged")}}<i class="fas fa-bullseye" title="À Distância"></i>{{/if}}
                  </div>

                  <div class="attack-name-stack">
                    <h4 class="attack-name">{{attack.name}}</h4>
                    <div class="attack-source-line">{{attack.skill_name}}</div>
                  </div>

                  <div class="attack-primary-stats">
<a class="attack-pill-stat rollable" data-type="attack" data-attack-type="{{attack.attack_type}}" data-roll-value="{{attack.final_nh}}" data-label="{{group.name}} ({{attack.name}})" data-item-id="{{attack.itemId}}" title="Rolar ataque">
                      <span class="attack-label">NH</span>
                      <span class="attack-value">{{attack.final_nh}}</span>
                    </a>

                    <a class="attack-pill-stat damage rollable-damage"
                        title="Rolar dano"
                        data-item-id="{{attack.itemId}}"
                        data-attack-id="{{attack.id}}"
                        data-dmg-formula="{{attack.damage_formula}}"
                        data-dmg-type="{{attack.damage_type}}"
                        data-armor-divisor="{{attack.armor_divisor}}"
                        {{#with attack.follow_up_damage}}
                          {{#if this.formula}}
                            data-followup-formula="{{this.formula}}"
                            data-followup-type="{{this.type}}"
                          {{/if}}
                        {{/with}}>
                      <span class="attack-label">Dano</span>
                      <span class="attack-value attack-damage-main">
                          {{attack.damage_display_formula}}{{#if (gt attack.armor_divisor 1)}}({{attack.armor_divisor}}){{/if}} {{attack.damage_type}}{{#if attack.damage_scaling}} ({{attack.damage_scaling}}){{/if}}
                      </span>
                    </a>

                    {{#if (eq attack.attack_type "melee")}}
                    {{#if attack.final_parry}}
                    <a class="attack-pill-stat defense rollable" data-type="defense" data-roll-value="{{attack.final_parry}}" data-label="Teste de Aparar" data-defense-type="parry" title="Rolar aparar">
                      <span class="attack-label">APR</span>
                      <span class="attack-value">{{attack.final_parry}}</span>
                    </a>
                      {{else}}
                    <div class="attack-pill-stat defense is-disabled">
                      <span class="attack-label">APR</span>
                      <span class="attack-value is-empty" title="Este modo não permite aparar" aria-label="Aparar indisponível">—</span>
                    </div>
                    {{/if}}
                    {{#if attack.final_block}}
                    <a class="attack-pill-stat defense rollable" data-type="defense" data-roll-value="{{attack.final_block}}" data-label="Teste de Bloqueio" data-defense-type="block" title="Rolar bloqueio">
                      <span class="attack-label">BLQ</span>
                      <span class="attack-value">{{attack.final_block}}</span>
                    </a>
                      {{else}}
                    <div class="attack-pill-stat defense is-disabled">
                      <span class="attack-label">BLQ</span>
                      <span class="attack-value is-empty" title="Este modo não permite bloquear" aria-label="Bloqueio indisponível">—</span>
                    </div>
                    {{/if}}
                    {{/if}}
                  </div>
                </div>

                <div class="attack-card-secondary">
                  {{#if (eq attack.attack_type "melee")}}
                  <span><strong>Alc.</strong> {{attack.reach}}</span>
                  <span><strong>ST Min</strong> {{attack.min_strength}}</span>
                  {{#if attack.unbalanced}}<span class="attack-secondary-flag"><strong>U</strong> Desbalanceada</span>{{/if}}
                  {{#if attack.fencing}}<span class="attack-secondary-flag"><strong>F</strong> Esgrima</span>{{/if}}
                  {{/if}}

                  {{#if (eq attack.attack_type "ranged")}}
                  {{#if attack.range}}<span><strong>Alc.</strong> {{attack.range}}</span>{{/if}}
                  <span><strong>Prec</strong> {{attack.accuracy}}</span>
                  <span><strong>CdT</strong> {{#if attack.rof}}{{attack.rof}}{{else}}—{{/if}}</span>
                  <span><strong>Tiros</strong> {{#if attack.shots}}{{attack.shots}}{{else}}—{{/if}}</span>
                  <span><strong>RCO</strong> {{#if attack.rcl}}{{attack.rcl}}{{else}}—{{/if}}</span>
                  <span><strong>Mag</strong> {{attack.mag}}</span>
                  <span><strong>ST Min</strong> {{attack.min_strength}}</span>
                  {{/if}}

                  {{#with attack.fragmentation_damage}}
                    {{#if this.formula}}
                    <span class="attack-damage-extra"><strong>FR</strong> {{this.display_formula}} {{this.type}}</span>
                    {{/if}}
                  {{/with}}
                  {{#with attack.follow_up_damage}}
                    {{#if this.formula}}
                    <span class="attack-damage-extra"><strong>FU</strong> {{this.display_formula}} {{this.type}}</span>
                    {{/if}}
                  {{/with}}
                </div>
              </div>
            {{/each}}
        </div>
    </details>
    {{/each}}
    {{#unless attackGroups}}
    <div class="placeholder-text">Nenhum ataque disponível.</div>
    {{/unless}}
</div>

        </div>
        
      </div>    
    </div>

    {{! ========================================================= }}
    {{!  ABA DE BIOGRAFIA (ESTRUTURA REFINADA E PADRONIZADA)      }}
    {{! ========================================================= }}
    <div class="tab" data-group="primary" data-tab="biography">
     
      <div class="biography-layout">

        {{!-- Coluna Lateral: Perfil do Personagem --}}
        <div class="biography-details">
          <section class="biography-models-block" aria-label="Modelos aplicados">
            <div class="biography-models-grid">
              <div class="biography-models-action">
                <button type="button" class="add-character-model-btn biography-model-add-btn" {{#if modelsPending}}disabled{{/if}}>
                  <i class="fas fa-plus"></i> Modelo
                </button>
              </div>
              <span class="biography-models-divider" aria-hidden="true">|</span>
              <div class="biography-models-tags">
                {{#if appliedModels.length}}
                <div class="character-model-applied-list">
                  {{#each appliedModels as |model|}}
                  <span class="character-model-pill" title="Aplicado em {{model.appliedAtLabel}}">
                    <span class="character-model-pill-label">{{model.templateName}}</span>
                    {{#if model.pending}}
                    <span>{{model.stateLabel}}</span>
                    <button type="button" class="resume-character-model-btn" data-application-id="{{model.applicationId}}" style="color: var(--gum-text-claro, #f0ebe3); width: auto; min-width: 0; flex: 0 0 auto; padding: 2px 8px;">Retomar</button>
                    {{else}}
                    <button type="button" class="remove-character-model-btn" data-application-id="{{model.applicationId}}" title="Remover modelo" {{#if model.blocked}}disabled{{/if}}>
                      <i class="fas fa-times"></i>
                    </button>
                    {{/if}}
                  </span>
                  {{/each}}
                </div>
                {{else}}
                <p class="character-model-empty">Nenhum modelo aplicado.</p>
                {{/if}}
              </div>
            </div>
          </section>

          {{!-- A classe .skill-block será o "card" padrão no novo design --}}
          <div class="skill-block biography-profile-card">
            <div class="block-header">
              <h4>Perfil</h4>
              <a class="edit-biography-details" title="Editar Perfil"><i class="fas fa-edit"></i></a>
            </div>
            <div class="details-display-list">

              {{!-- a classe .item-row para padronização futura --}}
              <div class="item-row detail-item">
                <span class="detail-label">Gênero:</span>
                <span class="detail-value">{{actor.system.details.gender}}</span>
              </div>
              <div class="item-row detail-item">
                <span class="detail-label">Idade:</span>
                <span class="detail-value">{{actor.system.details.age}}</span>
              </div>
              <div class="item-row detail-item">
                <span class="detail-label">Altura:</span>
                <span class="detail-value">{{actor.system.details.height}}</span>
              </div>
              <div class="item-row detail-item">
                <span class="detail-label">Peso:</span>
                <span class="detail-value">{{actor.system.details.weight}}</span>
              </div>
              <div class="item-row detail-item">
                <span class="detail-label">Pele:</span>
                <span class="detail-value">{{actor.system.details.skin}}</span>
              </div>
              <div class="item-row detail-item">
                <span class="detail-label">Cabelos:</span>
                <span class="detail-value">{{actor.system.details.hair}}</span>
              </div>
              <div class="item-row detail-item full-width">
                <span class="detail-label">Olhos:</span>
                <span class="detail-value">{{actor.system.details.eyes}}</span>
              </div>
              <div class="item-row detail-item full-width">
                <span class="detail-label">Alinhamento:</span>
                <span class="detail-value">{{actor.system.details.alignment}}</span>
              </div>
 <div class="item-row detail-item full-width">
                <span class="detail-label">Crença / Fé:</span>
                <span class="detail-value">{{actor.system.details.belief}}</span>
              </div>
              
            </div>
          </div>
        </div>

    {{!-- Coluna Principal: Notas --}}
    <div class="biography-details">
    <div class="biography-story skill-block biography-story-card">
        <div class="block-header biography-story-header">
            <h4>Notas</h4>
            {{#if editable}}
            <a class="toggle-editor biography-story-toggle" data-target="system.details.backstory" title="Editar Notas">
                <i class="fas fa-edit"></i>
            </a>
            {{/if}}
        </div>
        
        {{!-- ✅ INÍCIO: Nova estrutura de Editor de Texto --}}
        <div class="description-section">
            
            {{!-- 1. Modo de Visualização (Texto Renderizado) --}}
            <div class="description-view">
                {{{enrichedBackstory}}}
            </div>

            {{!-- 3. Modo de Edição (Escondido) --}}
            <div class="description-editor" style="display: none;">
                {{!-- O editor em si (note button=false) --}}
               {{editor actor.system.details.backstory target="system.details.backstory" engine="prosemirror" button=false owner=owner editable=editable}}
                
                {{!-- Botões Salvar/Cancelar --}}
                <div class="description-editor-actions">
                        {{!-- Botões Salvar/Cancelar --}}
                        <button type="button" class="save-description" data-field="system.details.backstory">
                            <i class="fas fa-save"></i> Salvar
                        </button>
                        <button type="button" class="expand-description" data-expanded="false">
                            <i class="fas fa-expand"></i> Expandir
                        </button>
                        <button type="button" class="cancel-description">
                            <i class="fas fa-times"></i> Cancelar
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {{!-- ✅ FIM: Nova estrutura de Editor de Texto --}}
        
    </div>
    </div>
  </div>
{{!-- ============================================================= --}}
{{!--     ABA DE CONDIÇÕES ("CASTELO SÓLIDO" V5 - FINAL)            --}}
{{!-- ============================================================= --}}
<div class="tab conditions-tab" data-group="primary" data-tab="conditions">

    {{!-- ============================================================= --}}
    {{!--     SEÇÃO 1: EFEITOS TEMPORÁRIOS                              --}}
    {{!-- ============================================================= --}}
    <details class="form-section gum-details temporary-section gum-unified-section" data-group-id="cond-temp" {{collapsibleState "cond-temp" @root.collapsedData}}>
        <summary class="block-header gum-unified-header">
            <div class="header-left">
                <i class="fas fa-chevron-right indicator"></i>
                <span class="header-title">Efeitos Temporários</span>
                <span class="header-counter">{{temporaryEffects.length}}</span>
            </div>
            <p class="header-hint">Duração limitada (rodadas, minutos).</p>
        </summary>
        
        <div class="effects-grid-container"> 
            {{#each temporaryEffectGroups as |group|}}
            <details class="effect-origin-group gum-details" data-group-id="cond-temp-origin-{{group.key}}" {{collapsibleState (concat "cond-temp-origin-" group.key) @root.collapsedData}}>
                <summary class="effect-origin-summary">
                    <span class="origin-heading"><i class="{{group.icon}}"></i> {{group.label}}</span>
                    <span class="header-counter">{{group.effects.length}}</span>
                    <i class="fas fa-chevron-right indicator"></i>
                </summary>
                <div class="effect-origin-list">
            {{#each group.effects as |effect|}}
                <div class="effect-pill-enhanced temp-effect" data-effect-id="{{effect.id}}">
                    <div class="pill-switch-wrapper">
                        <label class="switch" title="Ativar/Desativar efeito">
                            <input type="checkbox" class="effect-toggle" data-effect-id="{{effect.id}}" {{checked effect.disabled}}>
                            <span class="slider round"></span>
                        </label>
                    </div>
                    <img src="{{effect.img}}" class="pill-icon" title="{{effect.name}}"/>
                    <div class="pill-info">
                        <span class="pill-name">{{effect.name}}</span>
                        <div class="pill-details">
                            <span class="pill-tag duration" title="Duração Restante">
                                <i class="fas fa-hourglass-half"></i> {{effect.durationString}}
                            </span>
                            {{#if effect.disabled}}
                                <span class="pill-tag status off">Desativado</span>
                            {{else}}
                                <span class="pill-tag status on">Ativo</span>
                            {{/if}}
                            {{#if effect.appliedStatusLabel}}
                                <span class="pill-tag status-applied">Status aplicado: {{effect.appliedStatusLabel}}</span>
                            {{/if}}
                            {{#if effect.fonteNome}}
                            <span class="pill-tag source" title="Fonte: {{effect.fonteNome}}">
                                <i class="{{effect.fonteIcon}}"></i> {{effect.fonteRotulo}} · {{effect.fonteNome}}
                            </span>
                            {{/if}}
                        </div>
                    </div>
                    <div class="pill-controls">
                        <a class="effect-control quick-view-origin" title="Visualizar Fonte" data-origin-uuid="{{effect.fonteUuid}}"><i class="fas fa-eye"></i></a>
                        <a class="effect-control delete" data-action="delete-effect" data-effect-id="{{effect.id}}" title="Remover"><i class="fas fa-trash"></i></a>
                    </div>
                 </div>
            {{/each}}
                </div>
            </details>
            {{/each}}
            
            {{#unless temporaryEffects.length}}
                <div class="placeholder-text">Nenhum efeito temporário ativo.</div>
            {{/unless}}
        </div>
    </details>

    {{!-- ============================================================= --}}
    {{!--     SEÇÃO 2: EFEITOS PERMANENTES                              --}}
    {{!-- ============================================================= --}}
    <details class="form-section gum-details permanent-section gum-unified-section" data-group-id="cond-perm" {{collapsibleState "cond-perm" @root.collapsedData}}>
        <summary class="block-header gum-unified-header">
            <div class="header-left">
                <i class="fas fa-chevron-right indicator"></i>
                <span class="header-title">Efeitos Permanentes</span>
                <span class="header-counter">{{permanentEffects.length}}</span>
            </div>
            <p class="header-hint">Vantagens, equipamentos e passivos.</p>
        </summary>
        
        <div class="effects-grid-container"> 
           {{#each permanentEffectGroups as |group|}}
            <details class="effect-origin-group gum-details" data-group-id="cond-perm-origin-{{group.key}}" {{collapsibleState (concat "cond-perm-origin-" group.key) @root.collapsedData}}>
                <summary class="effect-origin-summary">
                    <span class="origin-heading"><i class="{{group.icon}}"></i> {{group.label}}</span>
                    <span class="header-counter">{{group.effects.length}}</span>
                    <i class="fas fa-chevron-right indicator"></i>
                </summary>
                <div class="effect-origin-list">
            {{#each group.effects as |effect|}}
                <div class="effect-pill-enhanced perm-effect" data-effect-id="{{effect.id}}">
                    <div class="pill-switch-wrapper">
                        <label class="switch" title="Ativar/Desativar efeito">
                            <input type="checkbox" class="effect-toggle" data-effect-id="{{effect.id}}" {{checked effect.disabled}}>
                            <span class="slider round"></span>
                        </label>
                    </div>
                    <img src="{{effect.img}}" class="pill-icon" title="{{effect.name}}"/>
                    <div class="pill-info">
                        <span class="pill-name">{{effect.name}}</span>
                        <div class="pill-details">
                           {{#if effect.disabled}}
                                <span class="pill-tag status off">Desativado</span>
                            {{else}}
                                <span class="pill-tag status on">Ativo</span>
                            {{/if}}
                            {{#if effect.appliedStatusLabel}}
                                <span class="pill-tag status-applied">Status aplicado: {{effect.appliedStatusLabel}}</span>
                            {{/if}}
                            <span class="pill-tag source" title="Fonte: {{effect.fonteNome}}">
                                <i class="{{effect.fonteIcon}}"></i> {{effect.fonteRotulo}} · {{effect.fonteNome}}
                            </span>
                        </div>
                    </div>
                    <div class="pill-controls">
                        <a class="effect-control quick-view-origin" title="Visualizar Fonte" data-origin-uuid="{{effect.fonteUuid}}"><i class="fas fa-eye"></i></a>
                        <a class="effect-control delete" data-action="delete-effect" data-effect-id="{{effect.id}}" title="Remover"><i class="fas fa-times"></i></a>
                    </div>
                     </div>
            {{/each}}
                </div>
            </details>
            {{/each}}
            
            {{#unless permanentEffects.length}}
                <div class="placeholder-text">Nenhum efeito permanente.</div>
            {{/unless}}
        </div>
    </details>

    {{!-- ============================================================= --}}
    {{!--     SEÇÃO 3: CONDIÇÕES PASSIVAS (REGRAS / INSTALLED)          --}}
    {{!-- ============================================================= --}}
    <details class="form-section gum-details passive-section gum-unified-section" data-group-id="cond-passive" {{collapsibleState "cond-passive" @root.collapsedData}}>
        <summary class="block-header gum-unified-header">
            <div class="header-left">
                <i class="fas fa-chevron-right indicator"></i>
                <span class="header-title">Condições Passivas (Regras)</span>
                <span class="header-counter">{{installedConditions.length}}</span>
            </div>
            <p class="header-hint">Automações de sistema e cenário.</p>
        </summary>
        
        <div class="effects-grid-container"> 
            {{#each installedConditions as |item|}}
                <div class="effect-pill-enhanced passive-rule" data-item-id="{{item.id}}">
                    
                    {{!-- O SWITCH --}}
                    <div class="pill-switch-wrapper">
                        <label class="switch" title="Anular Automação (Override)">
                            <input type="checkbox" class="manual-override-toggle" data-item-id="{{item.id}}" {{checked item.flags.gum.manual_override}}>
                            <span class="slider round"></span>
                        </label>
                    </div>

                    <img src="{{item.img}}" class="pill-icon" alt="{{item.name}}"/>
                    
                    <div class="pill-info">
                        <span class="pill-name">{{item.name}}</span>
                        <div class="pill-details">
                            {{#if item.flags.gum.manual_override}}
                                <span class="pill-tag status off">Desativado</span>
                            {{else}}
                                <span class="pill-tag status on">Automático</span>
                            {{/if}}
                        </div>
                    </div>

                    <div class="pill-controls">
                        <a class="effect-control item-edit" title="Editar Regra"><i class="fas fa-edit"></i></a>
                        <a class="effect-control item-delete" title="Remover Regra"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
            {{/each}}
            
            {{#unless installedConditions.length}}
                <div class="placeholder-text">Nenhuma regra de condição instalada.</div>
            {{/unless}}
        </div>
    </details>

</div>


  </div>
  </main>
</div>


{{! ======= ESTRUTURA DO MENU CUSTOMIZADO (TEMPLATE VAZIO) ==========}}
<div class="custom-context-menu">
  {{!-- Este container é preenchido dinamicamente pelo JavaScript. --}}
</div>
</form>
