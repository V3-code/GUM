<form class="{{cssClass}} actor-sheet " autocomplete="off">

  {{! A ficha inteira é um grande "grid" que define as macrorregiões --}}
  <div class="sheet-grid">

    {{! ================================================================== }}
    {{! MACRORREGIÃO 1: CABEÇALHO PRINCIPAL                              }}
    {{! ================================================================== }}
    <header class="sheet-header">
      <div class="header-grid">
        <div class="header-identity">
          {{! Classes já alinhadas com o CSS novo }}
          <input name="name" class="char-name-input" type="text" value="{{actor.name}}" placeholder="Nome do Personagem"/>
          <input name="system.details.concept" class="char-concept-input" type="text" value="{{actor.system.details.concept}}" placeholder="Conceito, Título ou Arquétipo"/>
        </div>
        <div class="header-points">
          <div class="points-cluster">
            <div class="points-display total-points">
              <label>Pontos Totais</label>
              <input type="text" name="system.points.total" value="{{actor.system.points.total}}" />
            </div>
            <div class="points-display unspent-points">
              <label>Pontos Livres</label>
              <input type="text" name="system.points.unspent" value="{{actor.system.points.unspent}}"/>
            </div>
            <a class="points-summary-btn" title="Distribuição de Pontos na Ficha do Personagem"><i class="fas fa-chart-pie"></i></a>
          </div>
        </div>
      </div>
    </header>

    {{! ================================================================== }}
    {{! MACRORREGIÃO 2: SIDEBAR (NOVA ESTRUTURA DE DESIGN)               }}
    {{! ================================================================== }}
    <aside class="sheet-sidebar">
      <div class="sidebar-design-container">

        {{!-- 1. FOTO --}}
        <div class="sidebar-block profile-block">
          <div class="profile-frame">
              <img class="profile-img" src="{{actor.img}}" data-action="edit-portrait"
              alt="{{localize 'GUM.Character.Sidebar.PortraitAlt' name=actor.name}}" title="{{localize 'GUM.Character.Sidebar.PortraitEdit' name=actor.name}}" role="button" tabindex="0"/>
          </div>
        </div>

        {{!-- 2. CARD HÍBRIDO: CARGA & ESQUIVA (MEDALHÃO CIRCULAR) --}}
        <div class="sidebar-block encumbrance-dodge-bar">
          {{!-- Lado Esquerdo --}}
          <div class="enc-col left-col">
            <a class="enc-label link edit-lifting-st" title="{{localize 'GUM.Character.Sidebar.EditLiftingStrength'}}">{{localize "GUM.Character.Sidebar.BasicLift"}}</a>
            <span class="enc-val">{{actor.system.attributes.basic_lift.final}} kg</span>
          </div>

          {{!-- Centro: Medalhão de Esquiva --}}
          <div class="enc-col center-col">
            <div class="badge-wrapper">
              <svg class="dodge-badge-svg" viewBox="0 0 100 100">
                <circle class="badge-bg" cx="50" cy="50" r="48" />
                <circle class="badge-border" cx="50" cy="50" r="44" />
              </svg>
              <a class="rollable dodge-value" data-type="defense" data-roll-value="{{actor.system.attributes.dodge.final}}" data-label="{{localize 'GUM.Character.Sidebar.DodgeTest'}}" data-defense-type="dodge" data-defense-bonus-included="true">
                {{actor.system.attributes.dodge.final}}
              </a>
              <div class="badge-label-curved">{{localize "GUM.Character.Sidebar.Dodge"}}</div>
            </div>
          </div>

          {{!-- Lado Direito --}}
          <div class="enc-col right-col">
            <span class="enc-label">{{localize "GUM.Character.Sidebar.EncumbranceLevel"}}</span>
            <span class="enc-val {{actor.system.encumbrance.level_name}}">{{encumbranceLevelLabel}}</span>
          </div>
        </div>

        {{!-- 3. DADOS QUADRADOS --}}
        <div class="sidebar-block stats-cluster">
          <div class="cluster-header">
            <span class="cluster-title">{{localize "GUM.Character.Sidebar.SecondaryAttributes"}}</span>
            <div class="cluster-actions">
              <a class="physical-feats-reference-btn" title="{{localize 'GUM.PhysicalFeats.Open'}}" aria-label="{{localize 'GUM.PhysicalFeats.Open'}}"><i class="fas fa-running"></i></a>
              <a class="recalc-secondary-stats-btn" title="{{localize 'GUM.Character.Sidebar.RecalculateSecondaries'}}" aria-label="{{localize 'GUM.Character.Sidebar.RecalculateSecondaries'}}"><i class="fas fa-sync-alt"></i></a>
              <a class="edit-secondary-stats-btn" title="{{localize 'GUM.Character.Sidebar.EditSecondaries'}}" aria-label="{{localize 'GUM.Character.Sidebar.EditSecondaries'}}"><i class="fas fa-cog"></i></a>
            </div>
          </div>


          <div class="dice-row">
            <div class="d6-stat" title="{{localize 'GUM.Character.Sidebar.BasicSpeed'}}">
              <div class="d6-face">
                <span class="d6-val">{{actor.system.attributes.basic_speed.final}}</span>
                <span class="d6-label">{{localize "GUM.Character.Sidebar.SpeedAbbrev"}}</span>
              </div>
            </div>
            <div class="d6-stat main-d6" title="{{localize 'GUM.Character.Sidebar.BasicMove'}}">
              <div class="d6-face">
                {{#if actor.system.attributes.enhanced_move.final}}
                <span class="d6-val d6-val-split">{{actor.system.attributes.basic_move.final}} <small style="color:#c2c2c2">/{{actor.system.attributes.enhanced_move.final}}</small></span>
                {{else}}
                <span class="d6-val">{{actor.system.attributes.basic_move.final}}</span>
                {{/if}}
                <span class="d6-label">{{localize "GUM.Character.Sidebar.MoveAbbrev"}}</span>
              </div>
            </div>
            <div class="d6-stat" title="{{localize 'GUM.Character.Sidebar.SizeModifier'}}">
              <div class="d6-face">
                <span class="d6-val">{{actor.system.attributes.mt.final}}</span>
                <span class="d6-label">MT</span>
              </div>
            </div>
          </div>

          {{#if (or actor.system.attributes.air_move.enabled actor.system.attributes.water_move.enabled actor.system.attributes.burrow_move.enabled actor.system.attributes.teleport_range.enabled)}}
          <div class="special-movement-strip" role="list" aria-label="{{localize 'GUM.Character.Sidebar.SpecialMovement'}}">
            {{#if actor.system.attributes.air_move.enabled}}
            <span class="special-movement-item" role="listitem" title="{{localize 'GUM.Combat.Physical.Air'}}: {{actor.system.attributes.air_move.final}}" aria-label="{{localize 'GUM.Combat.Physical.Air'}}: {{actor.system.attributes.air_move.final}}"><i class="fas fa-wind" aria-hidden="true"></i><strong>{{actor.system.attributes.air_move.final}}</strong></span>
            {{/if}}
            {{#if actor.system.attributes.water_move.enabled}}
            <span class="special-movement-item" role="listitem" title="{{localize 'GUM.Combat.Physical.Water'}}: {{actor.system.attributes.water_move.final}}" aria-label="{{localize 'GUM.Combat.Physical.Water'}}: {{actor.system.attributes.water_move.final}}"><i class="fas fa-water" aria-hidden="true"></i><strong>{{actor.system.attributes.water_move.final}}</strong></span>
            {{/if}}
            {{#if actor.system.attributes.burrow_move.enabled}}
            <span class="special-movement-item" role="listitem" title="{{localize 'GUM.Combat.Physical.Burrow'}}: {{actor.system.attributes.burrow_move.final}}" aria-label="{{localize 'GUM.Combat.Physical.Burrow'}}: {{actor.system.attributes.burrow_move.final}}"><i class="fas fa-mountain" aria-hidden="true"></i><strong>{{actor.system.attributes.burrow_move.final}}</strong></span>
            {{/if}}
            {{#if actor.system.attributes.teleport_range.enabled}}
            <span class="special-movement-item" role="listitem" title="{{localize 'GUM.Combat.Physical.Teleport'}}: {{actor.system.attributes.teleport_range.final}} m" aria-label="{{localize 'GUM.Combat.Physical.Teleport'}}: {{actor.system.attributes.teleport_range.final}} m"><i class="fas fa-person-from-portal" aria-hidden="true"></i><strong>{{actor.system.attributes.teleport_range.final}}</strong></span>
            {{/if}}
          </div>
          {{/if}}

          <div class="senses-container">
            <div class="sense-box">
              <a class="rollable" data-type="skill" data-roll-value="{{actor.system.attributes.vision.final}}" data-label="{{localize 'GUM.Character.Sidebar.VisionTest'}}" data-attribute-key="vision"><i class="fas fa-eye"></i> {{localize "GUM.Character.Sidebar.Vision"}}</a>
              <span class="sense-value">{{actor.system.attributes.vision.final}}</span>
            </div>
            <div class="sense-box">
              <a class="rollable" data-type="skill" data-roll-value="{{actor.system.attributes.hearing.final}}" data-label="{{localize 'GUM.Character.Sidebar.HearingTest'}}" data-attribute-key="hearing"><i class="fas fa-deaf"></i> {{localize "GUM.Character.Sidebar.Hearing"}}</a>
              <span class="sense-value">{{actor.system.attributes.hearing.final}}</span>
            </div>
            <div class="sense-box">
              <a class="rollable" data-type="skill" data-roll-value="{{actor.system.attributes.tastesmell.final}}" data-label="{{localize 'GUM.Character.Sidebar.TasteSmellTest'}}" data-attribute-key="tastesmell"><i class="fas fa-wine-bottle"></i> {{localize "GUM.Character.Sidebar.Smell"}}</a>
              <span class="sense-value">{{actor.system.attributes.tastesmell.final}}</span>
            </div>
            <div class="sense-box">
              <a class="rollable" data-type="skill" data-roll-value="{{actor.system.attributes.touch.final}}" data-label="{{localize 'GUM.Character.Sidebar.TouchTest'}}" data-attribute-key="touch"><i class="fas fa-hand-paper"></i> {{localize "GUM.Character.Sidebar.Touch"}}</a>
              <span class="sense-value">{{actor.system.attributes.touch.final}}</span>
            </div>
          </div>

          <div class="basic-damage-card sidebar-basic-damage secondary-basic-damage">
            <div class="sidebar-basic-damage-header">
              <span class="sidebar-basic-damage-title">{{localize "GUM.Character.Sidebar.BasicDamage"}}</span>
            </div>
            <div class="sidebar-basic-damage-values">
              <a class="sidebar-basic-damage-item rollable-basic-damage"
                 data-basic-damage-key="thrust_damage"
                 data-roll-formula="{{actor.system.attributes.thrust_damage.final}}"
                 data-label="{{localize 'GUM.Character.Sidebar.ThrustDamageTest'}}">
                <span class="label">{{localize "GUM.Character.Sidebar.ThrustAbbrev"}}</span>
                <span class="value">{{actor.system.attributes.thrust_damage.final}}</span>
              </a>
              <a class="sidebar-basic-damage-item rollable-basic-damage"
                 data-basic-damage-key="swing_damage"
                 data-roll-formula="{{actor.system.attributes.swing_damage.final}}"
                 data-label="{{localize 'GUM.Character.Sidebar.SwingDamageTest'}}">
                <span class="label">{{localize "GUM.Character.Sidebar.SwingAbbrev"}}</span>
                <span class="value">{{actor.system.attributes.swing_damage.final}}</span>
              </a>
              <a class="sidebar-basic-damage-item rollable-basic-damage"
                 data-basic-damage-key="thrust_damage_alt"
                 data-roll-formula="{{actor.system.attributes.thrust_damage_alt.final}}"
                 data-label="{{localize 'GUM.Character.Sidebar.AlternateThrustDamageTest'}}">
                <span class="label">{{localize "GUM.Character.Sidebar.AlternateThrustAbbrev"}}</span>
                <span class="value">{{actor.system.attributes.thrust_damage_alt.final}}</span>
              </a>
              <a class="sidebar-basic-damage-item rollable-basic-damage"
                 data-basic-damage-key="swing_damage_alt"
                 data-roll-formula="{{#if actor.system.attributes.swing_damage_alt}}{{actor.system.attributes.swing_damage_alt}}{{else}}{{actor.system.attributes.swing_damage}}{{/if}}"
                 data-label="{{localize 'GUM.Character.Sidebar.AlternateSwingDamageTest'}}">
                <span class="label">{{localize "GUM.Character.Sidebar.AlternateSwingAbbrev"}}</span>
                <span class="value">{{actor.system.attributes.swing_damage_alt.final}}</span>
              </a>
            </div>
          </div>
        </div>

        {{!-- 4. BARRAS --}}
        <div class="sidebar-block bars-block">
          <div class="bar-group">
            <div class="bar-label">
              <span>{{localize "GUM.Character.Sidebar.HitPoints"}}</span>
              <a class="edit-resource-bar" data-stat="hp" title="{{localize 'GUM.Character.Sidebar.EditHitPoints'}}" aria-label="{{localize 'GUM.Character.Sidebar.EditHitPoints'}}"><i class="fas fa-cog"></i></a>
            </div>
            <div class="resource-bar original-style">
              <div class="bar-fill hp" style="{{bar_style actor.system.attributes.hp.value actor.system.attributes.hp.final 'hp'}}"></div>
              <div class="bar-inputs">
                <input type="number" name="system.attributes.hp.value" value="{{actor.system.attributes.hp.value}}"/>
                <span>/</span>
                <span class="final-max-value">{{actor.system.attributes.hp.final}}</span>
              </div>
            </div>
          </div>
          <div class="bar-group">
            <div class="bar-label">
              <span>{{localize "GUM.Character.Sidebar.FatiguePoints"}}</span>
              <a class="edit-resource-bar" data-stat="fp" title="{{localize 'GUM.Character.Sidebar.EditFatiguePoints'}}" aria-label="{{localize 'GUM.Character.Sidebar.EditFatiguePoints'}}"><i class="fas fa-cog"></i></a>
            </div>
            <div class="resource-bar original-style">
              <div class="bar-fill fp" style="{{bar_style actor.system.attributes.fp.value actor.system.attributes.fp.final 'fp'}}"></div>
              <div class="bar-inputs">
                <input type="number" name="system.attributes.fp.value" value="{{actor.system.attributes.fp.value}}"/>
                <span>/</span>
                <span class="final-max-value">{{actor.system.attributes.fp.final}}</span>
              </div>
            </div>
          </div>
        </div>

        {{!-- 6. SOBREVIVÊNCIA (AGORA COM DETAILS/SUMMARY NATIVO) --}}
        <div class="sidebar-footer">
          <details class="sidebar-collapsible" data-group-id="sidebar-survival" {{collapsibleState "sidebar-survival" @root.collapsedData}}>
            <summary class="sidebar-summary">
              <h4 class="block-title">{{localize "GUM.Character.Sidebar.Survival"}}</h4>
              <i class="fas fa-chevron-down expand-icon"></i>
            </summary>

            <div class="collapsible-content">
              <div class="survival-grid">
                <div class="survival-item">
                  <label>{{localize "GUM.Character.Sidebar.Hunger"}}</label>
                  <div class="counter-wrapper">
                    <a class="adjust-survival" data-action="decrease" data-attr="fome"><i class="fas fa-minus"></i></a>
                    <input type="number" name="system.attributes.fome.value" value="{{actor.system.attributes.fome.value}}" min="0"/>
                    <a class="adjust-survival" data-action="increase" data-attr="fome"><i class="fas fa-plus"></i></a>
                  </div>
                </div>
                <div class="survival-item">
                  <label>{{localize "GUM.Character.Sidebar.Thirst"}}</label>
                  <div class="counter-wrapper">
                    <a class="adjust-survival" data-action="decrease" data-attr="sede"><i class="fas fa-minus"></i></a>
                    <input type="number" name="system.attributes.sede.value" value="{{actor.system.attributes.sede.value}}" min="0"/>
                    <a class="adjust-survival" data-action="increase" data-attr="sede"><i class="fas fa-plus"></i></a>
                  </div>
                </div>
                <div class="survival-item">
                  <label>{{localize "GUM.Character.Sidebar.Sleep"}}</label>
                  <div class="counter-wrapper">
                    <a class="adjust-survival" data-action="decrease" data-attr="sono"><i class="fas fa-minus"></i></a>
                    <input type="number" name="system.attributes.sono.value" value="{{actor.system.attributes.sono.value}}" min="0"/>
                    <a class="adjust-survival" data-action="increase" data-attr="sono"><i class="fas fa-plus"></i></a>
                  </div>
                </div>
                <div class="survival-item radiation">
                  <label class="warning-label">{{localize "GUM.Character.Sidebar.Radiation"}}</label>
                  <div class="counter-wrapper">
                    <a class="adjust-survival" data-action="decrease" data-attr="radiation"><i class="fas fa-minus"></i></a>
                    <input type="number" name="system.attributes.radiation.value" value="{{actor.system.attributes.radiation.value}}" min="0"/>
                    <a class="adjust-survival" data-action="increase" data-attr="radiation"><i class="fas fa-plus"></i></a>
                  </div>
                </div>
              </div>
            </div>
          </details>
        </div>

      </div>
    </aside>

    {{! ================================================================== }}
    {{! MACRORREGIÃO 3: ÁREA PRINCIPAL (DESIGN RESTAURADO)                 }}
    {{! ================================================================== }}
    <div class="sheet-main-area">
      <div class="sheet-mini-header">
        <div class="primary-attributes-container">
          {{#with actor.system.attributes}}

            {{!-- Estrutura para ST --}}
<div class="attribute-box {{#if (or (eq st.override 0) st.override)}}attribute-box-override{{/if}}">
              <a class="rollable" data-type="attribute" data-roll-value="{{st.final}}" data-label="Teste de ST" data-attribute-key="st"><label>ST</label></a>
              <input class="attribute-value" type="number" name="system.attributes.st.value" value="{{st.value}}"/>
              <div class="attribute-corner-pills">
                {{#if (or (eq st.override 0) st.override)}}
                  <span class="attribute-pill attribute-override" title="Override">{{st.override}}</span>
                {{/if}}
                {{#if (ne st.passive 0)}}
                  <span class="attribute-pill attribute-passive {{#if (gt st.passive 0)}}attribute-pill-positive{{/if}}{{#if (lt st.passive 0)}}attribute-pill-negative{{/if}}" title="Passiva">{{st.passive}}</span>
                {{/if}}
                {{#if (ne st.temp 0)}}
                  <span class="attribute-pill attribute-temp {{#if (gt st.temp 0)}}attribute-pill-positive{{/if}}{{#if (lt st.temp 0)}}attribute-pill-negative{{/if}}" title="Temporário">{{st.temp}}</span>
                {{/if}}
              </div>
              <input class="attribute-modifier" type="number" name="system.attributes.st.mod" value="{{st.mod}}" title="Modificador Fixo (Racial, Vantagens, etc)"/>
            </div>

            {{!-- Estrutura para DX --}}
           <div class="attribute-box {{#if (or (eq dx.override 0) dx.override)}}attribute-box-override{{/if}}">
              <a class="rollable" data-type="attribute" data-roll-value="{{dx.final}}" data-label="Teste de DX" data-attribute-key="dx"><label>DX</label></a>
              <input class="attribute-value" type="number" name="system.attributes.dx.value" value="{{dx.value}}"/>
              <div class="attribute-corner-pills">
                {{#if (or (eq dx.override 0) dx.override)}}
                  <span class="attribute-pill attribute-override" title="Override">{{dx.override}}</span>
                {{/if}}
                {{#if (ne dx.passive 0)}}
                  <span class="attribute-pill attribute-passive {{#if (gt dx.passive 0)}}attribute-pill-positive{{/if}}{{#if (lt dx.passive 0)}}attribute-pill-negative{{/if}}" title="Passiva">{{dx.passive}}</span>
                {{/if}}
                {{#if (ne dx.temp 0)}}
                  <span class="attribute-pill attribute-temp {{#if (gt dx.temp 0)}}attribute-pill-positive{{/if}}{{#if (lt dx.temp 0)}}attribute-pill-negative{{/if}}" title="Temporário">{{dx.temp}}</span>
                {{/if}}
              </div>
              <input class="attribute-modifier" type="number" name="system.attributes.dx.mod" value="{{dx.mod}}" title="Modificador Fixo"/>
            </div>

            {{!-- Estrutura para IQ --}}
            <div class="attribute-box {{#if (or (eq iq.override 0) iq.override)}}attribute-box-override{{/if}}">
              <a class="rollable" data-type="attribute" data-roll-value="{{iq.final}}" data-label="Teste de IQ" data-attribute-key="iq"><label>IQ</label></a>
              <input class="attribute-value" type="number" name="system.attributes.iq.value" value="{{iq.value}}"/>
              <div class="attribute-corner-pills">
                {{#if (or (eq iq.override 0) iq.override)}}
                  <span class="attribute-pill attribute-override" title="Override">{{iq.override}}</span>
                {{/if}}
                {{#if (ne iq.passive 0)}}
                  <span class="attribute-pill attribute-passive {{#if (gt iq.passive 0)}}attribute-pill-positive{{/if}}{{#if (lt iq.passive 0)}}attribute-pill-negative{{/if}}" title="Passiva">{{iq.passive}}</span>
                {{/if}}
                {{#if (ne iq.temp 0)}}
                  <span class="attribute-pill attribute-temp {{#if (gt iq.temp 0)}}attribute-pill-positive{{/if}}{{#if (lt iq.temp 0)}}attribute-pill-negative{{/if}}" title="Temporário">{{iq.temp}}</span>
                {{/if}}
              </div>
              <input class="attribute-modifier" type="number" name="system.attributes.iq.mod" value="{{iq.mod}}" title="Modificador Fixo"/>
            </div>

            {{!-- Estrutura para HT --}}
            <div class="attribute-box {{#if (or (eq ht.override 0) ht.override)}}attribute-box-override{{/if}}">
              <a class="rollable" data-type="attribute" data-roll-value="{{ht.final}}" data-label="Teste de HT" data-attribute-key="ht"><label>HT</label></a>
              <input class="attribute-value" type="number" name="system.attributes.ht.value" value="{{ht.value}}"/>
              <div class="attribute-corner-pills">
                {{#if (or (eq ht.override 0) ht.override)}}
                  <span class="attribute-pill attribute-override" title="Override">{{ht.override}}</span>
                {{/if}}
                {{#if (ne ht.passive 0)}}
                  <span class="attribute-pill attribute-passive {{#if (gt ht.passive 0)}}attribute-pill-positive{{/if}}{{#if (lt ht.passive 0)}}attribute-pill-negative{{/if}}" title="Passiva">{{ht.passive}}</span>
                {{/if}}
                {{#if (ne ht.temp 0)}}
                  <span class="attribute-pill attribute-temp {{#if (gt ht.temp 0)}}attribute-pill-positive{{/if}}{{#if (lt ht.temp 0)}}attribute-pill-negative{{/if}}" title="Temporário">{{ht.temp}}</span>
                {{/if}}
              </div>
              <input class="attribute-modifier" type="number" name="system.attributes.ht.mod" value="{{ht.mod}}" title="Modificador Fixo"/>
            </div>

            {{!-- Estrutura para Vontade --}}
            <div class="attribute-box">
              <a class="rollable" data-type="attribute" data-roll-value="{{vont.final}}" data-label="Teste de Vontade" data-attribute-key="vont"><label>Vont</label></a>
              <input class="attribute-value" type="number" name="system.attributes.vont.value" value="{{vont.value}}"/>
              <div class="attribute-corner-pills">
                {{#if (ne vont.passive 0)}}
                  <span class="attribute-pill attribute-passive {{#if (gt vont.passive 0)}}attribute-pill-positive{{/if}}{{#if (lt vont.passive 0)}}attribute-pill-negative{{/if}}" title="Passiva">{{vont.passive}}</span>
                {{/if}}
                {{#if (ne vont.temp 0)}}
                  <span class="attribute-pill attribute-temp {{#if (gt vont.temp 0)}}attribute-pill-positive{{/if}}{{#if (lt vont.temp 0)}}attribute-pill-negative{{/if}}" title="Temporário">{{vont.temp}}</span>
                {{/if}}
              </div>
              <input class="attribute-modifier" type="number" name="system.attributes.vont.mod" value="{{vont.mod}}" title="Modificador Fixo"/>
            </div>

            {{!-- Estrutura para Percepção --}}
            <div class="attribute-box">
              <a class="rollable" data-type="attribute" data-roll-value="{{per.final}}" data-label="Teste de Percepção" data-attribute-key="per"><label>Per</label></a>
              <input class="attribute-value" type="number" name="system.attributes.per.value" value="{{per.value}}"/>
              <div class="attribute-corner-pills">
                {{#if (ne per.passive 0)}}
                  <span class="attribute-pill attribute-passive {{#if (gt per.passive 0)}}attribute-pill-positive{{/if}}{{#if (lt per.passive 0)}}attribute-pill-negative{{/if}}" title="Passiva">{{per.passive}}</span>
                {{/if}}
                {{#if (ne per.temp 0)}}
                  <span class="attribute-pill attribute-temp {{#if (gt per.temp 0)}}attribute-pill-positive{{/if}}{{#if (lt per.temp 0)}}attribute-pill-negative{{/if}}" title="Temporário">{{per.temp}}</span>
                {{/if}}
              </div>
              <input class="attribute-modifier" type="number" name="system.attributes.per.mod" value="{{per.mod}}" title="Modificador Fixo"/>
            </div>
          {{/with}}
        </div>
      </div>

      {{! ================================================================== }}
      {{! MACRORREGIÃO 4: NAVEGAÇÃO DAS ABAS                               }}
      {{! ================================================================== }}
      <main class="sheet-body-content">
        <nav class="sheet-tabs tabs" data-group="primary">
          <a class="item" data-tab="combat" title="{{localize 'GUM.Combat.Tab'}}">
            <i class="fas fa-khanda"></i>
          </a>
          <a class="item" data-tab="skills" title="{{localize 'GUM.Skills.Tab'}}">
            <i class="fas fa-book-reader"></i>
          </a>
          <a class="item" data-tab="characteristics" title="{{localize 'GUM.Characteristics.Tab'}}">
            <i class="fas fa-star"></i>
          </a>
          <a class="item" data-tab="social" title="{{localize 'GUM.Social.Tab'}}">
            <i class="fas fa-users"></i>
          </a>
          <a class="item" data-tab="spells" title="Magias">
            <i class="fas fa-magic"></i>
          </a>
          <a class="item" data-tab="powers" title="Poderes">
            <i class="fas fa-bolt"></i>
          </a>
          <a class="item" data-tab="equipment" title="Equipamentos">
            <i class="fas fa-suitcase"></i>
          </a>
          <a class="item" data-tab="biography" title="Biografia">
            <i class="fas fa-scroll"></i>
          </a>
          <a class="item" data-tab="conditions" title="{{localize 'GUM.Conditions.Tab'}}">
            <i class="fas fa-heart-pulse"></i>
          </a>
          <a class="item" data-tab="modifiers" title="Modificadores de Rolagens">
              <i class="fas fa-sliders-h"></i>
          </a>
        </nav>

  {{!-- ============   ESSE É O BODY DA FICHA - O QUE FICA DENTRO DE CADA ABA   =============== --}}
  <div class="sheet-body">

    {{! ========================================================= }}
    {{!  ABA DE CONFIGURAÇÃO DE MODIFICADORES (HIERARQUIA V3)     }}
    {{! ========================================================= }}
    <div class="tab modifiers-tab" data-group="primary" data-tab="modifiers">

        {{!-- BARRA DE FERRAMENTAS DE MODIFICADORES --}}
        <div class="modifiers-toolbar gum-block">

            {{!-- Esquerda: Toggle --}}
            <div class="toolbar-group left">
                <label class="toggle-label" title="Se marcado, a janela de rolagem mostrará itens do Compêndio ALÉM dos itens desta ficha.">
                    <input type="checkbox" class="toggle-default-mods" {{checked (lookup actor.flags.gum 'useDefaultModifiers')}}/>
                    <span>Ler Compêndio</span>
                </label>
            </div>

            {{!-- Centro: Busca (NOVO) --}}
            <div class="toolbar-group center search-wrapper">
                <i class="fas fa-search search-icon"></i>
                <input type="text" class="modifier-search" placeholder="Filtrar Modificadores..." autocomplete="off"/>
            </div>

            {{!-- Direita: Ações --}}
            <div class="toolbar-group right">
                <button type="button" class="import-modifiers-btn" title="Importar"><i class="fas fa-file-import"></i></button>
                <button type="button" class="reset-modifiers-btn" title="Resetar"><i class="fas fa-undo"></i></button>
                <button type="button" class="clear-modifiers-btn" title="Limpar"><i class="fas fa-trash"></i></button>
            </div>
        </div>

        <div class="modifiers-masonry-layout">
            {{#each modifierGroups as |group|}}
                <div class="context-wrapper">
                    <details class="context-details" data-group-id="mod-group-{{group.key}}" {{collapsibleState (concat "mod-group-" group.key) @root.collapsedData}}>
                        <summary class="context-summary">
                            <span class="ctx-title"><i class="fas fa-layer-group"></i> {{group.label}}</span>
                        </summary>

                        <div class="context-body">
                            <div class="mod-mini-grid">
                                {{#each group.items}}
                                    <div class="mod-mini-card item-row" data-item-id="{{this.id}}">
                                        <div class="mod-info" title="{{this.name}}">
                                            <img src="{{this.img}}"/>
                                            <span class="mod-name item-quick-view" style="cursor: pointer;">{{this.name}}</span>
                                        </div>
                                        <span class="mod-val {{#if this.modifierIsNegative}}neg{{/if}} {{#if this.modifierIsExpression}}is-expression{{/if}}" title="{{this.modifierDisplay}}">
                                            {{this.modifierCompactDisplay}}
                                        </span>
                                        <div class="mod-controls">
                                            <a class="item-edit"><i class="fas fa-edit"></i></a>
                                            <a class="item-delete"><i class="fas fa-trash"></i></a>
                                        </div>
                                    </div>
                                {{/each}}
                            </div>
                        </div>
                    </details>
                </div>
            {{/each}}
         </div>
    </div>

    {{! ============================================================= }}
    {{! ABA DE ASPECTOS SOCIAIS: registros manuais + contribuições de itens }}
    <div class="tab social-aspects-tab" data-group="primary" data-tab="social">
      <div class="social-tab__toolbar"><button type="button" class="add-social-aspect">{{localize "GUM.Social.AddAspect"}}</button></div>
      <div class="social-groups">
      {{#each socialSections}}
        <details class="social-group gum-unified-section {{#if featured}}social-group--featured{{/if}}"
            data-group-id="social-{{type}}"
            {{collapsibleState (concat "social-" type) @root.collapsedData}}>
          <summary class="social-group__header gum-unified-header">
            <span class="header-left">
              <i class="fas fa-chevron-right indicator"></i>
              <i class="{{icon}} social-group__icon"></i>
              <h4 class="header-title">{{label}}</h4>
            </span>
            <span class="social-group__tools">
              <span class="header-counter">{{count}}</span>
              <a class="add-social-entry" data-type="{{type}}" title="{{localize 'GUM.Social.AddAspect'}}"><i class="fas fa-plus"></i></a>
            </span>
          </summary>
          <ol class="item-list social-card-grid">{{#each entries}}
            <li class="item item-row social-card social-card--{{source}} {{#if expanded}}is-description-expanded{{/if}}" data-entry-id="{{id}}" data-social-card-key="{{cardKey}}">
              <div class="social-card__main">
                <div class="social-card__portrait social-card__portrait--{{source}}" title="{{sourceLabel}}">
                  {{#if sourceImg}}<img src="{{sourceImg}}" alt="{{sourceLabel}}">{{else}}<i class="{{displayIcon}}"></i>{{/if}}
                </div>
                <div class="social-card__identity">
                  <strong class="social-card__name" title="{{primary}}">{{primary}}</strong>
                  {{#if context}}<span class="social-card__context">{{context}}</span>{{/if}}
                </div>
                {{#if metrics.length}}
                <div class="social-card__metrics">
                  {{#each metrics}}<span class="social-card__metric social-card__metric--{{tone}}" title="{{label}}: {{value}}"><small>{{shortLabel}}</small><strong>{{value}}</strong></span>{{/each}}
                </div>
                {{/if}}
                {{#if observation}}<button type="button" class="social-card__expand" title="{{#if expanded}}{{localize 'GUM.Social.CollapseDescription'}}{{else}}{{localize 'GUM.Social.ExpandDescription'}}{{/if}}" aria-label="{{#if expanded}}{{localize 'GUM.Social.CollapseDescription'}}{{else}}{{localize 'GUM.Social.ExpandDescription'}}{{/if}}" aria-expanded="{{#if expanded}}true{{else}}false{{/if}}"><i class="fas {{#if expanded}}fa-compress-arrows-alt{{else}}fa-expand-arrows-alt{{/if}}"></i></button>{{else}}<span class="social-card__expand-spacer" aria-hidden="true"></span>{{/if}}
                <div class="item-controls social-card__controls">
                  <div class="gum-action-menu js-action-menu">
                    <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Social.Options'}}" aria-label="{{localize 'GUM.Social.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                    <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Social.Options'}}">
                      {{#if itemId}}<a class="item-control edit-social-source gum-action-menu__item" data-item-id="{{itemId}}" role="menuitem"><i class="fas fa-external-link-alt"></i><span>{{localize 'GUM.Social.OpenSource'}}</span></a>{{else}}<a class="item-control edit-social-entry gum-action-menu__item" data-type="{{type}}" role="menuitem"><i class="fas fa-edit"></i><span>{{localize 'GUM.Inventory.Edit'}}</span></a><a class="item-control delete-social-entry gum-action-menu__item is-danger" data-type="{{type}}" role="menuitem"><i class="fas fa-trash"></i><span>{{localize 'GUM.Inventory.Delete'}}</span></a>{{/if}}
                    </div>
                  </div>
                </div>
              </div>
              {{#if observation}}<div class="social-card__description"><i class="fas fa-align-left"></i><span>{{observation}}</span></div>{{/if}}
            </li>{{/each}}</ol>
        </details>
      {{/each}}
      </div>
    </div>


    {{!-- ============================================================= --}}
    {{!--   ABA DE CARACTERÍSTICAS (Layout Colapsável e Elegante)       --}}
    {{!-- ============================================================= --}}
    <div class="tab characteristics-tab" data-group="primary" data-tab="characteristics">
      <div class="characteristics-header-tools">
        <div class="characteristics-search-wrapper">
          <i class="fas fa-search" aria-hidden="true"></i>
          <input type="search" class="characteristic-search-input" name="characteristic-search" placeholder="{{localize 'GUM.Characteristics.SearchPlaceholder'}}" autocomplete="off" aria-label="{{localize 'GUM.Characteristics.SearchLabel'}}">
        </div>
        <div class="characteristics-header-buttons">
          <a class="create-characteristic-group" title="{{localize 'GUM.Characteristics.CreateGroup'}}"><i class="fas fa-folder-plus"></i> {{localize 'GUM.Characteristics.Group'}}</a>
          {{#if @root.hasCharacteristicGroupSuggestions}}<a class="suggest-characteristic-groups" title="{{localize 'GUM.Characteristics.SuggestGroups'}}"><i class="fas fa-wand-magic-sparkles"></i> {{localize 'GUM.Characteristics.OrganizeItems'}}</a>{{/if}}
          <a class="sort-control" data-item-type="characteristic" title="{{localize 'GUM.Characteristics.Sort'}}"><i class="fas fa-sort-alpha-down"></i></a>
        </div>
      </div>

      <div class="characteristics-main-content characteristics-sections">
        {{#each characteristicSections as |section|}}
          <details class="characteristic-group gum-details gum-unified-section is-manual-organization {{#if section.isUngrouped}}is-ungrouped{{/if}}"
              id="characteristic-section-{{section.id}}"
              data-group-id="characteristic-{{section.id}}"
              {{collapsibleState (concat "characteristic-" section.id) @root.collapsedData}}>
            <summary class="characteristic-group-summary gum-unified-header">
              <div class="header-left">
                <i class="fas fa-chevron-right indicator"></i>
                <h4 class="block-title">{{section.name}}</h4>
              </div>
              <span class="characteristic-group-header-tools">
                {{#unless section.isUngrouped}}<span class="characteristic-group-actions">
                  <a class="rename-characteristic-group" data-group-id="{{section.id}}" title="{{localize 'GUM.Characteristics.RenameGroup'}}"><i class="fas fa-pen"></i></a>
                  <a class="delete-characteristic-group" data-group-id="{{section.id}}" title="{{localize 'GUM.Characteristics.DeleteGroup'}}"><i class="fas fa-trash"></i></a>
                </span>{{/unless}}
                <span class="characteristic-group-count">{{section.characteristics.length}}</span>
              </span>
            </summary>

            <ol class="item-list flex-wrap-container characteristic-group-content"
                data-item-type="characteristic"
                data-organizer-zone
                data-organizer-group-id="{{section.id}}">
              {{#each section.characteristics}}
                <li class="item characteristic-card {{this.type}}"
                    data-item-id="{{this.id}}"
                    data-organizer-item-id="{{this.id}}"
                    data-organizer-item-type="{{this.type}}"
                    data-search="{{this.name}} {{this.system.specialization}} {{this.system.level}} {{this.system.characteristics}} {{this.characteristicKindLabel}} {{#if this.characteristicIsRacial}}{{localize 'GUM.Characteristics.Racial'}}{{/if}}"
                    draggable="true">
                  <img src="{{this.img}}" class="item-icon" alt="{{this.name}}"/>
                  <div class="characteristic-card-content">
                  <div class="card-info">
                    <div class="card-main">
                      <span class="item-name"><a class="item-quick-view" title="{{localize 'GUM.Characteristics.ViewDetails'}}">{{this.name}}{{#if this.system.specialization}} ({{this.system.specialization}}){{/if}}{{#if this.system.level}} {{this.system.level}}{{/if}}</a></span>
                      {{#if this.system.characteristics}}<span class="characteristic-notes">{{this.system.characteristics}}</span>{{/if}}
                    </div>
                    <div class="card-details">
                      <span class="characteristic-kind {{this.type}}">{{this.characteristicKindLabel}}</span>
                      {{#if this.characteristicIsRacial}}<span class="characteristic-kind racial">{{localize 'GUM.Characteristics.Racial'}}</span>{{/if}}
                      <span class="card-points" title="{{localize 'GUM.Characteristics.PointCost'}}">{{characteristicPoints this}} {{localize 'GUM.Characteristics.PointsAbbreviation'}}</span>
                    </div>
                  </div>
                  <div class="item-controls">
                    {{#if this.system.self_control_roll}}<a class="rollable card-cr" title="{{localize 'GUM.Characteristics.SelfControlTest'}}" data-type="attribute" data-roll-value="{{this.system.self_control_roll}}" data-label="{{localize 'GUM.Characteristics.SelfControl' name=this.name}}" data-item-id="{{this.id}}"><i class="fas fa-dice-d6" aria-hidden="true"></i> {{localize 'GUM.Characteristics.SelfControlAbbreviation'}} {{this.system.self_control_roll}}</a>{{/if}}
                    <div class="gum-action-menu js-action-menu">
                      <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Inventory.Options'}}" aria-label="{{localize 'GUM.Inventory.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                      <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Inventory.Options'}}">
                        {{#if this.characteristicOrganizationCanRemove}}<a class="item-control remove-characteristic-from-group gum-action-menu__item" data-item-id="{{this.id}}" role="menuitem"><i class="fas fa-arrow-up-from-bracket"></i><span>{{localize 'GUM.Characteristics.RemoveFromGroup'}}</span></a>{{/if}}
                        <a class="item-control item-edit gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{localize 'GUM.Inventory.Edit'}}</span></a>
                        <a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize 'GUM.Inventory.Delete'}}</span></a>
                      </div>
                    </div>
                  </div>
                  </div>
                </li>
              {{/each}}
              {{#unless section.characteristics.length}}<li class="placeholder-text">{{localize 'GUM.Characteristics.DropHere'}}</li>{{/unless}}
            </ol>
          </details>
        {{/each}}

        <div class="characteristics-search-empty" hidden>{{localize 'GUM.Characteristics.NoSearchResults'}}</div>
        {{#unless @root.hasCharacteristics}}<div class="empty-placeholder"><p>{{localize 'GUM.Characteristics.Empty'}}</p></div>{{/unless}}
      </div>
    </div>

    {{! ========================================================= }}
    {{!        ABA DE PERÍCIAS (LAYOUT ÁRVORE BLINDADO)             }}
    {{! ========================================================= }}
    <div class="tab skills-tab" data-group="primary" data-tab="skills">

    {{!-- 1. BARRA DE FERRAMENTAS (TOPO) --}}
      <div class="skills-header-tools">
          <div class="skills-search-wrapper">
              <i class="fas fa-search"></i>
              <input type="text" class="skill-search-input" name="search" placeholder="{{localize 'GUM.Skills.SearchPlaceholder'}}" aria-label="{{localize 'GUM.Skills.SearchLabel'}}" autocomplete="off">
          </div>

          <div class="skills-header-buttons">
              {{!-- NOVO: Botão de Alternar Visualização --}}
              <a class="toggle-skills-view" title="{{localize 'GUM.Skills.ToggleView'}}">
{{#if (eq @root.skillsViewMode 'tree')}}
                      <i class="fas fa-sitemap"></i> {{localize 'GUM.Skills.TreeView'}}
                  {{else}}
                      <i class="fas fa-layer-group"></i> {{localize 'GUM.Skills.OrganizationView'}}
                  {{/if}}
              </a>

              {{#if (eq @root.skillsViewMode 'group')}}
              <a class="create-skill-group" title="{{localize 'GUM.Skills.CreateGroup'}}"><i class="fas fa-folder-plus"></i> {{localize 'GUM.Skills.Group'}} </a>
              {{#if @root.hasSkillCategorySuggestions}}<a class="suggest-skill-groups" title="{{localize 'GUM.Skills.SuggestGroups'}}"><i class="fas fa-wand-magic-sparkles"></i> {{localize 'GUM.Skills.Categories'}}</a>{{/if}}
              {{/if}}
              <a class="sort-control" data-item-type="skill" title="{{localize 'GUM.Skills.Sort'}}"><i class="fas fa-sort-alpha-down"></i></a>
          </div>
      </div>

      {{!-- 2. LISTA --}}
      {{!-- Adiciona a classe 'group' ou 'tree' dinamicamente --}}
      <div class="skills-scroll-area {{#if (eq @root.skillsViewMode 'group')}}group{{else}}tree{{/if}}">

        {{!-- Perícias livres e grupos manuais no modo Organização; troncos no modo Árvore. --}}
        {{#each skillSections as |section|}}
            <details class="skill-tree-group gum-unified-section {{#if section.isUngrouped}}is-ungrouped{{/if}} {{#unless section.isTree}}is-manual-organization{{/unless}}"
                data-group-id="skill-{{section.id}}"
                data-organizer-section
                data-organizer-group-id="{{section.id}}"
                {{collapsibleState (concat "skill-" section.id) @root.collapsedData}}>
                <summary class="skill-tree-summary gum-unified-header">
                    <div class="summary-left">
                        <i class="fas fa-chevron-right st-icon"></i>
                        <span class="st-group-title">{{section.name}}</span>
                    </div>
                    <span class="skill-group-header-tools">
                        {{#unless section.isTree}}{{#unless section.isUngrouped}}<span class="skill-group-actions">
                            <a class="rename-skill-group" data-group-id="{{section.id}}" title="{{localize 'GUM.Skills.RenameGroup'}}"><i class="fas fa-pen"></i></a>
                            <a class="delete-skill-group" data-group-id="{{section.id}}" title="{{localize 'GUM.Skills.DeleteGroup'}}"><i class="fas fa-trash"></i></a>
                        </span>{{/unless}}{{/unless}}
                        <span class="st-group-count">{{section.skills.length}}</span>
                    </span>
                </summary>

            <ul class="skill-tree-list group-content" data-organizer-zone data-organizer-group-id="{{section.id}}">
                    {{#each section.skills}}
                    <li class="item skill-tree-item {{this.indentClass}} {{#if this.isTrunk}}is-trunk{{/if}}"
                        data-item-id="{{this._id}}"
                        data-item-type="skill"
                        data-organizer-item-id="{{this._id}}"
                        data-organizer-item-type="skill"
                        draggable="true">

                        {{!-- Ícone (Visualização Rápida) --}}
                        <div class="st-item-icon item-quick-view"
                             style="background-image: url('{{this.img}}');"
                             title="{{localize 'GUM.Skills.View'}}">
                        </div>

                        <div class="st-card-content">
                        <div class="st-card-main">
                        {{!-- Info Central --}}
                        <div class="st-item-name">

                            {{!-- Nome (Visualização Rápida) --}}
                            <h4 class="item-quick-view" title="{{localize 'GUM.Skills.ViewDetails'}}">
                                {{this.name}}{{#if this.system.specialization}} ({{this.system.specialization}}){{/if}}
                            </h4>

                            {{!-- Linha secundária compacta --}}
                            <div class="st-inheritance-path">
                                <span title="{{localize 'GUM.Skills.BaseAttributeAndRelativeLevel'}}">{{this.skillListDisplay.baseAttribute}}{{#if (gte this.skillListDisplay.skillLevel 0)}}+{{/if}}{{this.skillListDisplay.skillLevel}}</span>
                                {{#unless this.isTrunk}}{{#if this.skillListDisplay.difficulty}}<span aria-hidden="true">•</span><span title="{{localize 'GUM.Skills.Difficulty'}}">{{this.skillListDisplay.difficulty}}</span>{{/if}}{{/unless}}
                                <span aria-hidden="true">•</span><span title="{{localize 'GUM.Skills.InvestedPoints'}}">{{this.skillListDisplay.points}} {{localize 'GUM.Skills.PointsAbbreviation'}}</span>
                                {{#if (ne this.skillListDisplay.nhMod 0)}}<span aria-hidden="true">•</span><span title="{{localize 'GUM.Skills.BaseModifier'}}">{{#if (gte this.skillListDisplay.nhMod 0)}}+{{/if}}{{this.skillListDisplay.nhMod}} {{localize 'GUM.Skills.ModifierAbbreviation'}}</span>{{/if}}
                                {{#if (ne this.skillListDisplay.treeDefaultMod 0)}}<span aria-hidden="true">•</span><span title="{{localize 'GUM.Skills.TreeDefault'}}">{{#if (gte this.skillListDisplay.treeDefaultMod 0)}}+{{/if}}{{this.skillListDisplay.treeDefaultMod}} {{localize 'GUM.Skills.TreeAbbreviation'}}</span>{{/if}}
                            </div>
                            {{#if (eq @root.skillsViewMode 'tree')}}{{#if this.inheritancePath.length}}<div class="st-tree-path" aria-label="{{localize 'GUM.Skills.InheritancePath'}}">{{#each this.inheritancePath}}<span class="path-node {{this.type}}" title="{{localize 'GUM.Skills.BonusFrom' name=this.name}}">{{this.name}} {{#if (gte this.value 0)}}+{{/if}}{{this.value}}</span>{{/each}}</div>{{/if}}{{/if}}
                        </div>

                        {{!-- NH Final --}}
                        <div class="st-nh-box">
                            <span>NH</span>
                            <a class="rollable"
                               data-roll-value="{{#if this.tree_final_nh}}{{this.tree_final_nh}}{{else}}{{this.system.final_nh}}{{/if}}"
                               data-label="{{localize 'GUM.Skills.Test' name=this.name}}"
                               data-type="skill"
                               data-item-id="{{this._id}}"
                               data-attribute-key="{{this.skillListDisplay.baseAttribute}}">
                               {{#if this.tree_final_nh}}{{this.tree_final_nh}}{{else}}{{this.system.final_nh}}{{/if}}
                            </a>
                        </div>
                        </div>

                        {{!-- Rodapé: efeitos/tags à esquerda e ações à direita --}}
                        <div class="item-controls st-controls">
                            {{#if (or this.modifierIndicators.included.visible this.modifierIndicators.roll.visible)}}<span class="skill-modifier-indicators">
                                {{#if this.modifierIndicators.included.visible}}<span class="skill-modifier-tag is-included" title="{{this.modifierIndicators.included.title}}" aria-label="{{this.modifierIndicators.included.title}}">NH</span>{{/if}}
                                {{#if this.modifierIndicators.roll.visible}}<span class="skill-modifier-tag is-roll {{this.modifierIndicators.roll.className}}" title="{{this.modifierIndicators.roll.title}}" aria-label="{{this.modifierIndicators.roll.title}}">ROL {{#if (gte this.modifierIndicators.roll.total 0)}}+{{/if}}{{this.modifierIndicators.roll.total}}</span>{{/if}}
                            </span>{{/if}}
                            <div class="gum-action-menu js-action-menu">
                              <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Inventory.Options'}}" aria-label="{{localize 'GUM.Inventory.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                              <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Inventory.Options'}}">
                                {{#if this.skillOrganizationCanRemove}}<a class="item-control remove-skill-from-group gum-action-menu__item" data-item-id="{{this._id}}" role="menuitem"><i class="fas fa-arrow-up-from-bracket"></i><span>{{localize 'GUM.Skills.RemoveFromGroup'}}</span></a>{{/if}}
                                <a class="item-control item-edit gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{localize 'GUM.Inventory.Edit'}}</span></a>
                                <a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize 'GUM.Inventory.Delete'}}</span></a>
                              </div>
                            </div>
                        </div>
                        </div>
                    </li>
                    {{/each}}
                </ul>
            </details>
        {{/each}}

        <div class="skills-search-empty" hidden>{{localize 'GUM.Skills.NoSearchResults'}}</div>

        {{!-- Vazio --}}
        {{#unless @root.hasSkills}}
            <div class="empty-placeholder" style="text-align:center; padding:20px; color:#666;">
                <p>{{localize 'GUM.Skills.Empty'}}</p>
            </div>
        {{/unless}}

      </div>
    </div>

    {{! ========================================================= }}
    {{!  ABA DE CONJURAÇÕES (ESTRUTURA REFINADA E PADRONIZADA)    }}
    {{! ========================================================= }}
    <div class="tab" data-group="primary" data-tab="spells">
<div class="spells-tab-layout spells-tab-layout--stacked">

                  <div class="skills-header-tools">
        <div class="skills-search-wrapper">
          <i class="fas fa-search"></i>
          <input type="text" class="spell-search-input" placeholder="{{localize 'GUM.Spells.SearchPlaceholder'}}" aria-label="{{localize 'GUM.Spells.SearchLabel'}}" autocomplete="off">
        </div>

        <div class="skills-header-buttons">
          <div class="gum-action-menu js-action-menu support-add-menu">
            <a class="support-add-menu__toggle gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Spells.AddTitle'}}" aria-label="{{localize 'GUM.Spells.AddTitle'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-plus"></i> {{localize 'GUM.Spells.Add'}}</a>
            <div class="gum-action-menu__panel js-action-menu-panel support-add-menu__panel" role="menu" aria-label="{{localize 'GUM.Spells.AddTitle'}}">
              <a class="gum-action-menu__item create-primary-item" data-type="spell" role="menuitem"><i class="fas fa-wand-magic-sparkles"></i><span><strong>{{localize 'GUM.Spells.New'}}</strong><small>{{localize 'GUM.Spells.NewHint'}}</small></span></a>
              <a class="gum-action-menu__item add-casting-ability" role="menuitem"><i class="fas fa-link"></i><span><strong>{{localize 'GUM.Spells.LinkAbility'}}</strong><small>{{localize 'GUM.Spells.LinkAbilityHint'}}</small></span></a>
              <a class="gum-action-menu__item add-energy-reserve" data-reserve-type="spell" role="menuitem"><i class="fas fa-battery-three-quarters"></i><span><strong>{{localize 'GUM.Spells.CreateReserve'}}</strong><small>{{localize 'GUM.Spells.CreateReserveHint'}}</small></span></a>
            </div>
          </div>
          <a class="create-ability-group" data-ability-type="spell" title="{{localize 'GUM.AbilityOrganization.CreateGroup'}}"><i class="fas fa-folder-plus"></i> {{localize 'GUM.AbilityOrganization.Group'}}</a>
          {{#if hasSpellCategorySuggestions}}<a class="suggest-ability-groups" data-ability-type="spell" title="{{localize 'GUM.AbilityOrganization.SuggestGroups'}}"><i class="fas fa-wand-magic-sparkles"></i> {{localize 'GUM.AbilityOrganization.Categories'}}</a>{{/if}}
          <a class="sort-control" data-item-type="spell" title="{{localize 'GUM.Spells.Sort'}}"><i class="fas fa-sort-alpha-down"></i></a>
        </div>
      </div>


      {{#if spellSupportCount}}
      <section class="support-card-grid support-card-grid--spell{{#if spellSupportCompactPair}} is-compact-pair{{/if}}" aria-label="{{localize 'GUM.Spells.SupportSectionLabel'}}">
        {{#each castingAbilities}}
        <article class="support-card support-link-card characteristic-link-card{{#if this.broken}} is-broken{{/if}}" data-ability-id="{{this.id}}">
          {{#if this.itemId}}
          {{#if this.img}}<img class="support-card__image characteristic-link-card__image" src="{{this.img}}" alt="">{{else}}<span class="support-card__image characteristic-link-card__missing"><i class="fas fa-unlink"></i></span>{{/if}}
          {{else}}<span class="support-card__icon support-card__icon--spell"><i class="fas fa-hat-wizard"></i></span>{{/if}}
          <div class="support-card__body">
            <div class="support-card__title-row">
              <a class="support-card__name casting-ability-name {{#if this.itemId}}{{#if this.broken}}edit-casting-ability{{else}}view-casting-ability{{/if}}{{/if}}">{{this.name}}{{#if this.specialization}} ({{this.specialization}}){{/if}}</a>
              <span class="support-card__stat">{{#if this.itemId}}{{this.points}} {{localize 'GUM.Characteristics.PointsAbbreviation'}}{{else}}{{localize 'GUM.Characteristics.LevelAbbreviation'}} {{this.level}}{{/if}}</span>
            </div>
            <div class="support-card__meta"><span class="support-card__kind">{{localize 'GUM.Spells.CastingAbility'}}</span> · {{#if this.itemId}}{{this.kindLabel}}{{#if this.level}} · {{localize 'GUM.Characteristics.LevelAbbreviation'}} {{this.level}}{{/if}}{{#if this.notes}} · {{this.notes}}{{/if}}{{else}}{{localize 'GUM.Resources.LegacyRecord'}} · {{this.source}}{{/if}}</div>
          </div>
                  <div class="item-controls support-card__controls">
            <div class="gum-action-menu js-action-menu">
              <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Spells.CastingAbilityOptions'}}" aria-label="{{localize 'GUM.Spells.CastingAbilityOptions'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
              <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Spells.CastingAbilityActions'}}">
                <a class="item-control view-casting-ability gum-action-menu__item" role="menuitem"><i class="fas fa-eye"></i><span>{{#if this.itemId}}{{localize 'GUM.Resources.OpenTrait'}}{{else}}{{localize 'GUM.Resources.View'}}{{/if}}</span></a>
                <a class="item-control edit-casting-ability gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{#if this.broken}}{{localize 'GUM.Resources.SelectReplacement'}}{{else}}{{localize 'GUM.Inventory.Edit'}}{{/if}}</span></a>
                <a class="item-control delete-casting-ability gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-unlink"></i><span>{{#if this.itemId}}{{localize 'GUM.Resources.Unlink'}}{{else}}{{localize 'GUM.Inventory.Delete'}}{{/if}}</span></a>
              </div>
            </div>
          </div>
        </article>
        {{/each}}

       {{#each spellReserves}}
        <article class="support-card support-reserve-card support-card--category-start energy-reserve-card energy-reserve-card--spell{{#if @first}} is-first-reserve{{/if}}" data-reserve-id="{{@key}}" data-reserve-type="spell" {{#if this.equipmentId}}data-equipment-id="{{this.equipmentId}}"{{/if}} title="{{localize 'GUM.Resources.ReserveTitle' name=this.name current=this.current max=this.max}}" aria-label="{{localize 'GUM.Resources.ReserveTitle' name=this.name current=this.current max=this.max}}">
          <span class="support-card__icon support-card__icon--spell"><i class="fas fa-magic" aria-hidden="true"></i></span>
          <div class="support-card__body">
            <strong class="support-card__name energy-reserve-name">{{this.name}}</strong>
            <div class="support-card__meta"><span class="support-card__kind">{{localize 'GUM.Resources.Reserve'}}</span> · {{localize 'GUM.Resources.MaximumAbbreviation'}} <strong>{{this.max}}</strong>{{#if this.source}} · {{this.source}}{{/if}}</div>
          </div>
          <div class="energy-reserve-value-controls support-card__value-controls">
            <button type="button" class="adjust-energy-reserve energy-reserve-adjust" data-adjustment="-1" aria-label="{{localize 'GUM.Resources.Decrease' name=this.name}}"><i class="fas fa-minus" aria-hidden="true"></i></button>
            <strong class="energy-reserve-value" aria-label="{{localize 'GUM.Resources.CurrentValue' value=this.current}}">{{this.current}}</strong>
            <button type="button" class="adjust-energy-reserve energy-reserve-adjust" data-adjustment="1" aria-label="{{localize 'GUM.Resources.Increase' name=this.name}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
          </div>
          <div class="item-controls support-card__controls energy-reserve-controls">
            <div class="gum-action-menu js-action-menu">
              <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Resources.ReserveOptions'}}" aria-label="{{localize 'GUM.Resources.ReserveOptions'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
              <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Resources.ReserveActions'}}">
                <a class="item-control edit-energy-reserve gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{#if this.equipmentId}}{{localize "GUM.Equipment.Reserve.OpenEquipment"}}{{else}}{{localize 'GUM.Inventory.Edit'}}{{/if}}</span></a>
                {{#unless this.equipmentId}}<a class="item-control delete-energy-reserve gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize 'GUM.Inventory.Delete'}}</span></a>{{/unless}}
              </div>
            </div>
          </div>
        </article>
        {{/each}}
      </section>
      {{/if}}

      {{!-- Lista compacta de magias, isolada dos cards legados de poderes e combate. --}}
      <div class="magic-groups">
      {{#each spellSections as |section|}}
          <details class="magic-group" data-group-id="spell-group-{{section.id}}" data-organizer-section data-organizer-group-id="{{section.id}}" {{collapsibleState (concat "spell-group-" section.id) @root.collapsedData}}>
            <summary class="magic-group__header">
              <div class="magic-group__identity">
                <i class="fas fa-chevron-right indicator"></i>
                <i class="fas fa-hat-wizard item-icon"></i>
                <span class="group-name">{{section.name}}</span>
              </div>
              <span class="ability-group-header-tools">
                {{#unless section.isUngrouped}}<span class="ability-group-actions"><a class="rename-ability-group" data-ability-type="spell" data-group-id="{{section.id}}" title="{{localize 'GUM.AbilityOrganization.RenameGroup'}}"><i class="fas fa-pen"></i></a><a class="delete-ability-group" data-ability-type="spell" data-group-id="{{section.id}}" title="{{localize 'GUM.AbilityOrganization.DeleteGroup'}}"><i class="fas fa-trash"></i></a></span>{{/unless}}
                <span class="magic-group__count">{{localize 'GUM.Spells.Count' count=section.items.length}}</span>
              </span>
            </summary>

            <div class="magic-card-grid" data-organizer-zone data-organizer-group-id="{{section.id}}">
              {{#each section.items}}
              <article class="item-wrapper item magic-card{{#if this.magicCardExpanded}} is-expanded{{/if}}" data-item-id="{{this.id}}" data-organizer-item-id="{{this.id}}" data-organizer-item-type="spell" draggable="true">
                <div class="magic-card__main">
                  <img class="magic-card__icon" src="{{this.img}}" alt="{{this.name}}">

                  <div class="magic-card__identity">
                    <h4 class="magic-card__name item-quick-view" title="{{this.name}} — {{localize 'GUM.Spells.View'}}">{{this.name}}</h4>
                    <div class="magic-card__identity-meta">{{this.magicCardIdentity}}</div>
                    <div class="magic-card__identity-mechanics">
                      <span class="magic-card__identity-stat" title="{{localize 'GUM.Spells.TimeHint'}}"><strong>{{localize 'GUM.Spells.Time'}}</strong> {{this.system.casting_time}} · {{this.system.duration}}</span>
                      <span class="magic-card__identity-stat" title="{{localize 'GUM.Spells.ManaHint'}}"><strong>{{localize 'GUM.Spells.Mana'}}</strong> {{this.system.mana_cost}} / {{this.system.mana_maint}}</span>
                    </div>
                  </div>

                  <div class="magic-card__metric magic-card__nh">
                    <span class="magic-card__metric-label">{{localize 'GUM.Spells.SkillLevel'}}</span>
                    <a class="rollable magic-card__metric-value" data-type="spell" data-roll-value="{{this.system.final_nh}}" data-label="{{localize 'GUM.Spells.Test' name=this.name}}" data-item-id="{{this.id}}">{{this.system.final_nh}}</a>
                    {{#if (or this.modifierIndicators.included.visible this.modifierIndicators.roll.visible)}}<span class="magic-card__modifier-indicator" title="{{#if this.modifierIndicators.roll.visible}}{{this.modifierIndicators.roll.title}}{{else}}{{this.modifierIndicators.included.title}}{{/if}}" aria-label="{{#if this.modifierIndicators.roll.visible}}{{this.modifierIndicators.roll.title}}{{else}}{{this.modifierIndicators.included.title}}{{/if}}"><i class="fas fa-sparkles" aria-hidden="true"></i></span>{{/if}}
                  </div>

                  <div class="magic-card__metric magic-card__damage">
                    <span class="magic-card__metric-label">{{localize 'GUM.Spells.Damage'}}</span>
                    {{#if this.system.damage.formula}}<div class="magic-card__damage-value"><a class="rollable-damage magic-card__metric-value" title="{{localize 'GUM.Spells.RollDamage'}}" data-item-id="{{this.id}}">{{this.system.damage.formula}} {{this.system.damage.type}}</a>{{#if this.magicCardAdditionalDamageMarkers}}<sup class="magic-card__additional-damage" title="{{this.magicCardAdditionalDamageHint}}" aria-label="{{this.magicCardAdditionalDamageHint}}">{{this.magicCardAdditionalDamageMarkers}}</sup>{{/if}}</div>{{/if}}
                  </div>

                  <button type="button" class="magic-card__expand" title="{{#if this.magicCardExpanded}}{{localize 'GUM.Spells.CollapseDetails'}}{{else}}{{localize 'GUM.Spells.ExpandDetails'}}{{/if}}" aria-label="{{#if this.magicCardExpanded}}{{localize 'GUM.Spells.CollapseDetails'}}{{else}}{{localize 'GUM.Spells.ExpandDetails'}}{{/if}}" aria-expanded="{{#if this.magicCardExpanded}}true{{else}}false{{/if}}"><i class="fas {{#if this.magicCardExpanded}}fa-compress-arrows-alt{{else}}fa-expand-arrows-alt{{/if}}"></i></button>

                  <div class="item-controls magic-card__controls">
                    <div class="gum-action-menu js-action-menu">
                      <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Spells.Options'}}" aria-label="{{localize 'GUM.Spells.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                      <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Spells.Options'}}">
                        <a class="item-control item-quick-view gum-action-menu__item" data-item-id="{{this.id}}" role="menuitem"><i class="fas fa-eye"></i><span>{{localize 'GUM.Spells.View'}}</span></a>
                        <a class="item-control item-edit gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{localize 'GUM.Spells.Edit'}}</span></a>
                        {{#if this.abilityOrganizationCanRemove}}<a class="item-control remove-ability-from-group gum-action-menu__item" data-ability-type="spell" data-item-id="{{this.id}}" role="menuitem"><i class="fas fa-folder-minus"></i><span>{{localize 'GUM.AbilityOrganization.RemoveFromGroup'}}</span></a>{{/if}}
                        <a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize 'GUM.Spells.Delete'}}</span></a>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="magic-card__details" {{#unless this.magicCardExpanded}}hidden{{/unless}}>
                  <section class="magic-card__detail-branch magic-card__detail-branch--mechanics">
                    <h5><i class="fas fa-hourglass-half"></i>{{localize 'GUM.Spells.Mechanics'}}</h5>
                    <div class="magic-card__detail-values">
                      <span><strong>{{localize 'GUM.Spells.CastingTime'}}</strong>{{this.system.casting_time}}</span>
                      <span><strong>{{localize 'GUM.Spells.Duration'}}</strong>{{this.system.duration}}</span>
                      <span><strong>{{localize 'GUM.Spells.CastingCost'}}</strong>{{this.system.mana_cost}}</span>
                      <span><strong>{{localize 'GUM.Spells.MaintenanceCost'}}</strong>{{this.system.mana_maint}}</span>
                    </div>
                  </section>

                  {{#if this.system.uses_attack}}
                  <section class="magic-card__detail-branch magic-card__detail-branch--attack">
                    <h5><i class="fas fa-crosshairs"></i>{{localize 'GUM.Spells.Attack'}}</h5>
                    <div class="magic-card__detail-values">
                      <span><strong>{{localize 'GUM.Spells.Type'}}</strong>{{#if (eq this.system.attack_type 'melee')}}{{localize 'GUM.Spells.Melee'}}{{else}}{{localize 'GUM.Spells.Ranged'}}{{/if}}</span>
                      <span><strong>{{localize 'GUM.Spells.Skill'}}</strong>{{#if this.system.attack_roll.resolved_skill_name}}{{this.system.attack_roll.resolved_skill_name}}{{else}}{{this.system.attack_roll.skill_name}}{{/if}}</span>
                      {{#if this.system.attack_nh}}<a class="rollable magic-card__attack-level-tag" data-type="attack" data-attack-type="{{this.system.attack_type}}" data-attribute-key="{{this.system.attack_roll.skill_name}}" data-roll-value="{{this.system.attack_nh}}" data-label="{{localize 'GUM.Spells.AttackTest' name=this.name}}" data-item-id="{{this.id}}"><strong>{{localize 'GUM.Spells.SkillLevel'}}</strong>{{this.system.attack_nh}}</a>{{/if}}
                      {{#if (eq this.system.attack_type 'melee')}}
                        {{#if this.system.attack_roll.reach}}<span><strong>{{localize 'GUM.Spells.Reach'}}</strong>{{this.system.attack_roll.reach}}</span>{{/if}}
                        {{#if this.system.attack_roll.parry}}<span><strong>{{localize 'GUM.Spells.Parry'}}</strong>{{this.system.attack_roll.parry}}</span>{{/if}}
                      {{else}}
                        {{#if this.system.attack_roll.accuracy}}<span><strong>{{localize 'GUM.Spells.Accuracy'}}</strong>{{this.system.attack_roll.accuracy}}</span>{{/if}}
                        {{#if this.system.attack_roll.range}}<span><strong>{{localize 'GUM.Spells.Range'}}</strong>{{this.system.attack_roll.range}}</span>{{/if}}
                        {{#if this.system.attack_roll.rof}}<span><strong>{{localize 'GUM.Spells.RateOfFire'}}</strong>{{this.system.attack_roll.rof}}</span>{{/if}}
                        {{#if this.system.attack_roll.shots}}<span><strong>{{localize 'GUM.Spells.Shots'}}</strong>{{this.system.attack_roll.shots}}</span>{{/if}}
                        {{#if this.system.attack_roll.bulk}}<span><strong>{{localize 'GUM.Spells.Bulk'}}</strong>{{this.system.attack_roll.bulk}}</span>{{/if}}
                        {{#if this.system.attack_roll.rcl}}<span><strong>{{localize 'GUM.Spells.Recoil'}}</strong>{{this.system.attack_roll.rcl}}</span>{{/if}}
                      {{/if}}
                      {{#if this.system.attack_roll.min_strength}}<span><strong>{{localize 'GUM.Spells.MinimumStrength'}}</strong>{{this.system.attack_roll.min_strength}}</span>{{/if}}
                    </div>
                  </section>
                  {{/if}}

                  {{#if this.system.damage.formula}}
                  <section class="magic-card__detail-branch magic-card__detail-branch--damage">
                    <h5><i class="fas fa-burst"></i>{{localize 'GUM.Spells.Damage'}}</h5>
                    <div class="magic-card__detail-values">
                      <a class="rollable-damage" data-item-id="{{this.id}}"><strong>{{localize 'GUM.Spells.PrimaryDamage'}}</strong>{{this.system.damage.formula}} {{this.system.damage.type}}{{#if this.system.damage.nature}} · {{this.system.damage.nature}}{{/if}}{{#if (gt this.system.damage.armor_divisor 1)}} · ÷{{this.system.damage.armor_divisor}}{{/if}}{{#if this.system.damage.scaling}} · {{this.system.damage.scaling}}{{/if}}</a>
                      {{#if this.system.damage.follow_up_damage.formula}}<span><strong>{{localize 'GUM.Spells.FollowUpDamage'}}</strong>{{this.system.damage.follow_up_damage.formula}} {{this.system.damage.follow_up_damage.type}}{{#if this.system.damage.follow_up_damage.nature}} · {{this.system.damage.follow_up_damage.nature}}{{/if}}{{#if this.system.damage.follow_up_damage.scaling}} · {{this.system.damage.follow_up_damage.scaling}}{{/if}}</span>{{/if}}
                      {{#if this.system.damage.fragmentation_damage.formula}}<span><strong>{{localize 'GUM.Spells.FragmentationDamage'}}</strong>{{this.system.damage.fragmentation_damage.formula}} {{this.system.damage.fragmentation_damage.type}}{{#if this.system.damage.fragmentation_damage.nature}} · {{this.system.damage.fragmentation_damage.nature}}{{/if}}{{#if this.system.damage.fragmentation_damage.scaling}} · {{this.system.damage.fragmentation_damage.scaling}}{{/if}}</span>{{/if}}
                    </div>
                  </section>
                  {{/if}}

                  {{#if (or this.system.resistance this.system.requires_concentration this.system.effect)}}
                  <section class="magic-card__detail-branch magic-card__detail-branch--resolution">
                    <h5><i class="fas fa-clipboard-check"></i>{{localize 'GUM.Spells.Resolution'}}</h5>
                    <div class="magic-card__detail-values">
                      {{#if this.system.resistance}}<span><strong>{{localize 'GUM.Spells.Resistance'}}</strong>{{this.system.resistance}}</span>{{/if}}
                      {{#if this.system.requires_concentration}}<span><i class="fas fa-brain"></i> {{localize 'GUM.Spells.RequiresConcentration'}}</span>{{/if}}
                      {{#if this.system.effect}}<span class="magic-card__effect"><strong>{{localize 'GUM.Spells.Effect'}}</strong>{{this.system.effect}}</span>{{/if}}
                    </div>
                  </section>
                  {{/if}}
                </div>
              </article>
              {{/each}}
            </div>
          </details>
        {{/each}}

        {{#unless hasSpells}}
        <div class="empty-placeholder magic-empty">
          <p>{{localize 'GUM.Spells.Empty'}}</p>
        </div>
        {{/unless}}
      </div>
      <div class="magic-search-empty" hidden>{{localize 'GUM.Spells.NoSearchResults'}}</div>
      </div>
    </div>

    {{! ========================================================= }}
    {{!  ABA DE PODERES (ESTRUTURA REFINADA E PADRONIZADA)        }}
    {{! ========================================================= }}
    <div class="tab powers-tab" data-group="primary" data-tab="powers">

 <div class="spells-tab-layout spells-tab-layout--stacked">

      <div class="skills-header-tools">
        <div class="skills-search-wrapper">
          <i class="fas fa-search"></i>
          <input type="text" class="power-search-input" placeholder="{{localize 'GUM.Powers.SearchPlaceholder'}}" aria-label="{{localize 'GUM.Powers.SearchLabel'}}" autocomplete="off">
        </div>

        <div class="skills-header-buttons">
                    <div class="gum-action-menu js-action-menu support-add-menu">
            <a class="support-add-menu__toggle gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Powers.AddTitle'}}" aria-label="{{localize 'GUM.Powers.AddTitle'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-plus"></i> {{localize 'GUM.Powers.Add'}}</a>
            <div class="gum-action-menu__panel js-action-menu-panel support-add-menu__panel" role="menu" aria-label="{{localize 'GUM.Powers.AddTitle'}}">
              <a class="gum-action-menu__item create-primary-item" data-type="power" role="menuitem"><i class="fas fa-wand-magic-sparkles"></i><span><strong>{{localize 'GUM.Powers.New'}}</strong><small>{{localize 'GUM.Powers.NewHint'}}</small></span></a>
              <a class="gum-action-menu__item add-power-source" role="menuitem"><i class="fas fa-link"></i><span><strong>{{localize 'GUM.Powers.LinkSource'}}</strong><small>{{localize 'GUM.Powers.LinkSourceHint'}}</small></span></a>
              <a class="gum-action-menu__item add-energy-reserve" data-reserve-type="power" role="menuitem"><i class="fas fa-battery-three-quarters"></i><span><strong>{{localize 'GUM.Powers.CreateReserve'}}</strong><small>{{localize 'GUM.Powers.CreateReserveHint'}}</small></span></a>
            </div>
          </div>
          <a class="create-ability-group" data-ability-type="power" title="{{localize 'GUM.AbilityOrganization.CreateGroup'}}"><i class="fas fa-folder-plus"></i> {{localize 'GUM.AbilityOrganization.Group'}}</a>
          {{#if hasPowerCategorySuggestions}}<a class="suggest-ability-groups" data-ability-type="power" title="{{localize 'GUM.AbilityOrganization.SuggestGroups'}}"><i class="fas fa-wand-magic-sparkles"></i> {{localize 'GUM.AbilityOrganization.Categories'}}</a>{{/if}}
          <a class="sort-control" data-item-type="power" title="{{localize 'GUM.Powers.Sort'}}"><i class="fas fa-sort-alpha-down"></i></a>
        </div>
      </div>

      {{#if powerSupportCount}}
      <section class="support-card-grid support-card-grid--power{{#if powerSupportCompactPair}} is-compact-pair{{/if}}" aria-label="{{localize 'GUM.Powers.SupportSectionLabel'}}">
        {{#each powerSources}}
        <article class="support-card support-link-card characteristic-link-card{{#if this.broken}} is-broken{{/if}}" data-power-source-id="{{this.id}}">
          {{#if this.itemId}}
          {{#if this.img}}<img class="support-card__image characteristic-link-card__image" src="{{this.img}}" alt="">{{else}}<span class="support-card__image characteristic-link-card__missing"><i class="fas fa-unlink"></i></span>{{/if}}
          {{else}}<span class="support-card__icon support-card__icon--power"><i class="fas fa-bolt"></i></span>{{/if}}
          <div class="support-card__body">
            <div class="support-card__title-row">
              <a class="support-card__name casting-ability-name {{#if this.itemId}}{{#if this.broken}}edit-power-source{{else}}view-power-source{{/if}}{{/if}}">{{this.name}}{{#if this.specialization}} ({{this.specialization}}){{/if}}</a>
              <span class="support-card__stat">{{#if this.itemId}}{{this.points}} {{localize 'GUM.Characteristics.PointsAbbreviation'}}{{else}}{{localize 'GUM.Characteristics.LevelAbbreviation'}} {{this.level}}{{/if}}</span>
            </div>
            <div class="support-card__meta"><span class="support-card__kind">{{localize 'GUM.Powers.Source'}}</span> · {{#if this.itemId}}{{this.kindLabel}}{{#if this.level}} · {{localize 'GUM.Characteristics.LevelAbbreviation'}} {{this.level}}{{/if}}{{#if this.notes}} · {{this.notes}}{{/if}}{{else}}{{localize 'GUM.Resources.LegacyRecord'}} · {{this.source}}{{/if}}</div>
          </div>
          <div class="item-controls support-card__controls">
            <div class="gum-action-menu js-action-menu">
              <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Powers.SourceOptions'}}" aria-label="{{localize 'GUM.Powers.SourceOptions'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
              <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Powers.SourceActions'}}">
                <a class="item-control view-power-source gum-action-menu__item" role="menuitem"><i class="fas fa-eye"></i><span>{{#if this.itemId}}{{localize 'GUM.Resources.OpenTrait'}}{{else}}{{localize 'GUM.Resources.View'}}{{/if}}</span></a>
                <a class="item-control edit-power-source gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{#if this.broken}}{{localize 'GUM.Resources.SelectReplacement'}}{{else}}{{localize 'GUM.Inventory.Edit'}}{{/if}}</span></a>
                <a class="item-control delete-power-source gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-unlink"></i><span>{{#if this.itemId}}{{localize 'GUM.Resources.Unlink'}}{{else}}{{localize 'GUM.Inventory.Delete'}}{{/if}}</span></a>
              </div>
            </div>
          </div>
        </article>
        {{/each}}
        {{#each powerReserves}}
        <article class="support-card support-reserve-card support-card--category-start energy-reserve-card energy-reserve-card--power{{#if @first}} is-first-reserve{{/if}}" data-reserve-id="{{@key}}" data-reserve-type="power" {{#if this.equipmentId}}data-equipment-id="{{this.equipmentId}}"{{/if}} title="{{localize 'GUM.Resources.ReserveTitle' name=this.name current=this.current max=this.max}}" aria-label="{{localize 'GUM.Resources.ReserveTitle' name=this.name current=this.current max=this.max}}">
          <span class="support-card__icon support-card__icon--power"><i class="fas fa-bolt" aria-hidden="true"></i></span>
          <div class="support-card__body">
            <strong class="support-card__name energy-reserve-name">{{this.name}}</strong>
            <div class="support-card__meta"><span class="support-card__kind">{{localize 'GUM.Resources.Reserve'}}</span> · {{localize 'GUM.Resources.MaximumAbbreviation'}} <strong>{{this.max}}</strong>{{#if this.source}} · {{this.source}}{{/if}}</div>
          </div>
          <div class="energy-reserve-value-controls support-card__value-controls">
            <button type="button" class="adjust-energy-reserve energy-reserve-adjust" data-adjustment="-1" aria-label="{{localize 'GUM.Resources.Decrease' name=this.name}}"><i class="fas fa-minus" aria-hidden="true"></i></button>
            <strong class="energy-reserve-value" aria-label="{{localize 'GUM.Resources.CurrentValue' value=this.current}}">{{this.current}}</strong>
            <button type="button" class="adjust-energy-reserve energy-reserve-adjust" data-adjustment="1" aria-label="{{localize 'GUM.Resources.Increase' name=this.name}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
          </div>
          <div class="item-controls support-card__controls energy-reserve-controls">
            <div class="gum-action-menu js-action-menu">
              <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Resources.ReserveOptions'}}" aria-label="{{localize 'GUM.Resources.ReserveOptions'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
              <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Resources.ReserveActions'}}">
                <a class="item-control edit-energy-reserve gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{#if this.equipmentId}}{{localize "GUM.Equipment.Reserve.OpenEquipment"}}{{else}}{{localize 'GUM.Inventory.Edit'}}{{/if}}</span></a>
                {{#unless this.equipmentId}}<a class="item-control delete-energy-reserve gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize 'GUM.Inventory.Delete'}}</span></a>{{/unless}}
              </div>
            </div>
          </div>
        </article>
        {{/each}}
      </section>
      {{/if}}

      {{!-- Lista compacta de poderes, usando o mesmo componente visual das magias. --}}
      <div class="magic-groups power-groups">
      {{#each powerSections as |section|}}
          <details class="magic-group power-group" data-group-id="power-group-{{section.id}}" data-organizer-section data-organizer-group-id="{{section.id}}" {{collapsibleState (concat "power-group-" section.id) @root.collapsedData}}>
            <summary class="magic-group__header">
              <div class="magic-group__identity">
                <i class="fas fa-chevron-right indicator"></i>
                <i class="fas fa-bolt item-icon"></i>
                <span class="group-name">{{section.name}}</span>
              </div>
              <span class="ability-group-header-tools">
                {{#unless section.isUngrouped}}<span class="ability-group-actions"><a class="rename-ability-group" data-ability-type="power" data-group-id="{{section.id}}" title="{{localize 'GUM.AbilityOrganization.RenameGroup'}}"><i class="fas fa-pen"></i></a><a class="delete-ability-group" data-ability-type="power" data-group-id="{{section.id}}" title="{{localize 'GUM.AbilityOrganization.DeleteGroup'}}"><i class="fas fa-trash"></i></a></span>{{/unless}}
                <span class="magic-group__count">{{localize 'GUM.Powers.Count' count=section.items.length}}</span>
              </span>
            </summary>

            <div class="magic-card-grid power-card-grid" data-organizer-zone data-organizer-group-id="{{section.id}}">
              {{#each section.items}}
              <article class="item-wrapper item magic-card power-card{{#if this.powerCardExpanded}} is-expanded{{/if}}" data-item-id="{{this.id}}" data-organizer-item-id="{{this.id}}" data-organizer-item-type="power" draggable="true">
                <div class="magic-card__main">
                  <img class="magic-card__icon" src="{{this.img}}" alt="{{this.name}}">

                  <div class="magic-card__identity">
                    <h4 class="magic-card__name item-quick-view" title="{{this.name}} — {{localize 'GUM.Powers.View'}}">{{this.name}}</h4>
                    <div class="magic-card__identity-meta">{{this.powerCardIdentity}}</div>
                    <div class="magic-card__identity-mechanics">
                      <span class="magic-card__identity-stat" title="{{localize 'GUM.Powers.TimeHint'}}"><strong>{{localize 'GUM.Powers.Time'}}</strong> {{this.system.activation_time}} · {{this.system.duration}}</span>
                      <span class="magic-card__identity-stat" title="{{localize 'GUM.Powers.CostHint'}}"><strong>{{localize 'GUM.Powers.Cost'}}</strong> {{this.system.activation_cost}} / {{this.system.maint_cost}}</span>
                    </div>
                  </div>

                  <div class="magic-card__metric magic-card__nh">
                    <span class="magic-card__metric-label">{{localize 'GUM.Spells.SkillLevel'}}</span>
                    <a class="rollable magic-card__metric-value" data-type="power" data-roll-value="{{this.system.final_nh}}" data-label="{{localize 'GUM.Powers.Test' name=this.name}}" data-item-id="{{this.id}}">{{this.system.final_nh}}</a>
                    {{#if (or this.modifierIndicators.included.visible this.modifierIndicators.roll.visible)}}<span class="magic-card__modifier-indicator" title="{{#if this.modifierIndicators.roll.visible}}{{this.modifierIndicators.roll.title}}{{else}}{{this.modifierIndicators.included.title}}{{/if}}" aria-label="{{#if this.modifierIndicators.roll.visible}}{{this.modifierIndicators.roll.title}}{{else}}{{this.modifierIndicators.included.title}}{{/if}}"><i class="fas fa-sparkles" aria-hidden="true"></i></span>{{/if}}
                  </div>

                  <div class="magic-card__metric magic-card__damage">
                    <span class="magic-card__metric-label">{{localize 'GUM.Spells.Damage'}}</span>
                    {{#if this.system.damage.formula}}<div class="magic-card__damage-value"><a class="rollable-damage magic-card__metric-value" title="{{localize 'GUM.Spells.RollDamage'}}" data-item-id="{{this.id}}">{{this.system.damage.formula}} {{this.system.damage.type}}</a>{{#if this.powerCardAdditionalDamageMarkers}}<sup class="magic-card__additional-damage" title="{{this.powerCardAdditionalDamageHint}}" aria-label="{{this.powerCardAdditionalDamageHint}}">{{this.powerCardAdditionalDamageMarkers}}</sup>{{/if}}</div>{{/if}}
                  </div>

                  <button type="button" class="magic-card__expand" title="{{#if this.powerCardExpanded}}{{localize 'GUM.Powers.CollapseDetails'}}{{else}}{{localize 'GUM.Powers.ExpandDetails'}}{{/if}}" aria-label="{{#if this.powerCardExpanded}}{{localize 'GUM.Powers.CollapseDetails'}}{{else}}{{localize 'GUM.Powers.ExpandDetails'}}{{/if}}" aria-expanded="{{#if this.powerCardExpanded}}true{{else}}false{{/if}}"><i class="fas {{#if this.powerCardExpanded}}fa-compress-arrows-alt{{else}}fa-expand-arrows-alt{{/if}}"></i></button>

                  <div class="item-controls magic-card__controls">
                    <div class="gum-action-menu js-action-menu">
                      <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Powers.Options'}}" aria-label="{{localize 'GUM.Powers.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                      <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Powers.Options'}}">
                        <a class="item-control item-quick-view gum-action-menu__item" data-item-id="{{this.id}}" role="menuitem"><i class="fas fa-eye"></i><span>{{localize 'GUM.Powers.View'}}</span></a>
                        <a class="item-control item-edit gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{localize 'GUM.Powers.Edit'}}</span></a>
                        {{#if this.abilityOrganizationCanRemove}}<a class="item-control remove-ability-from-group gum-action-menu__item" data-ability-type="power" data-item-id="{{this.id}}" role="menuitem"><i class="fas fa-folder-minus"></i><span>{{localize 'GUM.AbilityOrganization.RemoveFromGroup'}}</span></a>{{/if}}
                        <a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize 'GUM.Powers.Delete'}}</span></a>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="magic-card__details" {{#unless this.powerCardExpanded}}hidden{{/unless}}>
                  <section class="magic-card__detail-branch magic-card__detail-branch--mechanics">
                    <h5><i class="fas fa-hourglass-half"></i>{{localize 'GUM.Powers.Mechanics'}}</h5>
                    <div class="magic-card__detail-values">
                      <span><strong>{{localize 'GUM.Powers.ActivationTime'}}</strong>{{this.system.activation_time}}</span>
                      <span><strong>{{localize 'GUM.Powers.Duration'}}</strong>{{this.system.duration}}</span>
                      <span><strong>{{localize 'GUM.Powers.ActivationCost'}}</strong>{{this.system.activation_cost}}</span>
                      <span><strong>{{localize 'GUM.Powers.MaintenanceCost'}}</strong>{{this.system.maint_cost}}</span>
                    </div>
                  </section>

                  {{#if this.system.uses_attack}}
                  <section class="magic-card__detail-branch magic-card__detail-branch--attack">
                    <h5><i class="fas fa-crosshairs"></i>{{localize 'GUM.Spells.Attack'}}</h5>
                    <div class="magic-card__detail-values">
                      <span><strong>{{localize 'GUM.Spells.Type'}}</strong>{{#if (eq this.system.attack_type 'melee')}}{{localize 'GUM.Spells.Melee'}}{{else}}{{localize 'GUM.Spells.Ranged'}}{{/if}}</span>
                      <span><strong>{{localize 'GUM.Spells.Skill'}}</strong>{{#if this.system.attack_roll.resolved_skill_name}}{{this.system.attack_roll.resolved_skill_name}}{{else}}{{this.system.attack_roll.skill_name}}{{/if}}</span>
                      {{#if this.system.attack_nh}}<a class="rollable magic-card__attack-level-tag" data-type="attack" data-attack-type="{{this.system.attack_type}}" data-attribute-key="{{this.system.attack_roll.skill_name}}" data-roll-value="{{this.system.attack_nh}}" data-label="{{localize 'GUM.Powers.AttackTest' name=this.name}}" data-item-id="{{this.id}}"><strong>{{localize 'GUM.Spells.SkillLevel'}}</strong>{{this.system.attack_nh}}</a>{{/if}}
                      {{#if (eq this.system.attack_type 'melee')}}
                        {{#if this.system.attack_roll.reach}}<span><strong>{{localize 'GUM.Spells.Reach'}}</strong>{{this.system.attack_roll.reach}}</span>{{/if}}
                        {{#if this.system.attack_roll.parry}}<span><strong>{{localize 'GUM.Spells.Parry'}}</strong>{{this.system.attack_roll.parry}}</span>{{/if}}
                      {{else}}
                        {{#if this.system.attack_roll.accuracy}}<span><strong>{{localize 'GUM.Spells.Accuracy'}}</strong>{{this.system.attack_roll.accuracy}}</span>{{/if}}
                        {{#if this.system.attack_roll.range}}<span><strong>{{localize 'GUM.Spells.Range'}}</strong>{{this.system.attack_roll.range}}</span>{{/if}}
                        {{#if this.system.attack_roll.rof}}<span><strong>{{localize 'GUM.Spells.RateOfFire'}}</strong>{{this.system.attack_roll.rof}}</span>{{/if}}
                        {{#if this.system.attack_roll.shots}}<span><strong>{{localize 'GUM.Spells.Shots'}}</strong>{{this.system.attack_roll.shots}}</span>{{/if}}
                        {{#if this.system.attack_roll.bulk}}<span><strong>{{localize 'GUM.Spells.Bulk'}}</strong>{{this.system.attack_roll.bulk}}</span>{{/if}}
                        {{#if this.system.attack_roll.rcl}}<span><strong>{{localize 'GUM.Spells.Recoil'}}</strong>{{this.system.attack_roll.rcl}}</span>{{/if}}
                      {{/if}}
                      {{#if this.system.attack_roll.min_strength}}<span><strong>{{localize 'GUM.Spells.MinimumStrength'}}</strong>{{this.system.attack_roll.min_strength}}</span>{{/if}}
                    </div>
                  </section>
                  {{/if}}

                  {{#if this.system.damage.formula}}
                  <section class="magic-card__detail-branch magic-card__detail-branch--damage">
                    <h5><i class="fas fa-burst"></i>{{localize 'GUM.Spells.Damage'}}</h5>
                    <div class="magic-card__detail-values">
                      <a class="rollable-damage" data-item-id="{{this.id}}"><strong>{{localize 'GUM.Spells.PrimaryDamage'}}</strong>{{this.system.damage.formula}} {{this.system.damage.type}}{{#if this.system.damage.nature}} · {{this.system.damage.nature}}{{/if}}{{#if (gt this.system.damage.armor_divisor 1)}} · ÷{{this.system.damage.armor_divisor}}{{/if}}{{#if this.system.damage.scaling}} · {{this.system.damage.scaling}}{{/if}}</a>
                      {{#if this.system.damage.follow_up_damage.formula}}<span><strong>{{localize 'GUM.Spells.FollowUpDamage'}}</strong>{{this.system.damage.follow_up_damage.formula}} {{this.system.damage.follow_up_damage.type}}{{#if this.system.damage.follow_up_damage.nature}} · {{this.system.damage.follow_up_damage.nature}}{{/if}}{{#if this.system.damage.follow_up_damage.scaling}} · {{this.system.damage.follow_up_damage.scaling}}{{/if}}</span>{{/if}}
                      {{#if this.system.damage.fragmentation_damage.formula}}<span><strong>{{localize 'GUM.Spells.FragmentationDamage'}}</strong>{{this.system.damage.fragmentation_damage.formula}} {{this.system.damage.fragmentation_damage.type}}{{#if this.system.damage.fragmentation_damage.nature}} · {{this.system.damage.fragmentation_damage.nature}}{{/if}}{{#if this.system.damage.fragmentation_damage.scaling}} · {{this.system.damage.fragmentation_damage.scaling}}{{/if}}</span>{{/if}}
                    </div>
                  </section>
                  {{/if}}

                  <section class="magic-card__detail-branch magic-card__detail-branch--resolution">
                    <h5><i class="fas fa-clipboard-check"></i>{{localize 'GUM.Powers.Configuration'}}</h5>
                    <div class="magic-card__detail-values">
                      <span><strong>{{localize 'GUM.Powers.Points'}}</strong>{{characteristicPoints this}}{{#if (eq this.system.cost_paid "alternative")}} {{localize 'GUM.Powers.Alternative'}}{{/if}}</span>
                      {{#if this.system.resistance}}<span><strong>{{localize 'GUM.Spells.Resistance'}}</strong>{{this.system.resistance}}</span>{{/if}}
                      {{#if this.system.requires_concentration}}<span><i class="fas fa-brain"></i> {{localize 'GUM.Spells.RequiresConcentration'}}</span>{{/if}}
                      {{#if this.system.effect}}<span class="magic-card__effect"><strong>{{localize 'GUM.Spells.Effect'}}</strong>{{this.system.effect}}</span>{{/if}}
                    </div>
                  </section>
                </div>
              </article>
              {{/each}}
            </div>
          </details>
        {{/each}}

        {{#unless hasPowers}}
        <div class="empty-placeholder magic-empty">
          <p>{{localize 'GUM.Powers.Empty'}}</p>
        </div>
        {{/unless}}
      </div>
      <div class="power-search-empty magic-search-empty" hidden>{{localize 'GUM.Powers.NoSearchResults'}}</div>

    </div>
    </div>

        {{! ========================================================= }}
    {{!       ABA DE EQUIPAMENTOS (VERSÃO OTIMIZADA v3 - CARD UNIFICADO) }}
    {{! ========================================================= }}

<div class="tab" data-group="primary" data-tab="equipment">

{{!-- SUMÁRIO DE CARGA (2 LINHAS / PREMIUM) --}}
<div class="encumbrance-inline gum-panel" data-enc="{{actor.system.encumbrance.level_value}}">

  {{!-- LINHA 1 --}}
  <div class="encumbrance-row encumbrance-row-top">
    <div class="encumbrance-inline-label">
      <i class="fas fa-weight-hanging"></i>
      <span>{{localize "GUM.Inventory.Encumbrance.Summary"}}</span>
    </div>

    <div class="encumbrance-inline-meter"
         role="img"
         aria-label="{{encumbranceDisplay.ariaLabel}}">

      <div class="encumbrance-inline-fill"
           style="width: {{actor.system.encumbrance.progress_percent}}%;"></div>

      {{#each encumbranceDisplay.levels}}
      {{#if this.is_divider}}
        <span class="encumbrance-inline-marker
              {{#if this.active}}active{{/if}}"
              style="left: {{this.marker_percent}}%;"
              title="{{this.barrier_tooltip}}">
        </span>
      {{/if}}
      {{/each}}

      {{#each encumbranceDisplay.segments}}
        <span class="encumbrance-inline-segment-label"
              style="left: {{this.midpoint_percent}}%;"
              title="{{this.label}}">
          {{this.short}}
        </span>
      {{/each}}
    </div>

    <div class="encumbrance-inline-value">
      {{actor.system.encumbrance.total_weight}} /
      {{actor.system.encumbrance.max_capacity}} kg
    </div>

    <div class="encumbrance-inline-state">
      {{encumbranceDisplay.levelLabel}}
    </div>
  </div>

  {{!-- LINHA 2 --}}
  <div class="encumbrance-row encumbrance-row-bottom">
    <button type="button" class="physical-lifting-reference encumbrance-rules-button" title="{{localize 'GUM.PhysicalLifting.OpenReference'}}" aria-label="{{localize 'GUM.PhysicalLifting.OpenReference'}}"><i class="fas fa-scale-balanced" aria-hidden="true"></i>{{localize "GUM.PhysicalLifting.OpenReference"}}</button>

    <div class="encumbrance-ignore-controls">
      <div class="encumbrance-inline-subtitle">
        {{localize "GUM.Inventory.Encumbrance.Ignore"}}
      </div>

      {{!-- Funcional (já existe no sistema) --}}
      <label class="encumbrance-pill">
        <input type="checkbox"
               name="system.encumbrance.ignore_carried_weight"
               {{checked actor.system.encumbrance.ignore_carried_weight}} />
        <span>{{localize "GUM.Inventory.Carried"}}</span>
      </label>

      {{!-- Ignora o peso dos itens equipados/em uso no cálculo de carga --}}
      <label class="encumbrance-pill">
        <input type="checkbox"
               name="system.encumbrance.ignore_equipped_weight"
               {{checked actor.system.encumbrance.ignore_equipped_weight}} />
        <span>{{localize "GUM.Inventory.InUse"}}</span>
      </label>
    </div>

    <span class="encumbrance-row-balance" aria-hidden="true"></span>
  </div>

</div>

<details class="money-sources-panel gum-details gum-unified-section" data-section="money_sources" {{#unless actor.flags.gum.sheet_settings.money_sources_closed}}open{{/unless}}>
  <summary class="money-sources-panel__header">
    <span class="money-sources-panel__label"><i class="fas fa-chevron-right money-sources-panel__toggle" aria-hidden="true"></i><i class="fas fa-coins" aria-hidden="true"></i> {{localize "GUM.MoneySource.Cards"}}</span>
    <a class="item-control money-source-create" title="{{localize 'GUM.MoneySource.Create'}}" aria-label="{{localize 'GUM.MoneySource.Create'}}"><i class="fas fa-plus"></i></a>
  </summary>
  <div class="money-sources-panel__cards">
    {{#each moneySources}}
      <article class="item money-source-card" data-item-id="{{this._id}}" title="{{this.name}}">
        <img src="{{this.img}}" class="money-source-card__icon"/>
        <div class="money-source-card__body">
          <div class="money-source-card__title-row">
            <a class="item-quick-view money-source-card__name">{{this.name}}</a>
          </div>
          <div class="money-source-card__meta"><span>{{#if this.system.moneyPhysical}}{{localize "GUM.MoneySource.Physical"}}{{else}}{{localize "GUM.MoneySource.Abstract"}}{{/if}}</span>{{#if this.system.category}} · {{this.system.category}}{{/if}}{{#if this.system.moneyPhysical}} · ×{{this.system.quantity}} · {{this.system.moneyTotalWeight}} kg{{/if}} · <span title="{{localize 'GUM.MoneySource.Location'}}">{{#if (eq this.system.location "equipped")}}<i class="fas fa-tshirt"></i>{{else if (eq this.system.location "stored")}}<i class="fas fa-box"></i>{{else}}<i class="fas fa-backpack"></i>{{/if}}</span></div>
        </div>
        <strong class="money-source-card__value">{{this.system.moneyAvailable}}</strong>
        <div class="item-controls money-source-card__controls">
          <div class="gum-action-menu js-action-menu">
            <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="Opções" aria-label="Opções" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
            <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="Opções da fonte monetária">
              {{#if this.system.parent_container_id}}<a class="item-control item-remove-from-container gum-action-menu__item" role="menuitem"><i class="fas fa-sign-out-alt"></i><span>Remover do contêiner</span></a>{{else}}<a class="item-control item-move-to-container gum-action-menu__item" role="menuitem"><i class="fas fa-boxes"></i><span>Mover para contêiner</span></a>{{/if}}
              <a class="item-control item-edit gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>Editar</span></a>
              <a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>Excluir</span></a>
            </div>
          </div>
        </div>
