                            <span class="container-item-count">{{this.childCount}} {{#if (eq this.childCount 1)}}{{localize "GUM.Inventory.Item"}}{{else}}{{localize "GUM.Inventory.Items"}}{{/if}}</span>
                            <span title="{{localize 'GUM.Inventory.OwnWeight'}}"><i class="fas fa-weight-hanging"></i> {{localize "GUM.Inventory.Weight"}}: {{this.container.system.total_weight}} kg</span>
                            <span class="container-load-value {{#if this.container.system.container_is_overweight}}is-overweight{{/if}}">{{localize "GUM.Inventory.Load"}}: {{this.container.system.container_current_weight}} kg{{#if (gt this.container.system.container_max_weight_value 0)}} / {{this.container.system.container_max_weight}} kg{{else}} · {{localize "GUM.Inventory.NoCapacityLimit"}}{{/if}}</span>
                        </div>
                        {{#if (gt this.container.system.container_max_weight_value 0)}}
                        <div class="container-capacity-meter {{#if this.container.system.container_is_overweight}}is-overweight{{/if}}" role="progressbar" aria-label="{{localize 'GUM.Inventory.Load'}}" aria-valuenow="{{this.container.system.container_progress_value}}" aria-valuemax="{{this.container.system.container_max_weight_value}}" aria-valuetext="{{this.container.system.container_aria_value_text}}">
                            <span style="width: {{this.container.system.container_fill_percent}}%;"></span>
                        </div>
                        {{/if}}
                    </div>
                </div>
                <div class="item-controls">
                    <a class="item-control item-toggle-equip" title="{{localize 'GUM.Inventory.DirectEquip'}}"><i class="fas fa-tshirt" style="opacity:0.3;"></i></a>
                    <a class="item-control item-toggle-stored" title="{{localize 'GUM.Inventory.MoveToCarried'}}"><i class="fas fa-backpack" style="opacity:0.3;"></i></a>
                    <a class="item-control item-toggle-container-children" title="{{localize 'GUM.Inventory.ToggleContents'}}"><i class="fas fa-diagram-project"></i></a>
                    <div class="gum-action-menu js-action-menu">
  <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Inventory.Options'}}" aria-label="{{localize 'GUM.Inventory.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
  <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Inventory.Options'}}">
    <a class="item-control item-edit gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{localize "GUM.Inventory.Edit"}}</span></a>
    <a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize "GUM.Inventory.Delete"}}</span></a>
  </div>
</div>
                </div>
            </div>
            <ol class="item-list flex-wrap-container container-children-list equipment-drop-zone {{#if this.container.system.is_container_collapsed}}is-collapsed{{/if}}" data-organizer-zone data-organizer-group-id="container:{{this.container._id}}">
                {{#unless this.container.system.is_container_collapsed}}
                {{#each this.children}}
                <li class="item equipment-card is-inside-container" data-item-id="{{this._id}}" data-organizer-item-id="{{this._id}}" data-organizer-item-type="{{this.type}}" draggable="true">
                    <img src="{{this.img}}" class="item-icon"/>
                    <div class="card-info">
                        <span class="item-name"><a class="item-quick-view">{{this.name}}</a></span>
                        <div class="card-details equipment-stats">
                            <span class="equip-stat-tag">x{{this.system.quantity}}</span>
                            <span class="equip-stat-tag">{{this.system.total_weight}} kg</span>
                            {{#if (eq this.system.equipmentResolution.uses.mode "charges")}}<span class="equip-stat-tag" title="{{localize 'GUM.Equipment.Label.Remaining'}}">{{this.system.effectiveUsesRemaining}}/{{this.system.effectiveUsesMax}} {{localize "GUM.Equipment.Label.Charges"}}</span>{{/if}}
                        </div>
                        <div class="item-controls">
                            <a class="item-control item-remove-from-container" title="{{localize 'GUM.Inventory.RemoveFromContainer'}}"><i class="fas fa-sign-out-alt"></i></a>
                            <a class="item-control item-consume-use" title="{{localize 'GUM.Inventory.QuickUse'}}"><i class="fas fa-flask"></i></a>
                            <div class="gum-action-menu js-action-menu">
  <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Inventory.Options'}}" aria-label="{{localize 'GUM.Inventory.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
  <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Inventory.Options'}}">
    <a class="item-control item-edit gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{localize "GUM.Inventory.Edit"}}</span></a>
    <a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize "GUM.Inventory.Delete"}}</span></a>
  </div>
</div>
                        </div>
                    </div>
                </li>
                {{/each}}
                {{#unless this.children.length}}
                <li class="container-empty-state"><i class="fas fa-arrow-down"></i> {{localize "GUM.Inventory.EmptyContainer"}}</li>
                {{/unless}}
                {{/unless}}
            </ol>
        </div>
        {{/each}}
        </div>
    </div>
</details>
    </div>
</div>


    {{! ========================================================= }}
    {{!       ABA DE COMBATE (VERSÃO OTIMIZADA v3 - CARD UNIFICADO) }}
    {{! ========================================================= }}
    <div class="tab combat-tab" data-group="primary" data-tab="combat">

      {{! ========================================================= }}
      {{!       CONTAINER DE 2 COLUNAS (ESQUERDA ESTREITA)            }}
      {{! ========================================================= }}
      <div class="combat-main-content">

        {{! --- COLUNA DA ESQUERDA (ESTREITA) --- }}
        <div class="combat-left-column">

          {{! ================================================= }}
          {{!     PAINEL DE RD   }}
          {{! ================================================= }}
          <div class="gum-block dr-location-block">
            <div class="block-header">
              <h4>
                <span class="dr-header-title">{{localize "GUM.Combat.DR.Title"}}</span>
                <span class="dr-header-subtitle">{{bodyProfileLabel}}</span>
              </h4>
              <div class="header-controls">
                <a class="view-hit-locations" title="{{localize 'GUM.Combat.DR.Edit'}}"><i class="fas fa-edit"></i></a>
              </div>
            </div>

<ol class="dr-location-list">
              {{#each drDisplayRows as |row|}}
                {{#if row.isGroup}}
                  <li class="dr-location-row dr-group" data-group-id="{{row.id}}">
                    <div class="dr-row-main">
                      <div class="dr-row-start">
                      <button class="dr-group-toggle" type="button" title="{{localize 'GUM.Combat.ExpandGroup'}}">
                        <i class="fas fa-chevron-right"></i>
                      </button>
                      <span class="location-name">{{row.label}}</span>
                      {{#if row.isAdditional}}<i class="fas fa-plus-circle dr-location-origin" title="{{localize 'GUM.Combat.DR.AdditionalLocations'}}"></i>{{/if}}
                      {{#each row.equipmentSources as |source|}}<i class="fas fa-toolbox dr-location-origin" title="{{localize 'GUM.Combat.DR.EquipmentSource'}}: {{source}}"></i>{{/each}}
                      </div>
                      <span class="location-dr-value">{{row.base}}</span>
                    </div>
                    {{#if row.extraLine}}
                      <div class="dr-row-extra">{{row.extraLine}}</div>
                    {{/if}}
                    <ol class="dr-group-children">
                      {{#each row.children as |child|}}
                        <li class="dr-location-row is-child {{#if child.extraLine}}has-extra{{/if}}" data-location-key="{{child.key}}">
                          <div class="dr-row-main">
                            <span class="location-name">{{child.label}}</span>
                            {{#if child.isAdditional}}<i class="fas fa-plus-circle dr-location-origin" title="{{localize 'GUM.Combat.DR.AdditionalLocations'}}"></i>{{/if}}
                            {{#each child.equipmentSources as |source|}}<i class="fas fa-toolbox dr-location-origin" title="{{localize 'GUM.Combat.DR.EquipmentSource'}}: {{source}}"></i>{{/each}}
                            <span class="location-dr-value">{{child.base}}</span>
                          </div>
                          {{#if child.extraLine}}
                            <div class="dr-row-extra is-child">{{child.extraLine}}</div>
                          {{/if}}
                        </li>

                      {{/each}}
                    </ol>
                  </li>
                {{else}}
                  <li class="dr-location-row {{#if row.extraLine}}has-extra{{/if}}" data-location-key="{{row.key}}">
                    <div class="dr-row-main">
                      <span class="location-name">{{row.label}}</span>
                      {{#if row.isAdditional}}<i class="fas fa-plus-circle dr-location-origin" title="{{localize 'GUM.Combat.DR.AdditionalLocations'}}"></i>{{/if}}
                      {{#each row.equipmentSources as |source|}}<i class="fas fa-toolbox dr-location-origin" title="{{localize 'GUM.Combat.DR.EquipmentSource'}}: {{source}}"></i>{{/each}}
                      <span class="location-dr-value">{{row.base}}</span>
                    </div>
                    {{#if row.extraLine}}
                      <div class="dr-row-extra">{{row.extraLine}}</div>
                    {{/if}}
                  </li>
                {{/if}}
              {{/each}}
            </ol>
          </div>

</div>

        {{! --- COLUNA DA DIREITA (LARGA) --- }}
        <div class="combat-right-column">

          <div class="combat-area-label" aria-hidden="true"><span>{{localize "GUM.Combat.Control"}}</span></div>

          <div class="combat-filter-list combat-filter-list--control" role="group" aria-label="{{localize 'GUM.Combat.Filters.ControlGroups'}}">
            <button type="button" class="combat-filter-chip {{#if combatControlFilterAll}}is-active{{/if}}" data-filter-scope="control" data-filter-value="all" aria-pressed="{{#if combatControlFilterAll}}true{{else}}false{{/if}}">{{localize "GUM.Combat.Filters.All"}}</button>
            <button type="button" class="combat-filter-chip {{#if combatWoundsFilterActive}}is-active{{/if}}" data-filter-scope="control" data-filter-value="wounds" aria-pressed="{{#if combatWoundsFilterActive}}true{{else}}false{{/if}}">{{localize "GUM.Wounds.Title"}}</button>
            <button type="button" class="combat-filter-chip {{#if combatMetersFilterActive}}is-active{{/if}}" data-filter-scope="control" data-filter-value="meters" aria-pressed="{{#if combatMetersFilterActive}}true{{else}}false{{/if}}">{{localize "GUM.Combat.Meters.Title"}}</button>
          </div>

          {{!-- Grupo fixo de Registros de Combate --}}
          <div class="attack-group-list-v2 combat-fixed-groups-list">
            <details class="attack-group-details gum-unified-section combat-fixed-group wounds-box" data-group-id="wounds-group" data-combat-control-group="wounds" {{#unless combatWoundsVisible}}hidden{{/unless}} {{collapsibleState "wounds-group" @root.collapsedData}}>
              <summary class="group-summary gum-unified-header">
                <div class="summary-left"><i class="fas fa-chevron-right indicator"></i><i class="fas fa-bandage item-icon"></i><span class="group-name">{{localize "GUM.Wounds.Title"}}</span></div>
                <div class="summary-right"><span class="group-tag">{{localize "GUM.Combat.Wounds.Count" count=preparedWounds.length}}</span><a class="add-wound" title="{{localize 'GUM.Wounds.Register'}}"><i class="fas fa-plus"></i></a></div>
              </summary>
              <div class="group-content wound-list">
                <div class="wound-grid">
                  {{#each preparedWounds}}
                    <article class="wound-card" data-wound-id="{{this.id}}" title="{{this.woundTooltip}}" aria-label="{{localize 'GUM.Combat.Wounds.CardLabel' details=this.woundTooltip}}">
                      <i class="fas {{this.natureIcon}} wound-nature-icon" title="{{this.natureTooltip}}" aria-label="{{this.natureTooltip}}"></i>
                      <div class="wound-value-controls">
                        <button type="button" class="adjust-wound wound-adjust" data-adjustment="-1" title="{{localize 'GUM.Combat.Wounds.Decrease'}}" aria-label="{{localize 'GUM.Combat.Wounds.Decrease'}}"><i class="fas fa-minus" aria-hidden="true"></i></button>
                        <strong class="wound-value" aria-label="{{localize 'GUM.Combat.Wounds.Remaining' value=this.remaining}}">{{this.remaining}}</strong>
                        <button type="button" class="adjust-wound wound-adjust" data-adjustment="1" title="{{localize 'GUM.Combat.Wounds.Increase'}}" aria-label="{{localize 'GUM.Combat.Wounds.Increase'}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
                      </div>
                      <div class="item-controls wound-controls">
                        <div class="gum-action-menu js-action-menu">
                          <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Combat.Wounds.Options'}}" aria-label="{{localize 'GUM.Combat.Wounds.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                          <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Combat.Wounds.Actions'}}">
                            <a class="item-control edit-wound gum-action-menu__item" role="menuitem" title="{{localize 'GUM.Inventory.Edit'}}"><i class="fas fa-edit"></i><span>{{localize "GUM.Inventory.Edit"}}</span></a>
                            <a class="item-control delete-wound gum-action-menu__item is-danger" role="menuitem" title="{{localize 'GUM.Inventory.Delete'}}"><i class="fas fa-trash"></i><span>{{localize "GUM.Inventory.Delete"}}</span></a>
                          </div>
                        </div>
                      </div>
                    </article>
                  {{else}}<div class="placeholder-text">{{localize "GUM.Combat.Wounds.Empty"}}</div>{{/each}}
                </div>
              </div>
            </details>
            <details class="attack-group-details gum-unified-section combat-meters-box combat-fixed-group" data-group-id="combat-meters-group" data-combat-control-group="meters" {{#unless combatMetersVisible}}hidden{{/unless}} {{collapsibleState "combat-meters-group" @root.collapsedData}}>
              <summary class="group-summary gum-unified-header">
                <div class="summary-left">
                  <i class="fas fa-chevron-right indicator"></i>
                  <i class="fas fa-clipboard-list item-icon"></i>
                  <span class="group-name">{{localize "GUM.Combat.Meters.Title"}}</span>
                </div>
                <div class="summary-right">
                  <span class="group-tag">{{localize "GUM.Combat.Meters.Count" count=preparedCombatMeters.length}}</span>

                  <a class="add-combat-meter" title="{{localize 'GUM.Combat.Meters.Add'}}"><i class="fas fa-plus"></i></a>
                </div>
              </summary>
              <div class="group-content combat-meter-group-content">
                <div class="combat-meter-grid">
                  {{#each preparedCombatMeters}}
                    <article class="meter-card combat-meter-card" data-meter-id="{{this.id}}" {{#if this.meter.equipmentId}}data-equipment-id="{{this.meter.equipmentId}}"{{/if}} {{#if (eq this.meter.recordType "integrity")}}data-integrity-record="true"{{/if}} title="{{localize 'GUM.Combat.Meters.CardTitle' name=this.meter.name max=this.meter.max}}" aria-label="{{localize 'GUM.Combat.Meters.CardLabel' name=this.meter.name current=this.meter.current max=this.meter.max}}">
                      <header class="combat-meter-card-header">
                        <i class="fas fa-clipboard-list combat-meter-icon" aria-hidden="true"></i>
                        <strong class="combat-meter-name">{{this.meter.name}}</strong>
                        <div class="item-controls combat-meter-controls">
                          <div class="gum-action-menu js-action-menu">
                            <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Combat.Meters.Options'}}" aria-label="{{localize 'GUM.Combat.Meters.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                            <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Combat.Meters.Actions'}}">
                              <a class="item-control edit-combat-meter gum-action-menu__item" role="menuitem" title="{{#if this.meter.equipmentId}}{{localize 'GUM.Equipment.Reserve.OpenEquipment'}}{{else}}{{localize 'GUM.Inventory.Edit'}}{{/if}}"><i class="fas fa-edit"></i><span>{{#if this.meter.equipmentId}}{{localize "GUM.Equipment.Reserve.OpenEquipment"}}{{else}}{{localize "GUM.Inventory.Edit"}}{{/if}}</span></a>
                              {{#unless this.meter.equipmentId}}<a class="item-control delete-combat-meter gum-action-menu__item is-danger" role="menuitem" title="{{localize 'GUM.Inventory.Delete'}}"><i class="fas fa-trash"></i><span>{{localize "GUM.Inventory.Delete"}}</span></a>{{/unless}}
                            </div>
                          </div>
                        </div>
                                              </header>
                      <div class="combat-meter-value-controls">
                        <button type="button" class="adjust-combat-meter combat-meter-adjust" data-adjustment="-1" title="{{localize 'GUM.Combat.Meters.Decrease'}}" aria-label="{{localize 'GUM.Combat.Meters.DecreaseNamed' name=this.meter.name}}"><i class="fas fa-minus" aria-hidden="true"></i></button>
                        <strong class="combat-meter-value" aria-label="{{localize 'GUM.Combat.Meters.Current' value=this.meter.current}}">{{this.meter.current}}</strong>
                        <button type="button" class="adjust-combat-meter combat-meter-adjust" data-adjustment="1" title="{{localize 'GUM.Combat.Meters.Increase'}}" aria-label="{{localize 'GUM.Combat.Meters.IncreaseNamed' name=this.meter.name}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
                      </div>
                      <div class="combat-meter-meta" aria-hidden="true"><span>{{localize "GUM.Combat.Meters.ReferenceAbbrev"}} <strong>{{this.meter.max}}</strong></span>{{#if (eq this.meter.recordType "integrity")}}<span class="combat-meter-meta-separator">·</span><span>{{localize "GUM.Combat.Meters.ResistanceAbbrev"}} <strong>{{this.meter.dr}}</strong></span>{{else}}{{#if this.meter.equipmentId}}<span class="combat-meter-meta-separator">·</span><span>{{this.meter.source}}</span>{{else}}<span class="combat-meter-meta-separator">·</span><span>{{localize "GUM.Combat.Meters.ResistanceAbbrev"}} <strong>{{this.meter.dr}}</strong></span>{{/if}}{{/if}}</div>
                    </article>
                  {{else}}<div class="placeholder-text combat-meter-placeholder">{{localize "GUM.Combat.Meters.Empty"}}</div>{{/each}}
                </div>
              </div>
            </details>
          </div>



          <nav class="combat-view-switcher" role="tablist" aria-label="{{localize 'GUM.Combat.ViewSelector'}}">
            <button type="button" class="combat-view-tab {{#if (eq @root.combatActionView 'actions')}}is-active{{/if}}" data-combat-view="actions" role="tab" aria-selected="{{#if (eq @root.combatActionView 'actions')}}true{{else}}false{{/if}}" aria-controls="combat-actions-panel"><i class="fas fa-khanda" aria-hidden="true"></i><span>{{localize "GUM.Combat.Actions"}}</span></button>
            <button type="button" class="combat-view-tab {{#if (eq @root.combatActionView 'favorites')}}is-active{{/if}}" data-combat-view="favorites" role="tab" aria-selected="{{#if (eq @root.combatActionView 'favorites')}}true{{else}}false{{/if}}" aria-controls="combat-favorites-panel"><i class="fas fa-star" aria-hidden="true"></i><span>{{localize "GUM.Combat.Favorites.Title"}}</span></button>
          </nav>

          {{!-- Favoritos de combate --}}
          <section id="combat-favorites-panel" class="combat-action-panel combat-action-panel--favorites" data-combat-panel="favorites" role="tabpanel" {{#unless (eq @root.combatActionView "favorites")}}hidden{{/unless}}>
          <div class="attack-group-list-v2 combat-favorites-list">
              <div class="combat-favorites-root-content">
            {{#each combatFavoriteGroupKeys as |groupName groupIndex|}}
              {{#with (lookup @root.combatFavoritesByGroup groupName)}}
              <details class="attack-group-details gum-unified-section" data-group-id="combat-favorites-group-{{groupIndex}}" {{collapsibleState (concat "combat-favorites-group-" groupIndex) @root.collapsedData}}>
                <summary class="group-summary gum-unified-header">
                  <div class="summary-left">
                    <i class="fas fa-chevron-right indicator"></i>
                    <i class="fas fa-star item-icon"></i>
                    <span class="group-name">{{groupName}}</span>
                  </div>
                  <div class="summary-right">
                    <span class="group-tag">
                      {{localize "GUM.Combat.Favorites.ItemCount" count=this.length}}</span>
                  </div>
                </summary>
                <div class="group-content">
                  {{#each this}}
                    {{#if (or (eq this.type "advantage") (eq this.type "disadvantage"))}}
                    <article class="item combat-favorite-card combat-favorite-card--trait {{this.type}}" data-item-id="{{this.id}}" draggable="true">
                      <img class="combat-favorite-card__icon item-quick-view" src="{{this.img}}" alt="{{this.name}}" title="{{localize 'GUM.Characteristics.ViewDetails'}}">
                      <div class="combat-favorite-card__identity">
                        <h4 class="combat-favorite-card__name item-quick-view">{{this.name}}{{#if this.system.specialization}} ({{this.system.specialization}}){{/if}}{{#if this.system.level}} {{this.system.level}}{{/if}}</h4>
                        <div class="combat-favorite-card__meta"><span class="{{this.type}}">{{this.characteristicKindLabel}}</span>{{#if this.characteristicIsRacial}} · {{localize "GUM.Characteristics.Racial"}}{{/if}}{{#if this.combatFavoriteOriginGroup}} · {{this.combatFavoriteOriginGroup}}{{/if}} · {{characteristicPoints this}} {{localize "GUM.Characteristics.PointsAbbreviation"}}{{#if this.system.characteristics}} · {{this.system.characteristics}}{{/if}}</div>
                      </div>
                      {{#if this.system.self_control_roll}}<a class="rollable combat-favorite-card__metric" title="{{localize 'GUM.Characteristics.SelfControlTest'}}" data-type="attribute" data-roll-value="{{this.system.self_control_roll}}" data-label="{{localize 'GUM.Characteristics.SelfControl' name=this.name}}" data-item-id="{{this.id}}"><span>{{localize "GUM.Characteristics.SelfControlAbbreviation"}}</span><strong>{{this.system.self_control_roll}}</strong></a>{{else}}<span class="combat-favorite-card__metric-spacer"></span>{{/if}}
                      <span class="combat-favorite-card__expand-spacer" aria-hidden="true"></span>
                      <div class="item-controls combat-favorite-card__controls"><div class="gum-action-menu js-action-menu"><a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Inventory.Options'}}" aria-label="{{localize 'GUM.Inventory.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a><div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Combat.Favorites.Actions'}}"><a class="item-control item-edit gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{localize "GUM.Inventory.Edit"}}</span></a><a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize "GUM.Inventory.Delete"}}</span></a></div></div></div>
                    </article>
                    {{/if}}

                    {{#if (eq this.type "skill")}}
                    <article class="item combat-favorite-card combat-favorite-card--skill" data-item-id="{{this._id}}" data-item-type="skill" draggable="true">
                      <div class="combat-favorite-card__icon item-quick-view" style="background-image:url('{{this.img}}')" title="{{localize 'GUM.Skills.View'}}"></div>
                      <div class="combat-favorite-card__identity">
                        <h4 class="combat-favorite-card__name item-quick-view" title="{{localize 'GUM.Skills.ViewDetails'}}">{{this.name}}{{#if this.system.specialization}} ({{this.system.specialization}}){{/if}}</h4>
                        <div class="combat-favorite-card__meta">{{this.skillListDisplay.baseAttribute}}{{#if (gte this.skillListDisplay.skillLevel 0)}}+{{/if}}{{this.skillListDisplay.skillLevel}}{{#if this.skillListDisplay.difficulty}} · {{this.skillListDisplay.difficulty}}{{/if}}{{#if this.combatFavoriteOriginGroup}} · {{this.combatFavoriteOriginGroup}}{{/if}} · {{this.skillListDisplay.points}} {{localize "GUM.Skills.PointsAbbreviation"}}{{#if (ne this.skillListDisplay.nhMod 0)}} · {{#if (gte this.skillListDisplay.nhMod 0)}}+{{/if}}{{this.skillListDisplay.nhMod}} {{localize "GUM.Skills.ModifierAbbreviation"}}{{/if}}</div>
                      </div>
                      <a class="rollable combat-favorite-card__metric" data-roll-value="{{#if this.tree_final_nh}}{{this.tree_final_nh}}{{else}}{{this.system.final_nh}}{{/if}}" data-label="{{localize 'GUM.Skills.Test' name=this.name}}" data-type="skill" data-item-id="{{this._id}}" data-attribute-key="{{this.skillListDisplay.baseAttribute}}"><span>{{localize "GUM.Equipment.Attacks.SkillAbbrev"}}</span><strong>{{#if this.tree_final_nh}}{{this.tree_final_nh}}{{else}}{{this.system.final_nh}}{{/if}}</strong></a>
                      <span class="combat-favorite-card__expand-spacer" aria-hidden="true"></span>
                      <div class="item-controls combat-favorite-card__controls"><div class="gum-action-menu js-action-menu"><a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Inventory.Options'}}" aria-label="{{localize 'GUM.Inventory.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a><div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Combat.Favorites.Actions'}}"><a class="item-control item-edit gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{localize "GUM.Inventory.Edit"}}</span></a><a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize "GUM.Inventory.Delete"}}</span></a></div></div></div>
                    </article>
                    {{/if}}

                    {{#if (or (eq this.type "spell") (eq this.type "power"))}}
                    <article class="item magic-card combat-favorite-card combat-favorite-card--magic{{#if (eq this.type 'power')}} power-card{{/if}}{{#if this.magicCardExpanded}} is-expanded{{/if}}{{#if this.powerCardExpanded}} is-expanded{{/if}}" data-item-id="{{this.id}}" draggable="true">
                      <div class="combat-favorite-card__main">
                        <img class="combat-favorite-card__icon item-quick-view" src="{{this.img}}" alt="{{this.name}}">
                        <div class="combat-favorite-card__identity">
                          <h4 class="combat-favorite-card__name item-quick-view">{{this.name}}</h4>
                          <div class="combat-favorite-card__meta">{{#if (eq this.type "spell")}}{{this.magicCardIdentity}}{{else}}{{this.powerCardIdentity}}{{/if}}{{#if this.combatFavoriteOriginGroup}} · {{this.combatFavoriteOriginGroup}}{{/if}}</div>
                          <div class="combat-favorite-card__mechanics">{{#if (eq this.type "spell")}}<span title="{{localize 'GUM.Spells.TimeHint'}}"><strong>{{localize "GUM.Spells.Time"}}</strong> {{this.system.casting_time}} · {{this.system.duration}}</span><span title="{{localize 'GUM.Spells.ManaHint'}}"><strong>{{localize "GUM.Spells.Mana"}}</strong> {{this.system.mana_cost}} / {{this.system.mana_maint}}</span>{{else}}<span title="{{localize 'GUM.Powers.TimeHint'}}"><strong>{{localize "GUM.Powers.Time"}}</strong> {{this.system.activation_time}} · {{this.system.duration}}</span><span title="{{localize 'GUM.Powers.CostHint'}}"><strong>{{localize "GUM.Powers.Cost"}}</strong> {{this.system.activation_cost}} / {{this.system.maint_cost}}</span>{{/if}}</div>
                        </div>
                        <a class="rollable combat-favorite-card__metric" data-type="{{this.type}}" data-roll-value="{{this.system.final_nh}}" data-label="{{#if (eq this.type 'spell')}}{{localize 'GUM.Spells.Test' name=this.name}}{{else}}{{localize 'GUM.Powers.Test' name=this.name}}{{/if}}" data-item-id="{{this.id}}"><span>{{localize "GUM.Spells.SkillLevel"}}</span><strong>{{this.system.final_nh}}</strong></a>
                        <div class="combat-favorite-card__damage"><span>{{localize "GUM.Spells.Damage"}}</span>{{#if this.system.damage.formula}}<div><a class="rollable-damage" title="{{localize 'GUM.Spells.RollDamage'}}" data-item-id="{{this.id}}">{{this.system.damage.formula}} {{this.system.damage.type}}</a>{{#if (eq this.type "spell")}}{{#if this.magicCardAdditionalDamageMarkers}}<sup title="{{this.magicCardAdditionalDamageHint}}">{{this.magicCardAdditionalDamageMarkers}}</sup>{{/if}}{{else}}{{#if this.powerCardAdditionalDamageMarkers}}<sup title="{{this.powerCardAdditionalDamageHint}}">{{this.powerCardAdditionalDamageMarkers}}</sup>{{/if}}{{/if}}</div>{{else}}<strong>—</strong>{{/if}}</div>
                        <button type="button" class="magic-card__expand combat-favorite-card__expand" title="{{#if (eq this.type 'spell')}}{{#if this.magicCardExpanded}}{{localize 'GUM.Spells.CollapseDetails'}}{{else}}{{localize 'GUM.Spells.ExpandDetails'}}{{/if}}{{else}}{{#if this.powerCardExpanded}}{{localize 'GUM.Powers.CollapseDetails'}}{{else}}{{localize 'GUM.Powers.ExpandDetails'}}{{/if}}{{/if}}" aria-label="{{#if (eq this.type 'spell')}}{{#if this.magicCardExpanded}}{{localize 'GUM.Spells.CollapseDetails'}}{{else}}{{localize 'GUM.Spells.ExpandDetails'}}{{/if}}{{else}}{{#if this.powerCardExpanded}}{{localize 'GUM.Powers.CollapseDetails'}}{{else}}{{localize 'GUM.Powers.ExpandDetails'}}{{/if}}{{/if}}" aria-expanded="{{#if (or this.magicCardExpanded this.powerCardExpanded)}}true{{else}}false{{/if}}"><i class="fas {{#if (or this.magicCardExpanded this.powerCardExpanded)}}fa-compress-arrows-alt{{else}}fa-expand-arrows-alt{{/if}}"></i></button>
                        <div class="item-controls combat-favorite-card__controls"><div class="gum-action-menu js-action-menu"><a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Inventory.Options'}}" aria-label="{{localize 'GUM.Inventory.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a><div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Combat.Favorites.Actions'}}"><a class="item-control item-quick-view gum-action-menu__item" role="menuitem"><i class="fas fa-eye"></i><span>{{localize "GUM.Combat.Favorites.View"}}</span></a><a class="item-control item-edit gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{localize "GUM.Inventory.Edit"}}</span></a><a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize "GUM.Inventory.Delete"}}</span></a></div></div></div>
                      </div>
                      <div class="magic-card__details combat-favorite-card__details" {{#unless (or this.magicCardExpanded this.powerCardExpanded)}}hidden{{/unless}}>
                        <section class="magic-card__detail-branch magic-card__detail-branch--mechanics">
                          <h5><i class="fas fa-hourglass-half"></i>{{#if (eq this.type "spell")}}{{localize "GUM.Spells.Mechanics"}}{{else}}{{localize "GUM.Powers.Mechanics"}}{{/if}}</h5>
                          <div class="magic-card__detail-values">
                            {{#if (eq this.type "spell")}}
                            <span><strong>{{localize "GUM.Spells.CastingTime"}}</strong>{{this.system.casting_time}}</span><span><strong>{{localize "GUM.Spells.Duration"}}</strong>{{this.system.duration}}</span><span><strong>{{localize "GUM.Spells.CastingCost"}}</strong>{{this.system.mana_cost}}</span><span><strong>{{localize "GUM.Spells.MaintenanceCost"}}</strong>{{this.system.mana_maint}}</span>
                            {{else}}
                            <span><strong>{{localize "GUM.Powers.ActivationTime"}}</strong>{{this.system.activation_time}}</span><span><strong>{{localize "GUM.Powers.Duration"}}</strong>{{this.system.duration}}</span><span><strong>{{localize "GUM.Powers.ActivationCost"}}</strong>{{this.system.activation_cost}}</span><span><strong>{{localize "GUM.Powers.MaintenanceCost"}}</strong>{{this.system.maint_cost}}</span>
                            {{/if}}
                          </div>
                        </section>
                        {{#if this.system.uses_attack}}<section class="magic-card__detail-branch magic-card__detail-branch--attack"><h5><i class="fas fa-crosshairs"></i>{{localize "GUM.Spells.Attack"}}</h5><div class="magic-card__detail-values"><span><strong>{{localize "GUM.Spells.Type"}}</strong>{{#if (eq this.system.attack_type 'melee')}}{{localize "GUM.Spells.Melee"}}{{else}}{{localize "GUM.Spells.Ranged"}}{{/if}}</span><span><strong>{{localize "GUM.Spells.Skill"}}</strong>{{#if this.system.attack_roll.resolved_skill_name}}{{this.system.attack_roll.resolved_skill_name}}{{else}}{{this.system.attack_roll.skill_name}}{{/if}}</span>{{#if this.system.attack_nh}}<a class="rollable magic-card__attack-level-tag" data-type="attack" data-attack-type="{{this.system.attack_type}}" data-attribute-key="{{this.system.attack_roll.skill_name}}" data-roll-value="{{this.system.attack_nh}}" data-label="{{#if (eq this.type 'spell')}}{{localize 'GUM.Spells.AttackTest' name=this.name}}{{else}}{{localize 'GUM.Powers.AttackTest' name=this.name}}{{/if}}" data-item-id="{{this.id}}"><strong>{{localize "GUM.Spells.SkillLevel"}}</strong>{{this.system.attack_nh}}</a>{{/if}}{{#if (eq this.system.attack_type 'melee')}}{{#if this.system.attack_roll.reach}}<span><strong>{{localize "GUM.Spells.Reach"}}</strong>{{this.system.attack_roll.reach}}</span>{{/if}}{{#if this.system.attack_roll.parry}}<span><strong>{{localize "GUM.Spells.Parry"}}</strong>{{this.system.attack_roll.parry}}</span>{{/if}}{{else}}{{#if this.system.attack_roll.accuracy}}<span><strong>{{localize "GUM.Spells.Accuracy"}}</strong>{{this.system.attack_roll.accuracy}}</span>{{/if}}{{#if this.system.attack_roll.range}}<span><strong>{{localize "GUM.Spells.Range"}}</strong>{{this.system.attack_roll.range}}</span>{{/if}}{{#if this.system.attack_roll.rof}}<span><strong>{{localize "GUM.Spells.RateOfFire"}}</strong>{{this.system.attack_roll.rof}}</span>{{/if}}{{#if this.system.attack_roll.shots}}<span><strong>{{localize "GUM.Spells.Shots"}}</strong>{{this.system.attack_roll.shots}}</span>{{/if}}{{#if this.system.attack_roll.bulk}}<span><strong>{{localize "GUM.Spells.Bulk"}}</strong>{{this.system.attack_roll.bulk}}</span>{{/if}}{{#if this.system.attack_roll.rcl}}<span><strong>{{localize "GUM.Spells.Recoil"}}</strong>{{this.system.attack_roll.rcl}}</span>{{/if}}{{/if}}</div></section>{{/if}}
                        {{#if this.system.damage.formula}}<section class="magic-card__detail-branch magic-card__detail-branch--damage"><h5><i class="fas fa-burst"></i>{{localize "GUM.Spells.Damage"}}</h5><div class="magic-card__detail-values"><a class="rollable-damage" data-item-id="{{this.id}}"><strong>{{localize "GUM.Spells.PrimaryDamage"}}</strong>{{this.system.damage.formula}} {{this.system.damage.type}}{{#if this.system.damage.nature}} · {{this.system.damage.nature}}{{/if}}{{#if (gt this.system.damage.armor_divisor 1)}} · ÷{{this.system.damage.armor_divisor}}{{/if}}</a>{{#if this.system.damage.follow_up_damage.formula}}<span><strong>{{localize "GUM.Spells.FollowUpDamage"}}</strong>{{this.system.damage.follow_up_damage.formula}} {{this.system.damage.follow_up_damage.type}}</span>{{/if}}{{#if this.system.damage.fragmentation_damage.formula}}<span><strong>{{localize "GUM.Spells.FragmentationDamage"}}</strong>{{this.system.damage.fragmentation_damage.formula}} {{this.system.damage.fragmentation_damage.type}}</span>{{/if}}</div></section>{{/if}}
                        {{#if (eq this.type "power")}}<section class="magic-card__detail-branch magic-card__detail-branch--resolution"><h5><i class="fas fa-clipboard-check"></i>{{localize "GUM.Powers.Configuration"}}</h5><div class="magic-card__detail-values"><span><strong>{{localize "GUM.Powers.Points"}}</strong>{{characteristicPoints this}}{{#if (eq this.system.cost_paid "alternative")}} {{localize "GUM.Powers.Alternative"}}{{/if}}</span>{{#if this.system.resistance}}<span><strong>{{localize "GUM.Spells.Resistance"}}</strong>{{this.system.resistance}}</span>{{/if}}{{#if this.system.requires_concentration}}<span><i class="fas fa-brain"></i> {{localize "GUM.Spells.RequiresConcentration"}}</span>{{/if}}{{#if this.system.effect}}<span class="magic-card__effect"><strong>{{localize "GUM.Spells.Effect"}}</strong>{{this.system.effect}}</span>{{/if}}</div></section>{{else}}{{#if (or this.system.resistance this.system.requires_concentration this.system.effect)}}<section class="magic-card__detail-branch magic-card__detail-branch--resolution"><h5><i class="fas fa-clipboard-check"></i>{{localize "GUM.Spells.Resolution"}}</h5><div class="magic-card__detail-values">{{#if this.system.resistance}}<span><strong>{{localize "GUM.Spells.Resistance"}}</strong>{{this.system.resistance}}</span>{{/if}}{{#if this.system.requires_concentration}}<span><i class="fas fa-brain"></i> {{localize "GUM.Spells.RequiresConcentration"}}</span>{{/if}}{{#if this.system.effect}}<span class="magic-card__effect"><strong>{{localize "GUM.Spells.Effect"}}</strong>{{this.system.effect}}</span>{{/if}}</div></section>{{/if}}{{/if}}
                      </div>
                    </article>
                    {{/if}}
                  {{/each}}
                </div>
              </details>
              {{/with}}
            {{/each}}
                {{#unless combatFavoriteGroupKeys}}
                  <div class="placeholder-text">{{localize "GUM.Combat.Favorites.Empty"}}</div>
                {{/unless}}
              </div>
          </div>
          </section>

          {{!-- Bloco de Lista de ataque --}}
    <section id="combat-actions-panel" class="combat-action-panel combat-action-panel--actions" data-combat-panel="actions" role="tabpanel" {{#unless (eq @root.combatActionView "actions")}}hidden{{/unless}}>
    <div class="combat-filter-list combat-filter-list--actions" role="group" aria-label="{{localize 'GUM.Combat.Filters.AttackGroups'}}">
      <button type="button" class="combat-filter-chip {{#if combatAttackFilterAll}}is-active{{/if}}" data-filter-scope="actions" data-filter-value="all" aria-pressed="{{#if combatAttackFilterAll}}true{{else}}false{{/if}}">{{localize "GUM.Combat.Filters.All"}}</button>
      {{#each attackGroups as |group|}}
      <button type="button" class="combat-filter-chip {{#if group.combatFilterActive}}is-active{{/if}}" data-filter-scope="actions" data-filter-value="{{group.id}}" aria-pressed="{{#if group.combatFilterActive}}true{{else}}false{{/if}}" title="{{group.name}}">{{group.name}}</button>
      {{/each}}
    </div>
    <div class="attack-group-list-v2 combat-actions-list">
    {{#each attackGroups as |group|}}
    {{!-- USANDO group.id EM VEZ DE group.name --}}
    <details class="attack-group-details gum-unified-section" data-group-id="attack-group-{{group.id}}" data-combat-filter-group="{{group.id}}" {{#unless group.combatFilterVisible}}hidden{{/unless}} {{collapsibleState (concat "attack-group-" group.id) @root.collapsedData}}>

        <summary class="group-summary gum-unified-header">
            <div class="summary-left">
            <i class="fas fa-chevron-right indicator"></i>
            <i class="fas fa-khanda-alt item-icon"></i>
            <span class="group-name">{{group.name}}</span>
            </div>

            <div class="summary-right">
            {{#if (gt group.weight 0)}}
                <span class="group-tag weight">{{group.weight}} kg</span>
            {{/if}}
            {{#if (gt group.defense_bonus 0)}}
                <span class="group-tag db" title="{{localize 'GUM.Combat.Attacks.DefenseBonus'}}">{{localize "GUM.Combat.Attacks.DefenseBonusAbbrev"}} +{{group.defense_bonus}}</span>
            {{/if}}
            <a class="item-control item-edit" data-item-id="{{group.id}}" title="{{localize 'GUM.Combat.Attacks.OpenItem'}}">
                <i class="fas fa-cog"></i>
            </a>
            </div>
        </summary>

        <div class="group-content">
            {{#each group.attacks as |attack|}}
              <div class="attack-row item-row attack-card-two-line attack-card-two-line--{{attack.attack_type}}" data-attack-id="{{attack.id}}" data-item-id="{{attack.itemId}}">
                <div class="attack-card-primary">
                  <div class="attack-icon">
                    {{#if (eq attack.attack_type "melee")}}<i class="fas fa-swords" title="{{localize 'GUM.Equipment.Attacks.Melee'}}"></i>{{/if}}
                    {{#if (eq attack.attack_type "ranged")}}<i class="fas fa-bullseye" title="{{localize 'GUM.Equipment.Attacks.Ranged'}}"></i>{{/if}}
                  </div>

                  <div class="attack-name-stack">
                    <h4 class="attack-name">{{attack.name}}</h4>
                    <div class="attack-source-line">{{attack.skill_name}}</div>
                  </div>

                  <div class="attack-primary-stats">
<a class="attack-pill-stat rollable" data-type="attack" data-attack-type="{{attack.attack_type}}" data-roll-value="{{attack.final_nh}}" data-label="{{group.name}} ({{attack.name}})" data-item-id="{{attack.itemId}}" data-attack-id="{{attack.id}}" title="{{localize 'GUM.Combat.Attacks.RollAttack'}}">
                      <span class="attack-label">{{localize "GUM.Equipment.Attacks.SkillAbbrev"}}</span>
                      <span class="attack-value">{{attack.final_nh}}</span>
                    </a>

                    <a class="attack-pill-stat damage rollable-damage"
                        title="{{localize 'GUM.Combat.Attacks.RollDamage'}}"
                        data-item-id="{{attack.itemId}}"
                        data-attack-id="{{attack.id}}"
                        data-dmg-formula="{{attack.damage_formula}}"
                        data-dmg-type="{{attack.damage_type}}"
                        data-armor-divisor="{{attack.armor_divisor}}"
                        {{#with attack.follow_up_damage}}
                          {{#if this.formula}}
                            data-followup-formula="{{this.formula}}"
                            data-followup-type="{{this.type}}"
                          {{/if}}
                        {{/with}}>
                      <span class="attack-label">{{localize "GUM.Equipment.Attacks.Damage"}}</span>
                      <span class="attack-value attack-damage-main">
                          {{attack.damage_display_formula}}{{#if (gt attack.armor_divisor 1)}}({{attack.armor_divisor}}){{/if}} {{attack.damage_type}}{{#if attack.damage_nature_display}} [{{attack.damage_nature_display}}]{{/if}}{{#if attack.damage_scaling}} ({{attack.damage_scaling}}){{/if}}
                      </span>
                    </a>

                    {{#if (eq attack.attack_type "melee")}}
                    {{#if attack.final_parry}}
                    <a class="attack-pill-stat defense rollable" data-type="defense" data-roll-value="{{attack.final_parry}}" data-label="{{localize 'GUM.Combat.Attacks.ParryTest'}}" data-defense-type="parry" data-defense-bonus-included="true" data-item-id="{{attack.itemId}}" data-attack-id="{{attack.id}}" data-attack-type="{{attack.attack_type}}" title="{{localize 'GUM.Combat.Attacks.RollParry'}}">
                      <span class="attack-label">{{localize "GUM.Equipment.Attacks.ParryAbbrev"}}</span>
                      <span class="attack-value">{{attack.final_parry}}</span>
                    </a>
                      {{else}}
                    <div class="attack-pill-stat defense is-disabled">
                      <span class="attack-label">{{localize "GUM.Equipment.Attacks.ParryAbbrev"}}</span>
                      <span class="attack-value is-empty" title="{{localize 'GUM.Combat.Attacks.ParryUnavailable'}}" aria-label="{{localize 'GUM.Combat.Attacks.ParryUnavailable'}}">—</span>
                    </div>
                    {{/if}}
                    {{#if attack.final_block}}
                    <a class="attack-pill-stat defense rollable" data-type="defense" data-roll-value="{{attack.final_block}}" data-label="{{localize 'GUM.Combat.Attacks.BlockTest'}}" data-defense-type="block" data-defense-bonus-included="true" data-item-id="{{attack.itemId}}" data-attack-id="{{attack.id}}" data-attack-type="{{attack.attack_type}}" title="{{localize 'GUM.Combat.Attacks.RollBlock'}}">
                      <span class="attack-label">{{localize "GUM.Equipment.Attacks.BlockAbbrev"}}</span>
                      <span class="attack-value">{{attack.final_block}}</span>
                    </a>
                      {{else}}
                    <div class="attack-pill-stat defense is-disabled">
                      <span class="attack-label">{{localize "GUM.Equipment.Attacks.BlockAbbrev"}}</span>
                      <span class="attack-value is-empty" title="{{localize 'GUM.Combat.Attacks.BlockUnavailable'}}" aria-label="{{localize 'GUM.Combat.Attacks.BlockUnavailable'}}">—</span>
                    </div>
                    {{/if}}
                    {{/if}}
                  </div>
                </div>

                <div class="attack-card-secondary">
                  {{#if (eq attack.attack_type "melee")}}
                  <span><strong>{{localize "GUM.Equipment.Attacks.ReachAbbrev"}}</strong> {{attack.reach}}</span>
                  <span><strong>{{localize "GUM.Equipment.Attacks.MinStrengthAbbrev"}}</strong> {{attack.min_strength}}</span>
                  {{#if attack.unbalanced}}<span class="attack-secondary-flag"><strong>U</strong> {{localize "GUM.Equipment.Attacks.Unbalanced"}}</span>{{/if}}
                  {{#if attack.fencing}}<span class="attack-secondary-flag"><strong>F</strong> {{localize "GUM.Equipment.Attacks.Fencing"}}</span>{{/if}}
                  {{/if}}

                  {{#if (eq attack.attack_type "ranged")}}
                  {{#if attack.range}}<span><strong>{{localize "GUM.Equipment.Attacks.ReachAbbrev"}}</strong> {{attack.range}}</span>{{/if}}
                  <span><strong>{{localize "GUM.Equipment.Attacks.AccuracyAbbrev"}}</strong> {{attack.accuracy}}</span>
                  <span><strong>{{localize "GUM.Equipment.Attacks.RofAbbrev"}}</strong> {{#if attack.rof}}{{attack.rof}}{{else}}—{{/if}}</span>
                  <span><strong>{{localize "GUM.Combat.Attacks.ShotsAbbrev"}}</strong> {{#if attack.shots}}{{attack.shots}}{{else}}—{{/if}}</span>
                  <span><strong>{{localize "GUM.Equipment.Attacks.RecoilAbbrev"}}</strong> {{#if attack.rcl}}{{attack.rcl}}{{else}}—{{/if}}</span>
                  <span><strong>{{localize "GUM.Combat.Attacks.BulkAbbrev"}}</strong> {{attack.mag}}</span>
                  <span><strong>{{localize "GUM.Equipment.Attacks.MinStrengthAbbrev"}}</strong> {{attack.min_strength}}</span>
                  {{/if}}

                  {{#with attack.fragmentation_damage}}
                    {{#if this.formula}}
                    <span class="attack-damage-extra"><strong>FR</strong> {{this.display_formula}}{{#if (gt this.armor_divisor 1)}}({{this.armor_divisor}}){{/if}} {{this.type}}{{#if this.nature_display}} [{{this.nature_display}}]{{/if}}</span>
                    {{/if}}
                  {{/with}}
                  {{#with attack.follow_up_damage}}
                    {{#if this.formula}}
                    <span class="attack-damage-extra"><strong>FU</strong> {{this.display_formula}}{{#if (gt this.armor_divisor 1)}}({{this.armor_divisor}}){{/if}} {{this.type}}{{#if this.nature_display}} [{{this.nature_display}}]{{/if}}</span>
                    {{/if}}
                  {{/with}}
                </div>
              </div>
            {{/each}}
        </div>
    </details>
    {{/each}}
    {{#unless attackGroups}}
    <div class="placeholder-text">{{localize "GUM.Combat.Attacks.Empty"}}</div>
    {{/unless}}
</div>
    </section>

        </div>

      </div>
    </div>

    {{! ========================================================= }}
    {{!  ABA DE BIOGRAFIA (ESTRUTURA REFINADA E PADRONIZADA)      }}
    {{! ========================================================= }}
    <div class="tab" data-group="primary" data-tab="biography">

      <div class="biography-layout">

        {{!-- Coluna Lateral: Perfil do Personagem --}}
        <div class="biography-details">
          <section class="biography-models-block" aria-label="{{localize "GUM.Template.AppliedModels"}}">
            <div class="biography-models-grid">
              <div class="biography-models-action">
                <button type="button" class="add-character-model-btn biography-model-add-btn">
                  <i class="fas fa-plus"></i> {{localize "GUM.Template.Model"}}
                </button>
              </div>
