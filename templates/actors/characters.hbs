{{!--     ABA DE CONDIÇÕES ("CASTELO SÓLIDO" V5 - FINAL)            --}}
{{!-- ============================================================= --}}
<div class="tab conditions-tab" data-group="primary" data-tab="conditions">

    {{!-- ============================================================= --}}
    {{!--     SEÇÃO 1: EFEITOS TEMPORÁRIOS                              --}}
    {{!-- ============================================================= --}}
    <details class="form-section gum-details temporary-section gum-unified-section" data-group-id="cond-temp" {{collapsibleState "cond-temp" @root.collapsedData}}>
        <summary class="block-header gum-unified-header">
            <div class="header-left">
                <i class="fas fa-chevron-right indicator"></i>
                <span class="header-title">{{localize 'GUM.Conditions.TemporaryEffects'}}</span>
                <span class="header-counter">{{temporaryEffects.length}}</span>
            </div>
            <p class="header-hint">{{localize 'GUM.Conditions.TemporaryHint'}}</p>
        </summary>

        <div class="effects-grid-container">
            {{#each temporaryEffectGroups as |group|}}
            <details class="effect-origin-group gum-details" data-group-id="cond-temp-origin-{{group.key}}" {{collapsibleState (concat "cond-temp-origin-" group.key) @root.collapsedData}}>
                <summary class="effect-origin-summary">
                    <span class="origin-heading"><i class="{{group.icon}}"></i> {{group.label}}</span>
                    <span class="header-counter">{{group.effects.length}}</span>
                    <i class="fas fa-chevron-right indicator"></i>
                </summary>
                <div class="effect-origin-list">
            {{#each group.effects as |effect|}}
                <div class="effect-pill-enhanced temp-effect" data-effect-id="{{effect.id}}" data-effect-item-uuid="{{effect.effectItemUuid}}" data-origin-uuid="{{effect.fonteUuid}}" data-duration="{{effect.durationString}}" data-source-name="{{effect.fonteNome}}">
                    <div class="pill-card-visual">
                        <img src="{{effect.img}}" class="pill-icon effect-quick-view" title="{{localize 'GUM.Conditions.ViewDetails'}}"/>
                        <div class="pill-switch-wrapper"><label class="switch" title="{{localize 'GUM.Conditions.ToggleEffect'}}"><input type="checkbox" class="effect-toggle" data-effect-id="{{effect.id}}" {{checked effect.disabled}}><span class="slider round"></span></label></div>
                    </div>
                    <div class="pill-card-content">
                    <div class="pill-info">
                        <span class="pill-name effect-quick-view" title="{{localize 'GUM.Conditions.ViewDetails'}}">{{effect.name}}</span>
                        <div class="pill-details">
                            <span class="pill-tag duration" title="{{localize 'GUM.Conditions.RemainingDuration'}}">
                                <i class="fas fa-hourglass-half"></i> {{effect.durationString}}
                            </span>
                            {{#if effect.disabled}}
                                <span class="pill-tag status off">{{localize 'GUM.Conditions.Disabled'}}</span>
                            {{else}}
                                <span class="pill-tag status on">{{localize 'GUM.Conditions.Active'}}</span>
                            {{/if}}
                            {{#if effect.appliedStatusLabel}}
                                <span class="pill-tag status-applied">{{localize 'GUM.Conditions.AppliedStatus' status=effect.appliedStatusLabel}}</span>
                            {{/if}}
                            {{#if effect.hasStackCount}}
                                <span class="pill-tag stack-count" title="{{localize 'GUM.Conditions.StackCountTitle'}}"><i class="fas fa-layer-group"></i> ×{{effect.stackCount}}</span>
                            {{/if}}
                            {{#if effect.fonteNome}}
                            <span class="pill-tag source" title="{{localize 'GUM.Conditions.SourceLabel' source=effect.fonteNome}}">
                                <i class="{{effect.fonteIcon}}"></i> {{effect.fonteRotulo}} · {{effect.fonteNome}}
                            </span>
                            {{/if}}
                        </div>
                    </div>
                    </div>
                    <div class="pill-controls">
                        <div class="gum-action-menu js-action-menu">
                          <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Inventory.Options'}}" aria-label="{{localize 'GUM.Inventory.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                          <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Inventory.Options'}}">
                            <a class="effect-control effect-quick-view gum-action-menu__item" role="menuitem"><i class="fas fa-eye"></i><span>{{localize 'GUM.Conditions.ViewDetails'}}</span></a>
                            <a class="effect-control delete gum-action-menu__item is-danger" role="menuitem" data-action="delete-effect" data-effect-id="{{effect.id}}"><i class="fas fa-trash"></i><span>{{localize 'GUM.Conditions.Remove'}}</span></a>
                          </div>
                        </div>
                    </div>
                 </div>
            {{/each}}
                </div>
            </details>
            {{/each}}

            {{#unless temporaryEffects.length}}
                <div class="placeholder-text">{{localize 'GUM.Conditions.NoTemporaryEffects'}}</div>
            {{/unless}}
        </div>
    </details>

    {{!-- ============================================================= --}}
    {{!--     SEÇÃO 2: EFEITOS PERMANENTES                              --}}
    {{!-- ============================================================= --}}
    <details class="form-section gum-details permanent-section gum-unified-section" data-group-id="cond-perm" {{collapsibleState "cond-perm" @root.collapsedData}}>
        <summary class="block-header gum-unified-header">
            <div class="header-left">
                <i class="fas fa-chevron-right indicator"></i>
                <span class="header-title">{{localize 'GUM.Conditions.PermanentEffects'}}</span>
                <span class="header-counter">{{permanentEffects.length}}</span>
            </div>
            <p class="header-hint">{{localize 'GUM.Conditions.PermanentHint'}}</p>
        </summary>

        <div class="effects-grid-container">
           {{#each permanentEffectGroups as |group|}}
            <details class="effect-origin-group gum-details" data-group-id="cond-perm-origin-{{group.key}}" {{collapsibleState (concat "cond-perm-origin-" group.key) @root.collapsedData}}>
                <summary class="effect-origin-summary">
                    <span class="origin-heading"><i class="{{group.icon}}"></i> {{group.label}}</span>
                    <span class="header-counter">{{group.effects.length}}</span>
                    <i class="fas fa-chevron-right indicator"></i>
                </summary>
                <div class="effect-origin-list">
            {{#each group.effects as |effect|}}
                <div class="effect-pill-enhanced perm-effect" data-effect-id="{{effect.id}}" data-effect-item-uuid="{{effect.effectItemUuid}}" data-origin-uuid="{{effect.fonteUuid}}" data-duration="{{effect.durationString}}" data-source-name="{{effect.fonteNome}}">
                    <div class="pill-card-visual">
                        <img src="{{effect.img}}" class="pill-icon effect-quick-view" title="{{localize 'GUM.Conditions.ViewDetails'}}"/>
                        <div class="pill-switch-wrapper"><label class="switch" title="{{localize 'GUM.Conditions.ToggleEffect'}}"><input type="checkbox" class="effect-toggle" data-effect-id="{{effect.id}}" {{checked effect.disabled}}><span class="slider round"></span></label></div>
                    </div>
                    <div class="pill-card-content">
                    <div class="pill-info">
                        <span class="pill-name effect-quick-view" title="{{localize 'GUM.Conditions.ViewDetails'}}">{{effect.name}}</span>
                        <div class="pill-details">
                           {{#if effect.disabled}}
                                <span class="pill-tag status off">{{localize 'GUM.Conditions.Disabled'}}</span>
                            {{else}}
                                <span class="pill-tag status on">{{localize 'GUM.Conditions.Active'}}</span>
                            {{/if}}
                            {{#if effect.appliedStatusLabel}}
                                <span class="pill-tag status-applied">{{localize 'GUM.Conditions.AppliedStatus' status=effect.appliedStatusLabel}}</span>
                            {{/if}}
                            {{#if effect.hasStackCount}}
                                <span class="pill-tag stack-count" title="{{localize 'GUM.Conditions.StackCountTitle'}}"><i class="fas fa-layer-group"></i> ×{{effect.stackCount}}</span>
                            {{/if}}
                            <span class="pill-tag source" title="{{localize 'GUM.Conditions.SourceLabel' source=effect.fonteNome}}">
                                <i class="{{effect.fonteIcon}}"></i> {{effect.fonteRotulo}} · {{effect.fonteNome}}
                            </span>
                        </div>
                    </div>
                    </div>
                    <div class="pill-controls">
                        <div class="gum-action-menu js-action-menu">
                          <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Inventory.Options'}}" aria-label="{{localize 'GUM.Inventory.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                          <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Inventory.Options'}}">
                            <a class="effect-control effect-quick-view gum-action-menu__item" role="menuitem"><i class="fas fa-eye"></i><span>{{localize 'GUM.Conditions.ViewDetails'}}</span></a>
                            <a class="effect-control delete gum-action-menu__item is-danger" role="menuitem" data-action="delete-effect" data-effect-id="{{effect.id}}"><i class="fas fa-trash"></i><span>{{localize 'GUM.Conditions.Remove'}}</span></a>
                          </div>
                        </div>
                    </div>
                     </div>
            {{/each}}
                </div>
            </details>
            {{/each}}

            {{#unless permanentEffects.length}}
                <div class="placeholder-text">{{localize 'GUM.Conditions.NoPermanentEffects'}}</div>
            {{/unless}}
        </div>
    </details>

    {{!-- ============================================================= --}}
    {{!--     SEÇÃO 3: CONDIÇÕES PASSIVAS (REGRAS / INSTALLED)          --}}
    {{!-- ============================================================= --}}
    <details class="form-section gum-details passive-section gum-unified-section" data-group-id="cond-passive" {{collapsibleState "cond-passive" @root.collapsedData}}>
        <summary class="block-header gum-unified-header">
            <div class="header-left">
                <i class="fas fa-chevron-right indicator"></i>
                <span class="header-title">{{localize 'GUM.Conditions.PassiveRules'}}</span>
                <span class="header-counter">{{installedConditions.length}}</span>
            </div>
            <p class="header-hint">{{localize 'GUM.Conditions.PassiveHint'}}</p>
        </summary>

        <div class="effects-grid-container">
            {{#each installedConditions as |item|}}
                <div class="item effect-pill-enhanced passive-rule" data-item-id="{{item.id}}">
                    <div class="pill-card-visual">
                        <img src="{{item.img}}" class="pill-icon item-quick-view" alt="{{item.name}}" title="{{localize 'GUM.Conditions.ViewDetails'}}"/>
                        <div class="pill-switch-wrapper"><label class="switch" title="{{localize 'GUM.Conditions.OverrideAutomation'}}"><input type="checkbox" class="manual-override-toggle" data-item-id="{{item.id}}" {{checked item.flags.gum.manual_override}}><span class="slider round"></span></label></div>
                    </div>
                    <div class="pill-card-content">
                    <div class="pill-info">
                        <span class="pill-name item-quick-view" title="{{localize 'GUM.Conditions.ViewDetails'}}">{{item.name}}</span>
                        <div class="pill-details">
                            {{#if item.flags.gum.manual_override}}
                                <span class="pill-tag status off">{{localize 'GUM.Conditions.Disabled'}}</span>
                            {{else}}
                                <span class="pill-tag status on">{{localize 'GUM.Conditions.Automatic'}}</span>
                            {{/if}}
                        </div>
                    </div>
                    </div>
                    <div class="pill-controls">
                        <div class="gum-action-menu js-action-menu">
                          <a class="item-control gum-action-menu__toggle js-action-menu-toggle" title="{{localize 'GUM.Inventory.Options'}}" aria-label="{{localize 'GUM.Inventory.Options'}}" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                          <div class="gum-action-menu__panel js-action-menu-panel" role="menu" aria-label="{{localize 'GUM.Inventory.Options'}}">
                            <a class="item-control item-quick-view gum-action-menu__item" role="menuitem"><i class="fas fa-eye"></i><span>{{localize 'GUM.Conditions.ViewDetails'}}</span></a>
                            <a class="item-control item-edit gum-action-menu__item" role="menuitem"><i class="fas fa-edit"></i><span>{{localize 'GUM.Conditions.EditRule'}}</span></a>
                            <a class="item-control item-delete gum-action-menu__item is-danger" role="menuitem"><i class="fas fa-trash"></i><span>{{localize 'GUM.Conditions.RemoveRule'}}</span></a>
                          </div>
                        </div>
                    </div>
                </div>
            {{/each}}

            {{#unless installedConditions.length}}
                <div class="placeholder-text">{{localize 'GUM.Conditions.NoPassiveRules'}}</div>
            {{/unless}}
        </div>
    </details>

</div>


  </div>
  </main>
</div>


