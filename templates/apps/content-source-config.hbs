<form class="gum-content-source-form">
  <div class="content-source-scroll">
  <div class="content-source-intro">
    <h1>{{localize "GUM.ContentSources.Heading"}}</h1>
    <p>{{localize "GUM.ContentSources.Introduction"}}</p>
  </div>

  {{#each purposes as |purpose|}}
  <section class="content-source-purpose" data-purpose="{{purpose.id}}">
    <header class="content-source-purpose-header">
      <div class="content-source-purpose-copy">
        <h2>{{purpose.label}}</h2>
        <p class="notes">{{purpose.description}}</p>
      </div>
      <button class="content-source-restore" type="button" data-action="restore-defaults" title="{{localize "GUM.ContentSources.Actions.RestoreDefaultsHint"}}">
        <i class="fas fa-undo" aria-hidden="true"></i><span>{{localize "GUM.ContentSources.Actions.RestoreDefaults"}}</span>
      </button>
    </header>

    {{#if purpose.hybridScopeOptions}}
    <div class="content-source-hybrid-scope">
      <label for="gum-hybrid-item-match-scope">{{localize "GUM.ContentSources.HybridScope.Label"}}</label>
      <select id="gum-hybrid-item-match-scope" name="hybridItemMatchScope">
        {{#each purpose.hybridScopeOptions as |option|}}
        <option value="{{option.value}}" data-hint="{{option.hint}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
        {{/each}}
      </select>
      {{#each purpose.hybridScopeOptions as |option|}}
        {{#if option.selected}}<p class="notes"><i class="fas fa-circle-info"></i> <span data-hybrid-scope-hint>{{option.hint}}</span></p>{{/if}}
      {{/each}}
    </div>
    {{/if}}

    <input type="hidden" name="{{purpose.id}}Sources" value='{{purpose.sourceIdsJson}}'>
    <ol class="content-source-list">
      {{#each purpose.sources as |source|}}
      <li data-source-id="{{source.id}}" class="{{#if source.missing}}is-missing{{/if}}">
        <span class="source-order">{{source.order}}</span>
        <span class="source-details">
          <strong>{{source.label}}</strong>
          <small>{{source.id}}</small>
        </span>
        <span class="source-status">
          {{#if source.missing}}<i class="fas fa-exclamation-triangle"></i> {{localize "GUM.ContentSources.Status.Missing"}}{{else}}<i class="fas fa-check-circle"></i> {{localize "GUM.ContentSources.Status.Available"}}{{/if}}
        </span>
        <span class="source-actions">
          <button type="button" data-action="move-source-up" title="{{localize "GUM.ContentSources.Actions.MoveUp"}}" {{#unless source.canMoveUp}}disabled{{/unless}}><i class="fas fa-arrow-up"></i></button>
          <button type="button" data-action="move-source-down" title="{{localize "GUM.ContentSources.Actions.MoveDown"}}" {{#unless source.canMoveDown}}disabled{{/unless}}><i class="fas fa-arrow-down"></i></button>
          <button type="button" data-action="remove-source" title="{{localize "GUM.ContentSources.Actions.Remove"}}"><i class="fas fa-trash"></i></button>
        </span>
      </li>
      {{else}}
      <li class="empty-source-list">{{localize "GUM.ContentSources.Empty"}}</li>
      {{/each}}
    </ol>

    <div class="content-source-add">
      <select name="available-source">
        {{#each ../itemPacks as |pack|}}<option value="{{pack.id}}">{{pack.label}} — {{pack.id}}</option>{{/each}}
      </select>
      <button class="content-source-add-button" type="button" data-action="add-source"><i class="fas fa-plus"></i> {{localize "GUM.ContentSources.Actions.Add"}}</button>
    </div>
  </section>
  {{/each}}
  </div>

  <footer class="sheet-footer content-source-footer flexrow">
    <button type="submit"><i class="fas fa-save"></i> {{localize "GUM.ContentSources.Actions.Save"}}</button>
  </footer>
</form>
