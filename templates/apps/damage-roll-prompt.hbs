<form class="gum-damage-roll-prompt premium" autocomplete="off">
  <header class="damage-prompt-header">
    <div class="header-kicker">Rolagem de Dano</div>
    <h2>{{sourceName}}</h2>
    {{#if ammunition}}<div class="damage-prompt-ammunition">{{localize "GUM.Equipment.Ammunition.Label"}}: {{ammunition.name}} <span>×{{ammunition.spent}}</span></div>{{/if}}
    {{#if rapidFire}}<div class="damage-prompt-ammunition"><i class="fas fa-bullseye" aria-hidden="true"></i> {{localize "GUM.RapidFire.ShotsFired"}}: {{rapidFire.shotsFired}} · {{localize "GUM.RapidFire.Recoil"}}: {{rapidFire.recoil}} · {{localize "GUM.RapidFire.HitsBeforeDefense" hits=rapidFire.hits}}</div>{{/if}}
  </header>

  <section class="damage-visual-box">
    {{#each visualCards as |card|}}
      <div class="damage-visual-card tone-{{card.tone}}">
        <div class="damage-card-title">{{localize card.labelKey}}</div>
        <div class="damage-card-field damage-card-formula"><span>{{localize "GUM.Damage.Formula"}}</span><strong>{{card.formula}}</strong></div>
        <div class="damage-card-meta">{{card.details}}</div>
      </div>
    {{/each}}
  </section>
  <section class="damage-modifier-section">
    <datalist id="gum-damage-natures">
      {{#each natureOptions}}<option value="{{this.value}}" label="{{this.label}}"></option>{{/each}}
    </datalist>
    <h4>Modificadores de Dano Situacionais</h4>

    <div class="damage-column-headings" aria-hidden="true">
      <span></span>
      <span>{{localize "GUM.Damage.Formula"}}</span>
      <span>{{localize "GUM.Damage.Type"}}</span>
      <span>{{localize "GUM.Damage.FieldNature"}}</span>
      <span>{{localize "GUM.Damage.Divisor"}}</span>
    </div>

    <div class="damage-row">
      <label>Dano Padrão</label>
      <input type="text" name="mainAdditional" data-formula-input="true" placeholder="Ex: 2d6+3" />
            <input type="text" value="{{main.type}}" disabled />
      <input type="text" name="mainNature" value="{{main.natureDisplay}}" list="gum-damage-natures" placeholder="Natureza (opcional)" />
      <input type="number" name="mainArmorDivisor" data-armor-divisor="true" value="{{main.armorDivisor}}" min="0.1" step="0.1" title="Divisor de armadura" aria-label="Divisor de armadura" />
    </div>

    <div class="damage-row">
      <label>Dano de Acompanhamento</label>
      <input type="text" name="followUpAdditional" data-formula-input="true" placeholder="Ex: 1d6" />
      {{#if followUpTypeLocked}}
        <input type="text" value="{{followUp.type}}" disabled />
      {{else}}
        <input type="text" name="followUpType" data-type-input="true" placeholder="Tipo..." />
            {{/if}}
      <input type="text" name="followUpNature" value="{{followUp.natureDisplay}}" list="gum-damage-natures" placeholder="Natureza (opcional)" />
      <input type="number" name="followUpArmorDivisor" data-armor-divisor="true" value="{{followUp.armorDivisor}}" min="0.1" step="0.1" title="Divisor de armadura" aria-label="Divisor de armadura" />
    </div>

    <div class="damage-row">
      <label>Dano de Fragmentação</label>
      <input type="text" name="fragmentationAdditional" data-formula-input="true" placeholder="Ex: 1d6+1" />
      {{#if fragmentationTypeLocked}}
        <input type="text" value="{{fragmentation.type}}" disabled />
      {{else}}
        <input type="text" name="fragmentationType" data-type-input="true" placeholder="Tipo..." />
            {{/if}}
      <input type="text" name="fragmentationNature" value="{{fragmentation.natureDisplay}}" list="gum-damage-natures" placeholder="Natureza (opcional)" />
      <input type="number" name="fragmentationArmorDivisor" data-armor-divisor="true" value="{{fragmentation.armorDivisor}}" min="0.1" step="0.1" title="Divisor de armadura" aria-label="Divisor de armadura" />
    </div>
  </section>

  <footer class="damage-prompt-actions">
    <div class="roll-privacy-row">
      <span class="roll-privacy-label"><i class="fas fa-lock"></i> {{localize "GUM.RollPrivacy.Label"}}</span>
      <div class="roll-privacy-selector" role="group" aria-label="{{localize 'GUM.RollPrivacy.Label'}}">
        {{#each rollPrivacyOptions}}
        <button type="button" class="roll-privacy-btn {{#if this.selected}}active{{/if}}" data-roll-mode="{{this.mode}}" title="{{this.label}}" aria-label="{{this.label}}" aria-pressed="{{#if this.selected}}true{{else}}false{{/if}}"><i class="fas {{this.icon}}"></i></button>
        {{/each}}
      </div>
    </div>
    <button type="submit"><i class="fas fa-dice"></i> Rolar Dano</button>
    <button type="button" data-action="cancel">Cancelar</button>
  </footer>
</form>
