<form class="gum-roll-prompt two-column-layout {{#if menuCollapsed}}modifiers-collapsed{{/if}}" autocomplete="off">

    {{!-- COLUNA DA ESQUERDA: MENU DE OPÇÕES (SCROLL) --}}
    <div class="prompt-menu-column">
        <section class="roll-purpose-panel" aria-labelledby="roll-purpose-heading">
            <div class="purpose-heading-row">
                <h3 id="roll-purpose-heading" class="column-header">Finalidades do Teste</h3>
                <div class="purpose-search" role="search" aria-label="Buscar finalidades">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="search" class="purpose-search-input" value="{{purposeSearchQuery}}"
                           placeholder="Buscar finalidade" autocomplete="off">
                    <button type="button" class="purpose-search-clear {{#if purposeSearchActive}}visible{{/if}}"
                            aria-label="Limpar busca" title="Limpar busca" {{#unless purposeSearchActive}}disabled{{/unless}}>
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>
                <button type="button" class="purpose-context-filter {{#if contextualPurposeFilterActive}}active{{/if}}"
                        aria-pressed="{{#if contextualPurposeFilterActive}}true{{else}}false{{/if}}"
                        aria-label="Mostra finalidades relacionadas ao personagem, solicitadas pelo mestre ou já selecionadas nesta rolagem."
                        title="Contextuais — Mostra finalidades relacionadas ao personagem, solicitadas pelo mestre ou já selecionadas nesta rolagem.">
                    <i class="fas fa-filter" aria-hidden="true"></i><span class="purpose-context-count">{{contextualPurposeCount}}</span>
                </button>
                <button type="button" class="purpose-general {{#unless hasPurposes}}active{{/unless}}"
                        data-purpose-id="general"
                        aria-pressed="{{#if hasPurposes}}false{{else}}true{{/if}}">
                    <span>Teste Geral</span>
                    <i class="fas fa-check" aria-hidden="true"></i>
                </button>
            </div>
            {{#each purposeGroups as |group|}}
            <details class="option-group purpose-group" data-group-id="{{group.id}}" {{#if group.isOpen}}open{{/if}}>
                <summary class="group-summary purpose-group-summary">
                    <span class="summary-title">{{group.label}}</span>
                    <i class="fas fa-chevron-down" aria-hidden="true"></i>
                </summary>
                <div class="group-content">
                    <div class="purpose-buttons">
                        {{#each group.purposes as |purpose|}}
                         <div class="purpose-item-wrapper {{#if purpose.selected}}active{{/if}} {{#if purpose.suggested}}suggested{{/if}} {{#if purpose.requested}}requested{{/if}}">
                            <button type="button" class="purpose-btn {{#if purpose.selected}}active{{/if}}"
                                    data-purpose-id="{{purpose.id}}"
                                    aria-pressed="{{#if purpose.selected}}true{{else}}false{{/if}}"
                                    title="{{purpose.tooltip}}">
                                <span class="purpose-card-copy">
                                    <span class="purpose-card-label">{{purpose.label}}</span>
                                    {{#if purpose.requested}}<span class="purpose-requested" title="Solicitada pelo mestre"><i class="fas fa-shield-alt" aria-hidden="true"></i> Solicitada pelo mestre</span>{{/if}}
                                    {{#if purpose.suggested}}<span class="purpose-card-hint">Atributo usual</span>{{/if}}
                                </span>
                                <span class="purpose-check" aria-hidden="true"><i class="fas fa-check"></i></span>
                            </button>
                           <span class="purpose-view" role="button" tabindex="0" data-purpose-id="{{purpose.id}}"
                                  title="Ver informações sobre {{purpose.label}}" aria-label="Ver informações sobre {{purpose.label}}">
                                <i class="fas fa-info-circle" aria-hidden="true"></i>
                            </span>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </details>
             {{/each}}
            <p class="purpose-search-empty" style="display: none;">Nenhuma finalidade encontrada.</p>
            <p class="purpose-context-empty" style="display: none;">Nenhuma finalidade contextual disponível. Use a busca ou mostre todas as finalidades. <button type="button" class="purpose-context-show-all">Mostrar todas</button></p>
        </section>
        <h3 class="column-header modifiers-heading">Modificadores</h3>
        {{#if ammunitionOptions.length}}
        <div class="option-group" style="padding: 0.6rem">
            <label for="gum-ammunition-choice">{{localize "GUM.Equipment.Ammunition.Label"}}</label>
            <select id="gum-ammunition-choice" name="ammunitionId">
                <option value="" {{#unless ammunitionId}}selected{{/unless}}>{{localize "GUM.Equipment.Ammunition.StandardShort"}}</option>
                {{#each ammunitionOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} (×{{quantity}})</option>{{/each}}
            </select>
            <small class="ammunition-modifier-summary">{{ammunitionModifierSummary}}</small>
        </div>
        {{/if}}
        
        <div class="roll-blocks-container">
            {{#each blocks as |block|}}
            <details class="option-group">
                <summary class="group-summary" style="border-left-color: {{block.color}};">
                    <span class="summary-title">{{block.title}}</span>
                    <i class="fas fa-chevron-down"></i>
                </summary>
                <div class="group-content">
                    <div class="block-buttons">
                    {{#each block.items as |btn|}}
                        <div class="mod-item-wrapper">
                            {{!-- Botão de Seleção (Principal) --}}
                            <button type="button" class="mod-btn {{#if btn.active}}active{{/if}}" 
                                    data-id="{{btn.id}}" 
                                    data-value="{{btn.value}}" 
                                    data-label="{{btn.label}}" 
                                    data-cap="{{btn.nh_cap}}">
                                <span class="btn-label">{{btn.label}}</span>
                                <span class="btn-value">{{#if (gt btn.value 0)}}+{{/if}}{{btn.value}}</span>
                            </button>

                            {{!-- Botão de Informação (Separado) --}}
                            <div class="mod-view" data-desc="{{btn.desc}}" data-title="{{btn.label}}" data-value="{{btn.value}}" data-cap="{{btn.nh_cap}}" data-duration="{{btn.duration}}">
                                <i class="fas fa-info-circle"></i>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </details>
            {{/each}}
        </div>
    </div>

    {{!-- COLUNA DA DIREITA: COMANDA / DASHBOARD (FIXO) --}}
    <div class="prompt-command-column">

        {{!-- 1. CABEÇALHO (Compacto) --}}
        <div class="command-header">
            <button type="button" class="menu-toggle-btn" title="Mostrar/Ocultar opções de rolagem" aria-label="Mostrar ou ocultar opções de rolagem" aria-expanded="{{#if menuCollapsed}}false{{else}}true{{/if}}">
                <i class="fas fa-bars"></i>
            </button>
            <div class="roll-icon-small">
                {{#if img}}<img src="{{img}}">{{else}}<i class="fas fa-dice-d20"></i>{{/if}}
            </div>
            <div class="roll-info-compact">
                <h2 class="roll-title-compact">{{actor.name}}</h2>
                <div class="roll-subtitle">{{label}}</div>
            </div>
        </div>

        <div class="purpose-summary" aria-live="polite">
            <strong>Finalidades:</strong>
            {{#if hasPurposes}}{{#each purposeLabels as |purpose|}}<span>{{purpose}}</span>{{/each}}{{else}}<em>Teste Geral</em>{{/if}}
        </div>

        {{!-- 2. ATRIBUTO BASE (SELETOR) --}}
        <div class="base-attribute-panel">
            <label class="section-label">Atributo Base</label>
            <div class="base-attribute-row base-attribute-row--primary">
                {{#each baseAttributePrimary as |option|}}
                <button type="button" class="base-attr-btn {{#if option.isSelected}}active{{/if}}"
                        data-key="{{option.key}}"
                        data-label="{{option.label}}"
                        data-value="{{option.value}}"
                        data-type="{{option.type}}">
                    {{option.label}}
                </button>
                {{/each}}
            </div>
            <div class="base-attribute-row base-attribute-row--secondary">
                {{#each baseAttributeSecondary as |option|}}
                <button type="button" class="base-attr-btn {{#if option.isSelected}}active{{/if}}"
                        data-key="{{option.key}}"
                        data-label="{{option.label}}"
                        data-value="{{option.value}}"
                        data-type="{{option.type}}">
                    {{option.label}}
                </button>
                {{/each}}
            </div>
        </div>

        {{!-- 2. NH BASE (Destaque) --}}
        <div class="base-value-box">
            <span class="label">NH Base (<span class="base-attr-label">{{baseAttributeLabel}}</span>)</span>
            <span class="value">{{baseValue}}</span>
        </div>


        {{!-- 3. MODIFICADOR MANUAL --}}
        <div class="manual-mod-panel compact">
            <div class="mod-controls-row">
                <button type="button" class="step-btn" data-action="decrease" {{#if lockInitialModifier}}disabled{{/if}}><i class="fas fa-minus"></i></button>
                <div class="manual-input-wrapper">
                    <label>{{manualLabel}}</label>
                    <input style="color:rgba(255, 255, 255, 0.747);" type="number" name="manualMod" value="{{initialManualMod}}" class="manual-input" {{#if lockInitialModifier}}readonly{{/if}}/>
                </div>
                <button type="button" class="step-btn" data-action="increase" {{#if lockInitialModifier}}disabled{{/if}}><i class="fas fa-plus"></i></button>
            </div>
            <div class="presets-row">
                <button type="button" class="quick-btn" data-value="-6" {{#if lockInitialModifier}}disabled{{/if}}>-6</button>
                <button type="button" class="quick-btn" data-value="-4" {{#if lockInitialModifier}}disabled{{/if}}>-4</button>
                <button type="button" class="quick-btn" data-value="-2" {{#if lockInitialModifier}}disabled{{/if}}>-2</button>
                <button type="button" class="quick-btn" data-value="2" {{#if lockInitialModifier}}disabled{{/if}}>+2</button>
                <button type="button" class="quick-btn" data-value="4" {{#if lockInitialModifier}}disabled{{/if}}>+4</button>
                <button type="button" class="quick-btn" data-value="6" {{#if lockInitialModifier}}disabled{{/if}}>+6</button>
            </div>
        </div>

        {{!-- 4. MODO DE ROLAGEM DEFENSIVA --}}
        <div class="defense-mode-panel">
            <label class="section-label">Modo de Rolagem</label>
            <div class="defense-mode-options">
                <button type="button" class="defense-mode-btn active" data-defense-mode="normal">Normal</button>
                <button type="button" class="defense-mode-btn" data-defense-mode="defense_standard">Defesa Padrão</button>
                <button type="button" class="defense-mode-btn" data-defense-mode="defense_simple">Defesa Simples</button>
            </div>
            <div class="defense-timing-panel" style="display:none;">
                <label class="section-label section-label--sub">Aplicação dos Modificadores</label>
                <div class="defense-mode-options defense-mode-options--timing">
                    <button type="button" class="defense-timing-btn active" data-defense-timing="before">Antes da conversão</button>
                    <button type="button" class="defense-timing-btn" data-defense-timing="after">Depois da conversão</button>
                </div>
            </div>
        </div>

        {{!-- 5. PILHA DE ATIVOS (Stack) --}}
        <div class="active-mods-container">
            <label class="section-label">Ativos</label>
            <div class="active-mods-list">
                {{!-- O JS vai injetar as tags aqui --}}
                <span class="empty-stack-msg">...</span>
            </div>
        </div>

        {{!-- 5. RODAPÉ DE AÇÃO (Fixo no fundo da coluna direita) --}}
        <div class="command-footer">
<div class="calc-display">
            <div class="calc-row final">
                <span class="calc-label">NH FINAL</span>
                {{!-- Adicionamos classes para riscar se tiver cap --}}
                <span class="calc-val final-val">{{baseValue}}</span>
            </div>
            
            {{!-- LINHA DE DETALHE --}}
            <div class="calc-row detail">
                <span class="detail-text"><span class="base-summary">Base {{baseValue}}</span> <span class="total-mod-val">+0</span></span>
            </div>

            {{!-- LINHA DE TETO (CAP) --}}
            {{!-- Escondida por padrão, o JS vai mostrar --}}
            <div class="cap-info-row" style="display:none;">
                <span class="cap-label"><i class="fas fa-arrow-down"></i> Teto Máximo:</span>
                <span class="cap-val">--</span>
            </div>
        </div>

            <div class="roll-submit-row">
                <div class="roll-privacy-selector" role="group" aria-label="{{localize 'GUM.RollPrivacy.Label'}}">
                    {{#each rollPrivacyOptions}}
                    <button type="button" class="roll-privacy-btn {{#if this.selected}}active{{/if}}" data-roll-mode="{{this.mode}}" title="{{this.label}}" aria-label="{{this.label}}" aria-pressed="{{#if this.selected}}true{{else}}false{{/if}}"><i class="fas {{this.icon}}"></i></button>
                    {{/each}}
                </div>
                <button type="submit" class="roll-big-btn">
                    <i class="fas fa-dice"></i> ROLAR
                </button>
            </div>
        </div>

    </div>
</form>
