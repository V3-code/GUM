<div class="gm-screen-layout">
    
{{!-- COLUNA ESQUERDA: MONITOR DE ALVOS --}}
<aside class="screen-sidebar monitor-column">
        <nav class="gum-monitor-tabs monitor-tabs tabs" data-group="monitor" aria-label="{{localize 'GUM.GMScreen.TargetNavigation'}}">
            <a class="item" data-tab="characters"><i class="fas fa-users"></i> {{localize "GUM.GMScreen.Characters"}}</a>
            <a class="item" data-tab="combat"><i class="fas fa-swords"></i> {{localize "GUM.GMScreen.Combat"}}</a>
        </nav>

        {{!-- CONTEÚDO --}}
        <section class="monitor-body">
            
            {{!-- ABA PJs --}}
            <div class="tab" data-tab="characters">
                <div class="monitor-list">
                    {{#each actors}}
                        {{> monitorCard actor=this}}
                    {{/each}}
                </div>
            </div>

            {{!-- ABA COMBATE --}}
            <div class="tab" data-tab="combat">
                <div class="monitor-list">
                    {{#if hasCombat}}
                        {{#each combatants}}
                            {{> monitorCard actor=this}}
                        {{/each}}
                    {{else}}
                        <div class="placeholder-text gm-monitor-empty">
                            <p>{{localize "GUM.GMScreen.NoActiveCombat"}}</p>
                        </div>
                    {{/if}}
                </div>


            </div>   
        </section>
        <section class="gm-sidebar-actions">
            {{#if hasCombat}}
            <div class="combat-controls">
                <button type="button" class="combat-btn prev-turn" title="{{localize 'GUM.GMScreen.PreviousTurn'}}" aria-label="{{localize 'GUM.GMScreen.PreviousTurn'}}" {{#if layoutEditMode}}disabled{{/if}}><i class="fas fa-backward"></i></button>
                <button type="button" class="combat-btn end-combat" title="{{localize 'GUM.GMScreen.EndCombat'}}" aria-label="{{localize 'GUM.GMScreen.EndCombat'}}" {{#if layoutEditMode}}disabled{{/if}}><i class="fas fa-stop"></i></button>
                <button type="button" class="combat-btn next-turn" title="{{localize 'GUM.GMScreen.NextTurn'}}" aria-label="{{localize 'GUM.GMScreen.NextTurn'}}" {{#if layoutEditMode}}disabled{{/if}}><i class="fas fa-forward"></i></button>
            </div>
            {{/if}}
            <button type="button" class="gm-request-test" {{#if layoutEditMode}}disabled{{/if}}><i class="fas fa-dice"></i> {{localize "GUM.GMScreen.RequestTest"}}</button>
        </section>

    </aside>

    {{!-- COLUNA DIREITA: DASHBOARD (LIMPA) --}}
    <section class="screen-main controls-column">
        
        <header class="gm-main-toolbar">
            <div class="search-wrapper">
                <i class="fas fa-search"></i>
                <input type="search" class="mod-search" value="{{searchQuery}}" placeholder="{{localize 'GUM.GMScreen.Filter'}}" autocomplete="off" aria-label="{{localize 'GUM.GMScreen.FilterModifiers'}}">
            </div>
            <div class="gm-selection-summary" title="{{localize 'GUM.GMScreen.SelectionSummaryTitle'}}">
                <i class="fas fa-layer-group"></i>
                <span>{{selectionCount}}</span>
                <strong>{{selectionTotalText}}</strong>
            </div>
            <button type="button" class="clear-selection-btn" title="{{localize 'GUM.GMScreen.ClearSelection'}}" aria-label="{{localize 'GUM.GMScreen.ClearSelection'}}" {{#if layoutEditMode}}disabled{{else}}{{#unless selectionCount}}disabled{{/unless}}{{/if}}>
                <i class="fas fa-eraser"></i>
            </button>
            <button type="button" class="layout-edit-toggle {{#if layoutEditMode}}is-active{{/if}}" title="{{#if layoutEditMode}}{{localize 'GUM.GMScreen.FinishLayoutEditing'}}{{else}}{{localize 'GUM.GMScreen.EditLayout'}}{{/if}}" aria-pressed="{{#if layoutEditMode}}true{{else}}false{{/if}}">
                <i class="fas {{#if layoutEditMode}}fa-check{{else}}fa-lock{{/if}}"></i><span class="toolbar-action-label">{{#if layoutEditMode}}{{localize "GUM.GMScreen.Finish"}}{{else}}{{localize "GUM.GMScreen.EditLayout"}}{{/if}}</span>
            </button>
            {{#if layoutEditMode}}<button type="button" class="add-group-btn" title="{{localize 'GUM.GMScreen.CreateGroup'}}">
                <i class="fas fa-plus"></i><span class="toolbar-action-label">{{localize "GUM.GMScreen.Group"}}</span>
            </button>
            <button type="button" class="bulk-clear-layout-btn" title="{{localize 'GUM.GMScreen.BulkClearTitle'}}" aria-label="{{localize 'GUM.GMScreen.BulkClearTitle'}}">
                <i class="fas fa-trash-can"></i>
            </button>{{/if}}
        </header>
        <nav class="main-tab-selector gm-workspace-tabs" aria-label="{{localize 'GUM.GMScreen.Workspaces'}}">
            {{#each mainTabs}}
                <span class="gm-workspace-tab">
                    <button type="button" class="main-tab-btn {{#if (eq this.id ../activeMainTab)}}active{{/if}}" data-tab-id="{{this.id}}" title="{{localize 'GUM.GMScreen.WorkspaceTitle' name=this.name}}" {{#if (eq this.id ../activeMainTab)}}aria-current="page"{{/if}}>
                        <span>{{this.name}}</span>{{#if this.selectedCount}}<small>{{this.selectedCount}}</small>{{/if}}
                    </button>
                    {{#if ../layoutEditMode}}<button type="button" class="rename-main-tab-btn" data-tab-id="{{this.id}}" data-tab-name="{{this.name}}" title="{{localize 'GUM.GMScreen.RenameWorkspace'}}" aria-label="{{localize 'GUM.GMScreen.RenameWorkspace'}}"><i class="fas fa-pen"></i></button>{{/if}}
                </span>
            {{/each}}
        </nav>
        {{#if layoutEditMode}}<div class="layout-editor-banner"><i class="fas fa-pen-ruler"></i> {{localize "GUM.GMScreen.LayoutEditingActive"}}</div>{{/if}}
        <section class="screen-body">
            <div class="tab modifiers-dashboard">
                <div class="modular-grid">
                    {{#if groups.length}}
                        {{#each groups as |group|}}
                        <div class="modifier-group {{#if group.collapsed}}is-collapsed{{/if}}" data-group-id="{{group.id}}">
                            <div class="group-header">
                                {{#if @root.layoutEditMode}}<button type="button" class="layout-drag-handle group-drag-handle" draggable="true" title="{{localize 'GUM.GMScreen.DragGroup'}}" aria-label="{{localize 'GUM.GMScreen.DragGroup'}}"><i class="fas fa-grip-vertical"></i></button>{{/if}}
                                <button type="button" class="group-collapse-toggle" data-group-id="{{group.id}}" title="{{localize 'GUM.GMScreen.ToggleGroup'}}" aria-expanded="{{#unless group.collapsed}}true{{else}}false{{/unless}}">
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                                <span class="group-title" title="{{group.name}}">{{group.name}}</span>
                                <span class="group-item-count" title="{{localize 'GUM.GMScreen.GroupItemCount'}}">{{group.itemCount}}{{#if group.selectedCount}} · <strong>{{group.selectedCount}}</strong>{{/if}}{{#if group.unavailableItemCount}} · <i class="fas fa-triangle-exclamation"></i> {{group.unavailableItemCount}}{{/if}}</span>
                                {{#if @root.layoutEditMode}}
                                <div class="group-actions">
                                    <button type="button" class="group-menu-trigger" data-group-id="{{group.id}}" title="{{localize 'GUM.GMScreen.GroupOptions'}}" aria-label="{{localize 'GUM.GMScreen.GroupOptions'}}" aria-expanded="false">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="group-actions-menu" data-group-id="{{group.id}}">
                                        <a class="add-mod-to-group-btn" role="button" tabindex="0" data-group-id="{{group.id}}"><i class="fas fa-search-plus"></i> {{localize "GUM.GMScreen.AddModifier"}}</a>
                                        <a class="add-effect-to-group-btn" role="button" tabindex="0" data-group-id="{{group.id}}"><i class="fas fa-sparkles"></i> {{localize "GUM.GMScreen.AddEffect"}}</a>
                                        <a class="add-macro-to-group-btn" role="button" tabindex="0" data-group-id="{{group.id}}"><i class="fas fa-code"></i> {{localize "GUM.GMScreen.AddMacro"}}</a>
                                        <a class="move-group-btn" role="button" tabindex="0" data-group-id="{{group.id}}" data-offset="-1"><i class="fas fa-arrow-up"></i> {{localize "GUM.GMScreen.MoveEarlier"}}</a>
                                        <a class="move-group-btn" role="button" tabindex="0" data-group-id="{{group.id}}" data-offset="1"><i class="fas fa-arrow-down"></i> {{localize "GUM.GMScreen.MoveLater"}}</a>
                                        <a class="toggle-group-sort-btn" role="button" tabindex="0" data-group-id="{{group.id}}"><i class="fas {{#if group.isManualOrder}}fa-arrow-down-a-z{{else}}fa-hand-pointer{{/if}}"></i> {{#if group.isManualOrder}}{{localize "GUM.GMScreen.UseAutomaticOrder"}}{{else}}{{localize "GUM.GMScreen.UseManualOrder"}}{{/if}}</a>
                                        <a class="edit-group-name-btn" role="button" tabindex="0" data-group-id="{{group.id}}" data-group-name="{{group.name}}"><i class="fas fa-pen"></i> {{localize "GUM.GMScreen.RenameGroup"}}</a>
                                        <a class="delete-group-btn" role="button" tabindex="0" data-group-id="{{group.id}}"><i class="fas fa-trash"></i> {{localize "GUM.GMScreen.DeleteGroup"}}</a>
                                    </div>
                                </div>
                                {{/if}}
                            </div>
                            <div class="group-content-area">
                                {{#each group.enrichedItems}}
                                <div class="palette-mod {{#if this.isMacro}}is-macro{{/if}} {{#if this.isSelected}}active{{/if}}" role="button" tabindex="0" aria-pressed="{{#if this.isSelected}}true{{else}}false{{/if}}" data-uuid="{{this.uuid}}" data-document-name="{{this.documentName}}" data-item-type="{{this.type}}" data-value="{{this.system.modifier}}" data-cap="{{this.system.nh_cap}}">
                                    <div class="mod-left">
                                        {{#if @root.layoutEditMode}}<button type="button" class="layout-drag-handle item-drag-handle" draggable="true" title="{{localize 'GUM.GMScreen.DragItem'}}" aria-label="{{localize 'GUM.GMScreen.DragItem'}}"><i class="fas fa-grip-vertical"></i></button>{{/if}}
                                        <img src="{{this.img}}" class="mod-icon"/>
                                        <span class="mod-name">{{this.name}}</span>
                                    </div>
                                    <div class="mod-right">
                                        {{#if (eq this.type "gm_modifier")}}
                                            <span class="mod-val {{#if this.modifierIsNegative}}neg{{/if}} {{#if this.modifierIsExpression}}is-expression{{/if}}" title="{{this.modifierDisplay}}">
                                                {{this.modifierCompactDisplay}}
                                            </span>
                                        {{/if}}
                                        {{#if (eq this.type "effect")}}
                                            <span class="mod-val">EF</span>
                                        {{/if}}
                                        {{#if this.isMacro}}
                                            {{#if @root.layoutEditMode}}
                                            <select class="macro-execution-mode" aria-label="{{localize 'GUM.GMScreen.MacroExecutionMode'}}">
                                                <option value="standard" {{#if (eq this.macroExecutionMode "standard")}}selected{{/if}}>{{localize "GUM.GMScreen.MacroMode.standard"}}</option>
                                                <option value="single-target" {{#if (eq this.macroExecutionMode "single-target")}}selected{{/if}}>{{localize "GUM.GMScreen.MacroMode.single-target"}}</option>
                                                <option value="each-target" {{#if (eq this.macroExecutionMode "each-target")}}selected{{/if}}>{{localize "GUM.GMScreen.MacroMode.each-target"}}</option>
                                            </select>
                                            {{else}}
                                            <span class="macro-context-icon" title="{{this.macroExecutionLabel}}" aria-label="{{this.macroExecutionLabel}}"><i class="fas {{this.macroExecutionIcon}}"></i></span>
                                            <button type="button" class="macro-run-btn {{#if this.macroRunning}}is-running{{/if}}" title="{{localize 'GUM.GMScreen.ExecuteMacro'}}" aria-label="{{localize 'GUM.GMScreen.ExecuteMacro'}}" {{#unless this.canExecute}}disabled{{/unless}} {{#if this.macroRunning}}disabled{{/if}}><i class="fas {{#if this.macroRunning}}fa-spinner fa-spin{{else}}fa-play{{/if}}"></i></button>
                                            {{/if}}
                                        {{/if}}
                                        <div class="mod-hover-controls">
                                            {{#if this.isMacro}}<a class="macro-open-btn" role="button" tabindex="0" aria-label="{{localize 'GUM.GMScreen.OpenMacro'}}"><i class="fas fa-pen"></i></a>{{else}}<a class="mod-quick-view" role="button" tabindex="0" aria-label="{{localize 'GUM.GMScreen.QuickView'}}"><i class="fas fa-eye"></i></a>{{/if}}
                                            {{#if @root.layoutEditMode}}<a class="move-item-btn" role="button" tabindex="0" data-offset="-1" aria-label="{{localize 'GUM.GMScreen.MoveEarlier'}}"><i class="fas fa-arrow-up"></i></a>
                                            <a class="move-item-btn" role="button" tabindex="0" data-offset="1" aria-label="{{localize 'GUM.GMScreen.MoveLater'}}"><i class="fas fa-arrow-down"></i></a>
                                            <a class="delete-mod-btn" role="button" tabindex="0" aria-label="{{localize 'GUM.GMScreen.RemoveFromGroup'}}"><i class="fas fa-times"></i></a>{{/if}}
                                        </div>
                                    </div>
                                </div>
                                {{/each}}
                                {{#unless group.enrichedItems}}<div class="empty-group-hint">{{localize "GUM.GMScreen.Empty"}}</div>{{/unless}}
                            </div>
                        </div>
                        {{/each}}
                    {{else}}
                        <div class="empty-group-hint">{{localize "GUM.GMScreen.NoGroups"}}</div>
                    {{/if}}
                </div>
            </div>
        </section>

        <footer class="gm-utility-dock {{#if utilityPanel}}has-open-panel{{/if}}">
            <div class="gm-utility-content {{#if quickRollOpen}}is-open{{/if}}" data-utility-content="quick-roll">
                <div class="quick-rollers">
                    <div class="roller-section test-section">
                        <div class="roller-row">
                            <span class="roller-label">{{localize "GUM.GMScreen.SkillLevelShort"}}</span>
                            <input type="number" class="qr-nh" placeholder="10" value="{{quickRollCache.nh}}" title="{{localize 'GUM.GMScreen.BaseSkillLevel'}}">
                            <div class="qr-mod-display" title="{{localize 'GUM.GMScreen.ActiveModifierTotal'}}">+0</div>
                            <button type="button" class="qr-toggle-mode {{#if quickRollCache.private}}active{{/if}}" title="{{#if quickRollCache.private}}{{localize 'GUM.GMScreen.PrivateMode'}}{{else}}{{localize 'GUM.GMScreen.PublicMode'}}{{/if}}" aria-label="{{#if quickRollCache.private}}{{localize 'GUM.GMScreen.PrivateMode'}}{{else}}{{localize 'GUM.GMScreen.PublicMode'}}{{/if}}"><i class="fas {{#if quickRollCache.private}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></button>
                            <button type="button" class="qr-btn roll-test" title="{{localize 'GUM.GMScreen.RollTest'}}" aria-label="{{localize 'GUM.GMScreen.RollTest'}}"><i class="fas fa-dice"></i></button>
                        </div>
                        <div class="qr-result-display" style="display:none;"></div>
                    </div>
                    <div class="roller-section damage-section">
                        <div class="roller-row">
                            <span class="roller-label"><i class="fas fa-skull"></i></span>
                            <input type="text" class="qr-formula" placeholder="{{localize 'GUM.GMScreen.DamagePlaceholder'}}" value="{{quickRollCache.formula}}">
                            <input type="text" class="qr-type" placeholder="{{localize 'GUM.GMScreen.DamageTypePlaceholder'}}" value="{{quickRollCache.type}}">
                            <button type="button" class="qr-btn roll-damage" title="{{localize 'GUM.GMScreen.RollDamage'}}" aria-label="{{localize 'GUM.GMScreen.RollDamage'}}"><i class="fas fa-bolt"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="gm-utility-content {{#if manualOpen}}is-open{{/if}}" data-utility-content="manual-modifier">
                <div class="manual-mod-toolbar {{#if isManualActive}}active{{/if}}">
                    <input type="text" class="manual-name" placeholder="{{localize 'GUM.GMScreen.Reason'}}" value="{{manualCache.name}}">
                    <div class="manual-row-middle">
                        <div class="value-controls">
                            <button type="button" class="step-btn" data-action="dec" aria-label="{{localize 'GUM.GMScreen.Decrease'}}"><i class="fas fa-minus"></i></button>
                            <input type="number" class="manual-value" value="{{manualCache.value}}" aria-label="{{localize 'GUM.GMScreen.ManualModifierValue'}}">
                            <button type="button" class="step-btn" data-action="inc" aria-label="{{localize 'GUM.GMScreen.Increase'}}"><i class="fas fa-plus"></i></button>
                        </div>
                        <button type="button" class="activate-manual-btn" title="{{localize 'GUM.GMScreen.ToggleManual'}}" aria-label="{{localize 'GUM.GMScreen.ToggleManual'}}" aria-pressed="{{#if isManualActive}}true{{else}}false{{/if}}"><i class="fas fa-crosshairs"></i></button>
                    </div>
                    <div class="manual-presets">
                        <button type="button" class="preset-btn" data-val="-4">-4</button>
                        <button type="button" class="preset-btn" data-val="-2">-2</button>
                        <button type="button" class="preset-btn" data-val="-1">-1</button>
                        <button type="button" class="preset-btn" data-val="1">+1</button>
                        <button type="button" class="preset-btn" data-val="2">+2</button>
                        <button type="button" class="preset-btn" data-val="4">+4</button>
                    </div>
                </div>
            </div>
            <div class="gm-utility-toggle-row">
                <button type="button" class="gm-utility-toggle {{#if quickRollOpen}}is-active{{/if}}" data-utility-panel="quick-roll" aria-expanded="{{#if quickRollOpen}}true{{else}}false{{/if}}" {{#if layoutEditMode}}disabled{{/if}}>
                    <i class="fas fa-dice"></i><span>{{localize "GUM.GMScreen.QuickRoll"}}</span><strong class="qr-dock-total">{{selectionTotalText}}</strong>
                </button>
                <button type="button" class="gm-utility-toggle {{#if manualOpen}}is-active{{/if}} {{#if isManualActive}}has-active-value{{/if}}" data-utility-panel="manual-modifier" aria-expanded="{{#if manualOpen}}true{{else}}false{{/if}}" {{#if layoutEditMode}}disabled{{/if}}>
                    <i class="fas fa-sliders-h"></i><span>{{localize "GUM.GMScreen.ManualModifier"}}</span><strong class="manual-dock-total">{{manualTotalText}}</strong>
                </button>
            </div>
        </footer>
    </section>
</div>

{{!-- PARTIAL ATUALIZADO: INICIATIVA DENTRO DO CARD --}}
{{#*inline "monitorCard"}}
<div class="monitor-card {{#if actor.isTurn}}active-turn{{/if}} {{#if actor.isTargeted}}is-gm-target{{/if}} {{#if actor.isDefeated}}defeated{{/if}} {{#if @root.layoutEditMode}}layout-edit-inert{{/if}}"
     role="button"
     tabindex="0"
     data-actor-id="{{actor.id}}"
     data-token-id="{{actor.tokenId}}"
     data-combatant-id="{{actor.combatantId}}"
     aria-disabled="{{#if @root.layoutEditMode}}true{{else}}false{{/if}}"
     title="{{localize 'GUM.GMScreen.ApplySelectionHint'}}">

    {{#if actor.isTargeted}}
        <span class="monitor-card-target-marker" role="img" aria-label="{{localize 'GUM.GMScreen.MasterTarget'}}" title="{{localize 'GUM.GMScreen.MasterTarget'}}">
            <i class="fas fa-crosshairs" aria-hidden="true"></i>
        </span>
    {{/if}}

    <div class="actor-identity">
        <div class="card-top">
            <img src="{{actor.img}}" alt="{{localize 'GUM.GMScreen.PortraitAlt' name=actor.name}}" />
            <div class="vital-bars">
                <div class="vital-row" title="{{localize 'GUM.GMScreen.HitPointsTitle' value=actor.hp.value max=actor.hp.max}}">
                    <span class="vital-label">{{localize "GUM.GMScreen.HitPointsShort"}}</span>
                    <div class="mini-bar hp"><div class="fill" style="width: {{actor.hp.percent}}%;"></div></div>
                    <span class="vital-value">{{actor.hp.value}}/{{actor.hp.max}}</span>
                </div>
                <div class="vital-row" title="{{localize 'GUM.GMScreen.FatiguePointsTitle' value=actor.fp.value max=actor.fp.max}}">
                    <span class="vital-label">{{localize "GUM.GMScreen.FatiguePointsShort"}}</span>
                    <div class="mini-bar fp"><div class="fill" style="width: {{actor.fp.percent}}%;"></div></div>
                    <span class="vital-value">{{actor.fp.value}}/{{actor.fp.max}}</span>
                </div>
            </div>
        </div>
        <div class="actor-name-row">
            <span class="actor-name">{{actor.name}}</span>
            {{#if actor.playerTargeters.length}}
                <span class="player-targeters" aria-label="{{localize 'GUM.GMScreen.PlayerTargets'}}">
                    {{#each actor.playerTargeters}}
                        <span class="player-target-dot" role="img" style="--gm-player-target-color: {{this.color}};" aria-label="{{localize 'GUM.GMScreen.PlayerTarget' name=this.name}}" title="{{localize 'GUM.GMScreen.PlayerTarget' name=this.name}}"></span>
                    {{/each}}
                </span>
            {{/if}}
        </div>
    </div>
    
    {{!-- LINHA DE DEFESAS + INICIATIVA --}}
    <div class="passive-defenses">
        {{!-- Só mostra iniciativa se existir (ou seja, se estiver na aba de combate) --}}
        {{#if actor.initiative}}
            <span class="def-tag init" title="{{localize 'GUM.GMScreen.Initiative'}}"><i class="fas fa-bolt"></i> {{actor.initiative}}</span>
            <span class="sep">|</span>
        {{/if}}
        
        <span class="def-tag" title="{{localize 'GUM.GMScreen.CurrentMove'}}"><i class="fas fa-shoe-prints"></i> {{actor.move}}</span>
        <span class="def-tag encumbrance-tag" title="{{localize 'GUM.GMScreen.Encumbrance'}}"><i class="fas fa-weight-hanging"></i> {{actor.encumbrance}}</span>
        <span class="def-tag" title="{{localize 'GUM.GMScreen.SizeModifier'}}">{{localize "GUM.GMScreen.SizeModifierShort"}} {{actor.sizeModifier}}</span>
        <span class="def-tag" title="{{localize 'GUM.GMScreen.CurrentDodge'}}"><i class="fas fa-running"></i> {{actor.defenses.dodge}}</span>
    </div>

    <div class="active-mods-zone">
        {{#if actor.activeGMMods.length}}
            {{#each actor.activeGMMods}}
            <span class="active-mod-tag" data-index="{{@index}}" {{#if this.removalGroupId}}data-group-id="{{this.removalGroupId}}"{{/if}} {{#if this.displayExpression}}title="{{this.displayExpression}}"{{/if}}>
                {{this.displayName}} <strong>{{this.displayValueText}}</strong>
                <i class="fas fa-times remove-mod"></i>
            </span>
            {{/each}}
        {{/if}}

        {{#if actor.activeGMEffects.length}}
            {{#each actor.activeGMEffects}}
            <span class="active-mod-tag {{#if this.isPending}}pending-effect{{/if}}"
                  data-effect-id="{{this.id}}"
                  {{#if this.isPending}}title="{{localize 'GUM.GMScreen.AppliedEffectStatus' status=this.statusLabel}}"{{/if}}>
                <i class="fas {{#if this.isPending}}fa-clock{{else}}fa-sparkles{{/if}}"></i> {{this.name}}
                {{#if this.isPending}}<small>({{localize "GUM.GMScreen.Pending"}})</small>{{/if}}
                <i class="fas fa-times remove-effect"></i>
            </span>
            {{/each}}
        {{/if}}

        {{#unless actor.hasActiveGMBadges}}
            <span class="hint-text">. . .</span>
        {{/unless}}
    </div>
</div>
{{/inline}}
