<form class="{{cssClass}} gum-item-sheet template-item-sheet" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-info">
      <div class="header-main-line">
        <textarea name="name" rows="1" placeholder="{{localize "GUM.Template.ModelName"}}">{{item.name}}</textarea>
      </div>
      <div class="header-subline">
        <span class="item-type-tag">{{localize "GUM.Template.Model"}}</span>
      </div>
      <span class="header-divider" aria-hidden="true"></span>
    </div>
  </header>

  <section class="sheet-content">
    <nav class="sheet-tabs tabs" data-group="primary">
      <a class="item" data-tab="description">{{localize "GUM.Template.Description"}}</a>
      <a class="item" data-tab="structure">{{localize "GUM.Template.Structure"}}</a>
    </nav>

    <section class="sheet-body-content">
      <div class="tab" data-group="primary" data-tab="description">
        <div class="description-tab">
          <div class="description-grid">
            <div class="form-group template-reference-field">
              <label for="template-ref">{{localize "GUM.Template.Reference"}}</label>
              <input id="template-ref" type="text" name="system.ref" value="{{system.ref}}" placeholder="{{localize "GUM.Equipment.Description.ReferenceExample"}}">
            </div>
            <div class="form-section description-section itemdesc-block">
              <details class="itemdesc-panel" open>
                <summary class="itemdesc-block-header">
                  <h4 class="itemdesc-block-title">{{localize "GUM.Template.ShortDescription"}}</h4>
                </summary>
                {{#if editable}}
                <span class="itemdesc-header-actions">
                    <button type="button" class="toggle-editor itemdesc-edit-button" data-field="system.chat_description">
                      <i class="fas fa-pen"></i>
                    </button>
                </span>
                {{/if}}
                <div class="itemdesc-content">
                  <div class="description-view itemdesc-inner">{{{enrichedChatDescription}}}</div>

                  <div class="description-editor itemdesc-inner" style="display:none;">
                    {{editor system.chat_description target="system.chat_description" engine="prosemirror" owner=owner editable=editable}}
                    <div class="description-actions">
                    <button type="button" class="save-description" data-field="system.chat_description"><i class="fas fa-save"></i> {{localize "GUM.Template.Save"}}</button>
                    <button type="button" class="expand-description" data-expanded="false"><i class="fas fa-expand"></i> {{localize "GUM.Template.Expand"}}</button>
                    <button type="button" class="cancel-description"><i class="fas fa-times"></i> {{localize "GUM.Template.Cancel"}}</button>
                    </div>
                  </div>
                </div>
              </details>
            </div>

            <div class="form-section description-section itemdesc-block">
              <details class="itemdesc-panel" open>
                <summary class="itemdesc-block-header">
                  <h4 class="itemdesc-block-title">{{localize "GUM.Template.FullDescription"}}</h4>
                </summary>
                {{#if editable}}
                <span class="itemdesc-header-actions">
                    <button type="button" class="toggle-editor itemdesc-edit-button" data-field="system.description">
                      <i class="fas fa-pen"></i>
                    </button>
                </span>
                {{/if}}
                <div class="itemdesc-content">
                  <div class="description-view itemdesc-inner">{{{enrichedDescription}}}</div>

                  <div class="description-editor itemdesc-inner" style="display:none;">
                    {{editor system.description target="system.description" engine="prosemirror" owner=owner editable=editable}}
                    <div class="description-actions">
                    <button type="button" class="save-description" data-field="system.description"><i class="fas fa-save"></i> {{localize "GUM.Template.Save"}}</button>
                    <button type="button" class="expand-description" data-expanded="false"><i class="fas fa-expand"></i> {{localize "GUM.Template.Expand"}}</button>
                    <button type="button" class="cancel-description"><i class="fas fa-times"></i> {{localize "GUM.Template.Cancel"}}</button>
                    </div>
                  </div>
                </div>
              </details>
            </div>
          </div>
        </div>
      </div>

      <div class="tab template-structure-tab" data-group="primary" data-tab="structure">
        <section class="template-shared-budgets">
          <div class="template-blocks-header template-section-bar">
            <h3 class="template-blocks-title">{{localize "GUM.Template.SharedBudgets"}} <span class="template-section-hint" title="{{localize "GUM.Template.SharedBudgetHint"}}" aria-label="{{localize "GUM.Template.SharedBudgetHint"}}"><i class="fas fa-info-circle"></i></span></h3>
            <button type="button" class="add-template-shared-budget" title="{{localize "GUM.Template.AddSharedBudget"}}"><i class="fas fa-plus"></i></button>
          </div>
          {{#if sharedBudgets.length}}
          <div class="template-shared-budget-list">
          <div class="template-shared-budget-columns" aria-hidden="true">
            <span>{{localize "GUM.Template.Name"}}</span>
            <span>{{localize "GUM.Template.SharedBudgetQuantity"}}</span>
            <span>{{localize "GUM.Template.SharedBudgetUnit"}}</span>
            <span>{{localize "GUM.Template.BudgetPolicyShort"}}</span>
            <span>{{localize "GUM.Template.MoneyAccounting"}}</span>
            <span></span>
          </div>
          {{#each sharedBudgets as |budget|}}
          <div class="template-shared-budget-row">
            <input class="template-shared-budget-field" data-budget-id="{{budget.id}}" data-field="name" value="{{budget.name}}" title="{{localize "GUM.Template.Name"}}">
            <input class="template-shared-budget-field" data-budget-id="{{budget.id}}" data-field="amount" type="number" min="0" value="{{budget.amount}}" title="{{localize "GUM.Template.SharedBudgetAmount"}}">
            <span class="template-budget-unit" title="{{budget.typeLabel}}">{{budget.typeLabel}}</span>
            <select class="template-shared-budget-field" data-budget-id="{{budget.id}}" data-field="policy" title="{{localize "GUM.Template.BudgetPolicy"}}">
              <option value="hard" {{#if (eq budget.policy "hard")}}selected{{/if}}>{{localize "GUM.Template.BudgetHard"}}</option>
              <option value="allow" {{#if (eq budget.policy "allow")}}selected{{/if}}>{{localize "GUM.Template.BudgetAllow"}}</option>
              <option value="gm" {{#if (eq budget.policy "gm")}}selected{{/if}}>{{localize "GUM.Template.BudgetGM"}}</option>
              <option value="unlimited" {{#if (eq budget.policy "unlimited")}}selected{{/if}}>{{localize "GUM.Template.BudgetUnlimited"}}</option>
            </select>
            {{#if (eq budget.type "money")}}
            <select class="template-shared-budget-field" data-budget-id="{{budget.id}}" data-field="accounting" title="{{localize "GUM.Template.MoneyAccounting"}}">
              <option value="budget" {{#unless (eq budget.accounting "deduct")}}selected{{/unless}}>{{localize "GUM.Template.MoneyBudgetOnly"}}</option>
              <option value="deduct" {{#if (eq budget.accounting "deduct")}}selected{{/if}}>{{localize "GUM.Template.MoneyDeduct"}}</option>
            </select>
            {{else}}<span class="template-budget-not-applicable" title="{{localize "GUM.Template.MoneyAccounting"}}">—</span>{{/if}}
            <button type="button" class="delete-template-shared-budget" data-budget-id="{{budget.id}}" title="{{localize "GUM.Template.Remove"}}"><i class="fas fa-trash"></i></button>
          </div>
          {{/each}}
          </div>
          {{/if}}
        </section>
        <div class="template-blocks-header template-blocks-section-header template-section-bar">
          <h3 class="template-blocks-title">{{localize "GUM.Template.Blocks"}}</h3>
          <button type="button" class="add-template-block template-blocks-add" title="{{localize "GUM.Template.AddBlock"}}">
            <i class="fas fa-plus"></i>
          </button>
        </div>

        <div class="template-block-list">
          {{#each blocks as |block|}}
          <section class="template-block" data-block-id="{{block.id}}">
            <header class="template-block-header">
              <button type="button" class="toggle-template-block" data-block-id="{{block.id}}" aria-expanded="{{#if block.collapsed}}false{{else}}true{{/if}}" title="{{#if block.collapsed}}{{localize "GUM.Template.ExpandBlock"}}{{else}}{{localize "GUM.Template.CollapseBlock"}}{{/if}}" aria-label="{{#if block.collapsed}}{{localize "GUM.Template.ExpandBlock"}}{{else}}{{localize "GUM.Template.CollapseBlock"}}{{/if}}"><i class="fas {{#if block.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i></button>

              <div class="template-block-heading">
                <h3 class="template-block-title">{{block.displayTitle}}</h3>
                <div class="template-block-summary">{{block.summaryText}}</div>
              </div>

              <div class="item-controls template-block-controls">
                <a class="item-control delete-template-block" data-block-id="{{block.id}}" title="{{localize "GUM.Template.RemoveBlock"}}">
                  <i class="fas fa-trash"></i>
                </a>
              </div>
            </header>

            {{#unless block.collapsed}}
            <div class="template-block-editor">
              <div class="template-block-fields">
                <div class="form-group template-block-title-field">
                  <label title="{{localize "GUM.Template.DefaultTitleHint"}}">{{localize "GUM.Template.CustomTitle"}}</label>
                  <input type="text"
                         class="block-field"
                         data-block-id="{{block.id}}"
                         data-field="title"
                         value="{{block.title}}"
                         title="{{localize "GUM.Template.DefaultTitleHint"}}"/>
                </div>
                <div class="template-block-destinations">
                  <div class="form-group">
                    <label title="{{localize "GUM.Template.DestinationGroupHint"}}">{{localize "GUM.Template.DestinationGroup"}}</label>
                    <input type="text" class="block-field" data-block-id="{{block.id}}" data-field="destinationGroup" value="{{block.destinationGroup}}" title="{{localize "GUM.Template.DestinationGroupHint"}}"/>
                  </div>
                  <div class="form-group">
                    <label title="{{localize "GUM.Template.DestinationContainerHint"}}">{{localize "GUM.Template.NewContainer"}}</label>
                    <input type="text" class="block-field" data-block-id="{{block.id}}" data-field="containerName" value="{{block.containerName}}" title="{{localize "GUM.Template.DestinationContainerHint"}}"/>
                  </div>
                </div>

                <div class="template-block-specific-fields">
                {{#if block.isSelection}}
                <div class="form-group input-narrow">
                  <label>{{localize "GUM.Template.ChoiceCount"}}</label>
                  <input type="number"
                         class="block-field"
                         data-block-id="{{block.id}}"
                         data-field="choiceCount"
                         value="{{block.choiceCount}}"
                         min="1"/>
                </div>
                <div class="form-group template-checkbox-field"><label class="template-inline-check" title="{{localize "GUM.Template.ExactChoicesHint"}}"><input type="checkbox" class="block-field" data-block-id="{{block.id}}" data-field="choiceExact" {{#if block.choiceExact}}checked{{/if}}/><span>{{localize "GUM.Template.ExactChoices"}}</span></label></div>
                {{/if}}

                {{#if block.isBudget}}
                {{#if block.isMoney}}
                <div class="form-group">
                  <label>{{localize "GUM.Template.MoneyMode"}}</label>
                  <select class="block-field" data-block-id="{{block.id}}" data-field="moneyMode">
                    <option value="deduct" {{#if block.isMoneyDeduct}}selected{{/if}}>{{localize "GUM.Template.MoneyModeDeduct"}}</option>
                    <option value="available" {{#if block.isMoneyAvailable}}selected{{/if}}>{{localize "GUM.Template.MoneyModeAvailable"}}</option>
                    <option value="shared" {{#if block.isMoneyShared}}selected{{/if}}>{{localize "GUM.Template.MoneyModeShared"}}</option>
                  </select>
                </div>

                {{#if block.isMoneyShared}}
                <div class="form-group">
                  <label>{{localize "GUM.Template.UseSharedBudget"}}</label>
                  <input type="text" class="block-field" data-block-id="{{block.id}}" data-field="sharedBudgetKey" value="{{block.sharedBudgetKey}}" title="{{localize "GUM.Template.SharedBudgetHint"}}">
                </div>
                {{else}}
                <div class="form-group input-narrow">
                  <label {{#if block.isMoneyDeduct}}title="{{localize 'GUM.Template.SpendingLimitHint'}}"{{/if}}>{{#if block.isMoneyDeduct}}{{localize "GUM.Template.SpendingLimit"}}{{else}}{{localize "GUM.Template.MoneyAvailable"}}{{/if}}</label>
                  <input type="number"
                         class="block-field"
                         data-block-id="{{block.id}}"
                         data-field="{{#if block.isMoneyDeduct}}spendingLimit{{else}}moneyAvailable{{/if}}"
                         value="{{#if block.isMoneyDeduct}}{{block.spendingLimitValue}}{{else}}{{block.budgetValue}}{{/if}}"
                         {{#if block.isMoneyDeduct}}placeholder="{{localize 'GUM.Template.Unlimited'}}"{{/if}}
                         min="0"/>
                </div>
                <div class="form-group">
                  <label>{{localize "GUM.Template.BudgetPolicy"}}</label>
                  <select class="block-field" data-block-id="{{block.id}}" data-field="budgetPolicy">
                    <option value="hard" {{#if (eq block.budgetPolicy "hard")}}selected{{/if}}>{{localize "GUM.Template.BudgetHard"}}</option>
                    <option value="allow" {{#if (eq block.budgetPolicy "allow")}}selected{{/if}}>{{localize "GUM.Template.BudgetAllow"}}</option>
                    <option value="gm" {{#if (eq block.budgetPolicy "gm")}}selected{{/if}}>{{localize "GUM.Template.BudgetGM"}}</option>
                    <option value="unlimited" {{#if (eq block.budgetPolicy "unlimited")}}selected{{/if}}>{{localize "GUM.Template.BudgetUnlimited"}}</option>
                  </select>
                </div>
                {{#if block.isMoneyDeduct}}
                <div class="form-group">
                  <label title="{{localize 'GUM.Template.PaymentSourceFilterHint'}}">{{localize "GUM.Template.PaymentSourceFilter"}}</label>
                  <input type="text" class="block-field" data-block-id="{{block.id}}" data-field="moneySourceFilter" value="{{block.moneySourceFilter}}" title="{{localize 'GUM.Template.PaymentSourceFilterHint'}}"/>
                </div>
                {{/if}}
                {{/if}}
                {{else}}
                <div class="form-group">
                  <label>{{localize "GUM.Template.UseSharedBudget"}}</label>
                  <input type="text" class="block-field" data-block-id="{{block.id}}" data-field="sharedBudgetKey" value="{{block.sharedBudgetKey}}" title="{{localize "GUM.Template.OwnBudget"}}">
                </div>
                {{#unless block.sharedBudgetKey}}
                <div class="form-group input-narrow">
                  <label>{{localize "GUM.Template.PointsAvailable"}}</label>
                  <input type="number" class="block-field" data-block-id="{{block.id}}" data-field="pointsAvailable" value="{{block.budgetValue}}" min="0"/>
                </div>
                <div class="form-group">
                  <label>{{localize "GUM.Template.BudgetPolicy"}}</label>
                  <select class="block-field" data-block-id="{{block.id}}" data-field="budgetPolicy">
                    <option value="hard" {{#if (eq block.budgetPolicy "hard")}}selected{{/if}}>{{localize "GUM.Template.BudgetHard"}}</option>
                    <option value="allow" {{#if (eq block.budgetPolicy "allow")}}selected{{/if}}>{{localize "GUM.Template.BudgetAllow"}}</option>
                    <option value="gm" {{#if (eq block.budgetPolicy "gm")}}selected{{/if}}>{{localize "GUM.Template.BudgetGM"}}</option>
                    <option value="unlimited" {{#if (eq block.budgetPolicy "unlimited")}}selected{{/if}}>{{localize "GUM.Template.BudgetUnlimited"}}</option>
                  </select>
                </div>
                {{/unless}}
                {{/if}}
                {{/if}}
                </div>

                <div class="form-group template-block-instructions-field">
                  <label title="{{localize "GUM.Template.BlockInstructionsHint"}}">{{localize "GUM.Template.BlockInstructions"}}</label>
                  <textarea class="block-field" data-block-id="{{block.id}}" data-field="instructions" rows="2" placeholder="{{localize "GUM.Template.BlockInstructionsPlaceholder"}}">{{block.instructions}}</textarea>
                </div>
              </div>



              <div class="template-entry-list">
                {{#each block.contents as |entry|}}
                <article class="template-entry-card">
                  <div class="template-entry-card__main">
                    <div class="template-entry-name">{{entry.rowName}}</div>
                    {{#if entry.rowSubtitle}}<div class="template-entry-subtitle">{{entry.rowSubtitle}}</div>{{/if}}
                  </div>
                  <div class="template-entry-card__meta">
                    {{#unless (eq entry.rowQty "-")}}<span title="{{localize "GUM.Template.QuantityShort"}}">{{localize "GUM.Template.QuantityShort"}} {{entry.rowQty}}</span>{{/unless}}
                    {{#unless (eq entry.rowLevel "-")}}<span title="{{localize "GUM.Template.Level"}}">{{localize "GUM.Template.Level"}} {{entry.rowLevel}}</span>{{/unless}}
                    {{#unless (eq entry.rowCost "-")}}<span title="{{localize "GUM.Template.Cost"}}">{{localize "GUM.Template.Cost"}} · {{entry.rowCost}}</span>{{/unless}}
                  </div>
                  <div class="template-entry-controls">
                    <button type="button" class="preview-block-entry" data-block-id="{{block.id}}" data-entry-id="{{entry.id}}" title="{{localize "GUM.Template.PreviewEntry"}}" aria-label="{{localize "GUM.Template.PreviewEntry"}}"><i class="fas fa-eye"></i></button>
                    <button type="button" class="edit-block-entry" data-block-id="{{block.id}}" data-entry-id="{{entry.id}}" title="{{localize "GUM.Template.ConfigureEntry"}}" aria-label="{{localize "GUM.Template.ConfigureEntry"}}">{{localize "GUM.Template.ConfigureEntry"}}</button>
                    <button type="button" class="delete-block-entry" data-block-id="{{block.id}}" data-entry-id="{{entry.id}}" title="{{localize "GUM.Template.Remove"}}" aria-label="{{localize "GUM.Template.Remove"}}"><i class="fas fa-trash"></i></button>
                  </div>
                </article>
                {{/each}}
                <div class="template-dropzone" data-block-id="{{block.id}}">
                  <i class="fas fa-arrow-down"></i>
                  <span>{{#if block.contents.length}}{{localize "GUM.Template.DropMore"}}{{else}}{{localize "GUM.Template.DropItems"}}{{/if}}</span>
                </div>
              </div>

                <div class="template-block-actions">
                    <button type="button" class="add-block-attribute" data-block-id="{{block.id}}">
                    <i class="fas fa-sliders-h"></i> {{localize "GUM.Template.AddAttribute"}}
                    </button>
                    <button type="button" class="add-block-group" data-block-id="{{block.id}}">
                    <i class="fas fa-project-diagram"></i> {{localize "GUM.Template.AddPackage"}}
                    </button>
                </div>

            </div>
            {{/unless}}
          </section>
          {{else}}
          <div class="template-empty-state">
            {{localize "GUM.Template.NoBlocks"}}
          </div>
          {{/each}}
        </div>
      </div>
    </section>
  </section>
</form>
