                    <input type="checkbox" class="ammunition-enabled-toggle" name="system.ammunition.enabled" {{checked system.ammunition.enabled}}/>
                </label>
            </div>
            {{#if equipmentAmmunitionChanged}}
            <div class="ammunition-effective-note"><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i><span>{{localize "GUM.Equipment.Ammunition.ModifiedResult"}}: <strong>{{#if equipmentResolvedAmmunition.enabled}}{{localize "GUM.Equipment.Ammunition.Enabled"}}{{else}}{{localize "GUM.Equipment.Ammunition.Disabled"}}{{/if}}</strong> · {{localize "GUM.Equipment.Ammunition.AttackModifier"}} <strong>{{equipmentResolvedAmmunition.attack_modifier}}</strong> · {{localize "GUM.Equipment.Ammunition.MainDamage"}} <strong>{{#if equipmentResolvedAmmunition.main.formula}}{{equipmentResolvedAmmunition.main.formula}}{{else}}—{{/if}}</strong></span></div>
            {{/if}}
            <div class="ammunition-options {{#unless system.ammunition.enabled}}is-hidden{{/unless}}">
                <div class="ammunition-summary-grid">
                    <label class="ammunition-stat-card"><span>{{localize "GUM.Equipment.Ammunition.AttackModifier"}}</span><input type="number" name="system.ammunition.attack_modifier" value="{{system.ammunition.attack_modifier}}"></label>
                    <label class="ammunition-stat-card"><span>{{localize "GUM.Equipment.Ammunition.LowWarning"}}</span><input type="number" min="0" name="system.ammunition.low_warning" value="{{system.ammunition.low_warning}}"></label>
                </div>
                {{#each (array "main" "follow_up" "fragmentation") as |part|}}
                <fieldset class="ammunition-damage-group"><legend>{{#if (eq part "main")}}{{localize "GUM.Equipment.Ammunition.MainDamage"}}{{else}}{{#if (eq part "follow_up")}}{{localize "GUM.Equipment.Ammunition.FollowUpDamage"}}{{else}}{{localize "GUM.Equipment.Ammunition.FragmentationDamage"}}{{/if}}{{/if}}</legend>
                    <div class="ammunition-damage-grid">
                        <span>{{localize "GUM.Equipment.Ammunition.Formula"}}</span><span>{{localize "GUM.Equipment.Ammunition.Type"}}</span><span>{{localize "GUM.Equipment.Ammunition.Nature"}}</span><span>{{localize "GUM.Equipment.Ammunition.Divisor"}}</span>
                        <input type="text" name="system.ammunition.{{part}}.formula" value="{{lookup (lookup @root.system.ammunition part) 'formula'}}" aria-label="{{localize "GUM.Equipment.Ammunition.Formula"}}"/>
                        <input type="text" name="system.ammunition.{{part}}.type" value="{{lookup (lookup @root.system.ammunition part) 'type'}}" aria-label="{{localize "GUM.Equipment.Ammunition.Type"}}"/>
                        <input type="text" name="system.ammunition.{{part}}.nature" value="{{lookup (lookup @root.system.ammunition part) 'nature'}}" aria-label="{{localize "GUM.Equipment.Ammunition.Nature"}}"/>
                        <input type="number" step="0.1" min="0.1" name="system.ammunition.{{part}}.armor_divisor" value="{{lookup (lookup @root.system.ammunition part) 'armor_divisor'}}" aria-label="{{localize "GUM.Equipment.Ammunition.ArmorDivisor"}}"/>
                        <select name="system.ammunition.{{part}}.operation" aria-label="{{localize "GUM.Equipment.Ammunition.FormulaOperation"}}"><option value="replace" {{#if (eq (lookup (lookup @root.system.ammunition part) 'operation') "replace")}}selected{{/if}}>{{localize "GUM.EquipmentModifier.Operations.Set"}}</option><option value="add" {{#if (eq (lookup (lookup @root.system.ammunition part) 'operation') "add")}}selected{{/if}}>{{localize "GUM.EquipmentModifier.Operations.Add"}}</option><option value="multiply" {{#if (eq (lookup (lookup @root.system.ammunition part) 'operation') "multiply")}}selected{{/if}}>{{localize "GUM.EquipmentModifier.Operations.Multiply"}}</option></select>
                        <span class="ammunition-grid-hint">{{localize "GUM.EquipmentModifier.Operations.Set"}}</span><span class="ammunition-grid-hint">{{localize "GUM.EquipmentModifier.Operations.Set"}}</span>
                        <select name="system.ammunition.{{part}}.divisor_operation" aria-label="{{localize "GUM.Equipment.Ammunition.DivisorOperation"}}"><option value="replace" {{#if (eq (lookup (lookup @root.system.ammunition part) 'divisor_operation') "replace")}}selected{{/if}}>{{localize "GUM.EquipmentModifier.Operations.Set"}}</option><option value="add" {{#if (eq (lookup (lookup @root.system.ammunition part) 'divisor_operation') "add")}}selected{{/if}}>{{localize "GUM.EquipmentModifier.Operations.Add"}}</option><option value="multiply" {{#if (eq (lookup (lookup @root.system.ammunition part) 'divisor_operation') "multiply")}}selected{{/if}}>{{localize "GUM.EquipmentModifier.Operations.Multiply"}}</option></select>
                    </div>
                </fieldset>
                {{/each}}
            </div>
        </div>
         </div>
     
     {{!-- ===================================================================== --}}
     {{!--     ABA ESPECIAL: EFEITO                                  --}}
     {{!-- ===================================================================== --}}
     <div class="tab" data-tab="effects">
         {{!-- Aqui nós chamamos nosso bloco reutilizável --}}
         {{> effectsTab}}
   </div>

     {{!-- ===================================================================== --}}
     {{!--              ABA PRÉ-DEFINIDO (somente para Perícias)                 --}}
     {{!-- ===================================================================== --}}
     {{#if (eq item.type "skill")}}
     <div class="tab" data-tab="predefined">
        <div class="form-section">
            <h4 class="section-title">Pré-definidos</h4>
            <p class="section-hint">Tabela fixa com até 6 combinações de nome, especialização e modificador.</p>

            <div class="predefined-editor-section">
                <ol class="predefined-list">

                    <li class="predefined-item">
                        <div class="predefined-display-card">
                            <div class="predefined-line">
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot1.name" value="{{system.predefined.slot1.name}}" placeholder="Nome"/></div>
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot1.specialization" value="{{system.predefined.slot1.specialization}}" placeholder="Especialização"/></div>
                                <div class="predefined-cell predefined-cell-modifier"><input type="number" name="system.predefined.slot1.modifier" value="{{system.predefined.slot1.modifier}}" placeholder="0"/></div>
                            </div>
                        </div>
                    </li>

                    <li class="predefined-item">
                        <div class="predefined-display-card">
                            <div class="predefined-line">
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot2.name" value="{{system.predefined.slot2.name}}" placeholder="Nome"/></div>
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot2.specialization" value="{{system.predefined.slot2.specialization}}" placeholder="Especialização"/></div>
                                <div class="predefined-cell predefined-cell-modifier"><input type="number" name="system.predefined.slot2.modifier" value="{{system.predefined.slot2.modifier}}" placeholder="0"/></div>
                            </div>
                        </div>
                    </li>

                    <li class="predefined-item">
                        <div class="predefined-display-card">
                            <div class="predefined-line">
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot3.name" value="{{system.predefined.slot3.name}}" placeholder="Nome"/></div>
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot3.specialization" value="{{system.predefined.slot3.specialization}}" placeholder="Especialização"/></div>
                                <div class="predefined-cell predefined-cell-modifier"><input type="number" name="system.predefined.slot3.modifier" value="{{system.predefined.slot3.modifier}}" placeholder="0"/></div>
                            </div>
                        </div>
                    </li>

                    <li class="predefined-item">
                        <div class="predefined-display-card">
                            <div class="predefined-line">
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot4.name" value="{{system.predefined.slot4.name}}" placeholder="Nome"/></div>
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot4.specialization" value="{{system.predefined.slot4.specialization}}" placeholder="Especialização"/></div>
                                <div class="predefined-cell predefined-cell-modifier"><input type="number" name="system.predefined.slot4.modifier" value="{{system.predefined.slot4.modifier}}" placeholder="0"/></div>
                            </div>
                        </div>
                    </li>

                    <li class="predefined-item">
                        <div class="predefined-display-card">
                            <div class="predefined-line">
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot5.name" value="{{system.predefined.slot5.name}}" placeholder="Nome"/></div>
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot5.specialization" value="{{system.predefined.slot5.specialization}}" placeholder="Especialização"/></div>
                                <div class="predefined-cell predefined-cell-modifier"><input type="number" name="system.predefined.slot5.modifier" value="{{system.predefined.slot5.modifier}}" placeholder="0"/></div>
                            </div>
                        </div>
                    </li>

                    <li class="predefined-item">
                        <div class="predefined-display-card">
                            <div class="predefined-line">
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot6.name" value="{{system.predefined.slot6.name}}" placeholder="Nome"/></div>
                                <div class="predefined-cell"><input type="text" name="system.predefined.slot6.specialization" value="{{system.predefined.slot6.specialization}}" placeholder="Especialização"/></div>
                                <div class="predefined-cell predefined-cell-modifier"><input type="number" name="system.predefined.slot6.modifier" value="{{system.predefined.slot6.modifier}}" placeholder="0"/></div>
                            </div>
                        </div>
                    </li>
                </ol>
            </div>
        </div>

        <div class="form-section">
            <h4 class="section-title">Árvore de Perícia</h4>
            <p class="section-hint">Somado ao NH final da própria perícia no modo árvore (ex.: Atributo -5). Não é herdado para níveis abaixo.</p>
            <div class="form-row">
                <input type="number" name="system.tree_default_mod" value="{{system.tree_default_mod}}" placeholder="-5"/>
            </div>
        </div>

     </div>
     {{/if}}


{{!-- ===================================================================== --}}
{{!--    ABA ESPECIAL: MODIFICADORES (MESMO LAYOUT DO EQP_MODIFIERS)         --}}
{{!-- ===================================================================== --}}
<div class="tab" data-tab="modifiers">
  {{#if (or (eq item.type "advantage") (eq item.type "disadvantage") (eq item.type "power"))}}

    <div class="modifiers-tab">
      <div class="eqpmod-block">

        {{!-- Header padrão + plus minimalista --}}
        <div class="eqpmod-block-header">
          <h4 class="eqpmod-block-title">Modificadores</h4>
          <a class="eqpmod-add-button add-modifier" title="Adicionar Modificador">
            <i class="fas fa-plus"></i>
          </a>
        </div>

        {{!-- Lista em linhas (mesma do eqp_modifiers) --}}
        <ol class="eqpmod-line-list">
          {{#each sortedModifiers as |modifier|}}
            <li class="eqpmod-line-item {{#if modifier.isLimitation}}is-limitation{{else}}is-enhancement{{/if}}"
                data-modifier-id="{{modifier.id}}">
              <div class="eqpmod-line">

                {{!-- Identidade: ícone + nome --}}
                <div class="eqpmod-cell eqpmod-identity">
                  {{#if modifier.img}}
                    <img src="{{modifier.img}}" class="eqpmod-icon" />
                  {{else}}
                    <img src="icons/svg/aura.svg" class="eqpmod-icon" />
                  {{/if}}

                  <div class="eqpmod-text">
                    <div class="eqpmod-name">{{modifier.name}}</div>
                        {{!-- Subline discreta: efeito aplicado --}}
                        {{#if modifier.applied_effect}}
                            <div class="eqpmod-subline">{{modifier.applied_effect}}</div>
                        {{/if}}
                  </div>
                </div>


                {{!-- Custo (%) --}}
                <div class="eqpmod-cell eqpmod-stat is-center">
                  <div class="eqpmod-label">Custo</div>
                  <div class="eqpmod-value">{{modifier.cost}}</div>
                </div>

                {{!-- Nível --}}
                <div class="eqpmod-cell eqpmod-stat is-center">
                  <div class="eqpmod-label">Nível</div>
                  <div class="eqpmod-value">{{modifier.level}}</div>
                </div>

                {{!-- Ações --}}
                <div class="eqpmod-cell eqpmod-actions">
                  <span class="eqpmod-controls">
                    <a class="view-modifier" title="Visualizar Detalhes" data-modifier-id="{{modifier.id}}">
                      <i class="fas fa-eye"></i>
                    </a>
                    <a class="delete-modifier" title="Remover" data-modifier-id="{{modifier.id}}">
                      <i class="fas fa-trash"></i>
                    </a>
                  </span>
                </div>

              </div>
            </li>

          {{else}}
            <li class="eqpmod-empty">Nenhum modificador aplicado.</li>
          {{/each}}
        </ol>
        {{#if canUseItemAttachmentDrops}}<div class="item-attachment-dropzone" data-attachment-type="modifier"><i class="fas fa-arrow-down" aria-hidden="true"></i><span>{{localize "GUM.ItemAttachments.DropModifier"}}</span></div>{{/if}}

      </div>
    </div>

  {{/if}}
</div>

       
       {{!-- ===================================================================== --}}
    {{!--           ABA ESPECIAL: MODIFICADORES DE EQUIPAMENTO                  --}}
    {{!-- ===================================================================== --}}
    <div class="tab" data-tab="eqp_modifiers">
        {{#if (eq item.type "equipment")}}
            
<div class="modifiers-tab">
  <div class="eqpmod-block">

    {{!-- Header vermelho + plus minimalista --}}
    <div class="eqpmod-block-header">
      <h4 class="eqpmod-block-title">{{localize "GUM.Equipment.Modifiers.Title"}}</h4>
      <a class="eqpmod-add-button add-eqp-modifier" title="{{localize 'GUM.Equipment.Modifiers.Add'}}"><i class="fas fa-plus"></i></a>
    </div>

    {{!-- Lista em linhas --}}
    <ol class="eqpmod-line-list">
      {{#each eqpModifiersList as |mod|}}
        <li class="eqpmod-line-item" data-modifier-id="{{mod.id}}">
          <div class="eqpmod-line">

            {{!-- Identidade: ícone + nome --}}
            <div class="eqpmod-cell eqpmod-identity">
              <input type="checkbox" name="system.eqp_modifiers.{{mod.id}}.enabled" {{checked mod.enabled}} title="{{localize 'GUM.Equipment.Modifiers.Enabled'}}" aria-label="{{localize 'GUM.Equipment.Modifiers.Enable' name=mod.name}}"/>
              {{#if mod.img}}
                <img src="{{mod.img}}" class="eqpmod-icon" />
              {{else}}
                <img src="icons/svg/item-bag.svg" class="eqpmod-icon" />
              {{/if}}

              <div class="eqpmod-text">
                <div class="eqpmod-name">{{mod.name}}{{#if (eq mod.source_type "effect")}} <span class="eqpmod-subline">{{localize "GUM.Equipment.Modifiers.Effect"}}</span>{{/if}}</div>
                <div class="eqpmod-subline">{{localize "GUM.EquipmentModifier.Fields.Level"}} <input type="number" min="0" step="1" name="system.eqp_modifiers.{{mod.id}}.level" value="{{mod.level}}" style="width: 52px;"/></div>
              </div>
            </div>

            {{!-- CF --}}
            <div class="eqpmod-cell eqpmod-stat is-center">
              <div class="eqpmod-label">CF</div>
              <div class="eqpmod-value">{{mod.costDisplay}}</div>
            </div>

            {{!-- Peso --}}
            <div class="eqpmod-cell eqpmod-stat is-center">
              <div class="eqpmod-label">{{localize "GUM.Equipment.Modifiers.Weight"}}</div>
              <div class="eqpmod-value">{{mod.weightDisplay}}</div>
            </div>

            {{!-- Ações --}}
            <div class="eqpmod-cell eqpmod-actions">
              <span class="eqpmod-controls">
                {{!-- se você já tiver handler "view", mantenha essa classe; se não, deixa só o delete --}}
                <a class="view-eqp-modifier" title="{{localize 'GUM.Equipment.Modifiers.View'}}"><i class="fas fa-eye"></i></a>
                {{#unless (eq mod.source_type "effect")}}
                <a class="delete-eqp-modifier" title="{{localize 'GUM.Equipment.Modifiers.Remove'}}"><i class="fas fa-trash"></i></a>
                {{/unless}}
              </span>
            </div>
          </div>

          {{!-- Opcional: notas/efeitos em linha extra bem discreta --}}
          {{#if mod.features}}
            <div class="eqpmod-subline">{{mod.features}}</div>
          {{/if}}
        </li>
      {{else}}
        <li class="eqpmod-empty">{{localize "GUM.Equipment.Modifiers.None"}}</li>
      {{/each}}
    </ol>
    {{#if canUseItemAttachmentDrops}}<div class="item-attachment-dropzone" data-attachment-type="eqp-modifier"><i class="fas fa-arrow-down" aria-hidden="true"></i><span>{{localize "GUM.ItemAttachments.DropEquipmentModifier"}}</span></div>{{/if}}

    <section class="equipment-resolution-panel">
      <header class="equipment-resolution-header"><i class="fas fa-calculator"></i><span>{{localize "GUM.Equipment.Modifiers.Result"}}</span></header>
      <div class="equipment-resolution-summary">
        <article class="equipment-resolution-card">
          <span class="equipment-resolution-label">{{localize "GUM.Equipment.Modifiers.UnitPrice"}}</span>
          <strong class="equipment-resolution-value">{{finalCostString}}</strong>
          <span class="equipment-resolution-base">{{localize "GUM.Equipment.Modifiers.Base" value=system.cost}}</span>
        </article>
        <article class="equipment-resolution-card">
          <span class="equipment-resolution-label">{{localize "GUM.Equipment.Modifiers.UnitWeight"}}</span>
          <strong class="equipment-resolution-value">{{finalWeightString}} kg</strong>
          <span class="equipment-resolution-base">{{localize "GUM.Equipment.Modifiers.Base" value=(concat system.weight " kg")}}</span>
        </article>
      </div>
      {{#if equipmentCostSteps.length}}
      <div class="equipment-feature-trace equipment-calculation-trace">
        <strong>{{localize "GUM.Equipment.Modifiers.PriceTrace"}}</strong>
        <ol>{{#each equipmentCostSteps as |step|}}<li><span>{{step.stageLabel}}: {{step.input}} → <strong>{{step.output}}</strong></span>{{#each step.entries as |entry|}}<span class="notes">{{entry.sourceName}}: {{entry.expression}} ({{localize "GUM.Equipment.Modifiers.Scale" value=entry.scale}})</span>{{/each}}</li>{{/each}}</ol>
      </div>
      {{/if}}
      {{#if equipmentWeightSteps.length}}
      <div class="equipment-feature-trace equipment-calculation-trace">
        <strong>{{localize "GUM.Equipment.Modifiers.WeightTrace"}}</strong>
        <ol>{{#each equipmentWeightSteps as |step|}}<li><span>{{step.stageLabel}}: {{step.input}} → <strong>{{step.output}}</strong></span>{{#each step.entries as |entry|}}<span class="notes">{{entry.sourceName}}: {{entry.expression}} ({{localize "GUM.Equipment.Modifiers.Scale" value=entry.scale}})</span>{{/each}}</li>{{/each}}</ol>
      </div>
      {{/if}}
      {{#if equipmentFeatureSteps.length}}
      <div class="equipment-feature-trace">
        <strong>{{localize "GUM.Equipment.Modifiers.FeatureTrace"}}</strong>
        <ol>
          {{#each equipmentFeatureSteps as |step|}}
          <li>
            <span>{{step.sourceName}} — {{step.label}}</span>
            {{#if step.path}}<code>{{step.path}}</code>{{/if}}
            {{#if step.attackId}}<span class="notes">({{step.attackType}}: {{step.attackId}})</span>{{/if}}
            {{#if step.path}}<span class="notes">{{step.input}} → <strong>{{step.output}}</strong></span>{{/if}}
            {{#if step.effectUuid}}<span class="notes">{{step.domain}} · {{step.effectUuid}}</span>{{/if}}
          </li>
          {{/each}}
        </ol>
      </div>
      {{/if}}
      {{#if equipmentResolutionWarnings.length}}
      <div class="equipment-resolution-warnings">
            <strong><i class="fas fa-triangle-exclamation"></i> {{localize "GUM.Equipment.Modifiers.Warnings"}}</strong>
        <ul>{{#each equipmentResolutionWarnings as |warning|}}<li><strong>{{warning.source}}:</strong> {{warning.message}}</li>{{/each}}</ul>
      </div>
      {{/if}}
    </section>

  </div>
</div>


        {{/if}}
    </div>
   </section>
</section>
