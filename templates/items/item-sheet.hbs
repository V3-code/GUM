                                    <i class="fas fa-tachometer-alt" aria-hidden="true"></i>
                                    Cap NH (teto)
                                </label>
                                <div class="effect-premium-field-control">
                                    <input type="text" name="system.modifier_entries.{{entry.index}}.nh_cap" value="{{entry.nh_cap}}" placeholder="Opcional"/>
                                </div>
                            </div>
                        </div>

                        <div class="effect-premium-field modifier-entry-field gm-modifier-expression-field">
                            <label class="effect-premium-field-label" title="{{localize 'GUM.GMModifier.ValueHint'}}">
                                <i class="fas fa-code" aria-hidden="true"></i>
                                {{localize "GUM.GMModifier.ValueExpression"}}
                                <i class="fas fa-circle-info gm-modifier-expression-info" aria-hidden="true"></i>
                            </label>
                            <div class="effect-premium-field-control">
                                <textarea class="gm-modifier-expression-input" rows="2" name="system.modifier_entries.{{entry.index}}.value" placeholder="{{localize 'GUM.GMModifier.ValuePlaceholder'}}" spellcheck="false">{{entry.value}}</textarea>
