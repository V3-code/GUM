                                    <input type="text" name="system.modifier_entries.{{entry.index}}.label" value="{{entry.label}}" placeholder="Ex: Bônus de ataque"/>
                                </div>
                            </div>

                            <div class="effect-premium-field modifier-entry-field modifier-entry-field-cap">
