{{!-- Definindo o partial 'inline' no topo do arquivo --}}
{{#*inline "itemDetailsGeneral"}}
    <div class="equipment-details-layout">
        {{!-- Este bloco contém os campos gerais para equipamentos. --}}
        <div class="form-section skill-details-compact equipment-details-form">
            <h4 class="section-title">{{localize "GUM.Equipment.Details.General"}}</h4>
            <div class="equipment-general-grid">
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-coins"></i><span>{{localize "GUM.Equipment.Label.Cost"}}</span></label>
                    <div class="equipment-stat-control">
                        {{#if hasCostChange}}
                            <div class="equipment-calculated-value">
                                <input type="number" step="0.01" name="system.cost" value="{{system.cost}}" title="{{localize 'GUM.Equipment.Label.BaseCost'}}"/>
                                <div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalCost'}}">
                                    <i class="fas fa-arrow-right"></i>
                                    <span>{{finalCostString}}</span>
                                </div>
                            </div>
                        {{else}}
                            <input type="number" step="0.01" name="system.cost" value="{{system.cost}}"/>
                        {{/if}}
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-weight-hanging"></i><span>{{localize "GUM.Equipment.Label.Weight"}}</span></label>
                    <div class="equipment-stat-control">
                        {{#if hasWeightChange}}
                            <div class="equipment-calculated-value">
                                <input type="number" step="0.01" name="system.weight" value="{{system.weight}}" title="{{localize 'GUM.Equipment.Label.BaseWeight'}}"/>
                                <div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalWeight'}}">
                                    <i class="fas fa-arrow-right"></i>
                                    <span>{{finalWeightString}}</span>
                                </div>
                            </div>
                        {{else}}
                            <input type="number" step="0.01" name="system.weight" value="{{system.weight}}"/>
                        {{/if}}
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-cubes"></i><span>{{localize "GUM.Equipment.Label.Quantity"}}</span></label>
                    <div class="equipment-stat-control">
                        <input type="number" name="system.quantity" value="{{system.quantity}}"/>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Label.TechLevel'}}"><i class="fas fa-microchip"></i><span>{{localize "GUM.Equipment.Label.TechLevel"}}</span></label>
                    <div class="equipment-stat-control">
                        <input type="text" name="system.tech_level" value="{{system.tech_level}}"/>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Label.Legality'}}"><i class="fas fa-balance-scale"></i><span>{{localize "GUM.Equipment.Label.Legality"}}</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value">
                            <input type="text" name="system.legality_class" value="{{system.legality_class}}" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>
                            {{#if equipmentPropertyChanges.legality_class.changed}}
                            <div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.legality_class.final}}</span></div>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>

            <div class="equipment-template-values-grid">
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-layer-group"></i><span>{{localize "GUM.Equipment.Label.Level"}}</span></label>
                    <div class="equipment-stat-control">
                        <input type="text" name="system.level" value="{{system.level}}"/>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-star"></i><span>{{localize "GUM.Equipment.Label.PointsValue"}}</span></label>
                    <div class="equipment-stat-control">
                        <input type="number" step="any" name="system.points" value="{{system.points}}"/>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section skill-details-compact equipment-details-form">
            <h4 class="section-title">{{localize "GUM.Equipment.Details.Physical"}}</h4>
            <div class="equipment-text-grid">
                <div class="equipment-field-card">
                    <label class="equipment-stat-heading"><i class="fas fa-gem"></i><span>{{localize "GUM.Equipment.Label.Quality"}}</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value">
                            <input type="text" name="system.quality" value="{{system.quality}}" placeholder="{{localize 'GUM.Equipment.Label.QualityExample'}}" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>
                            {{#if equipmentPropertyChanges.quality.changed}}
                            <div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.quality.final}}</span></div>
                            {{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-field-card">
                    <label class="equipment-stat-heading"><i class="fas fa-cubes"></i><span>{{localize "GUM.Equipment.Label.Material"}}</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value">
                            <input type="text" name="system.material" value="{{system.material}}" placeholder="{{localize 'GUM.Equipment.Label.MaterialExample'}}" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>
                            {{#if equipmentPropertyChanges.material.changed}}
                            <div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.material.final}}</span></div>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>

            <div class="equipment-physical-grid">
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Label.SizeModifier'}}"><i class="fas fa-expand-arrows-alt"></i><span>{{localize "GUM.Equipment.Label.SizeModifier"}}</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.tech_sm" value="{{system.tech_sm}}" placeholder="+0" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>
                            {{#if equipmentPropertyChanges.tech_sm.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.tech_sm.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Label.ItemDR'}}"><i class="fas fa-shield-alt"></i><span>{{localize "GUM.Equipment.Label.ItemDR"}}</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.item_dr" value="{{system.item_dr}}" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>
                            {{#if equipmentPropertyChanges.item_dr.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.item_dr.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Label.ItemHPMax'}}"><i class="fas fa-heart"></i><span>{{localize "GUM.Equipment.Label.ItemHPMax"}}</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.item_hp" value="{{system.item_hp}}" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>
                            {{#if equipmentPropertyChanges.item_hp.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.item_hp.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Label.ItemHPCurrent'}}"><i class="fas fa-heart-pulse"></i><span>{{localize "GUM.Equipment.Label.ItemHPCurrent"}}</span></label>
                    <div class="equipment-stat-control"><input type="number" min="0" name="system.item_hp_current" value="{{system.item_hp_current}}"/></div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Label.ItemHT'}}"><i class="fas fa-heartbeat"></i><span>{{localize "GUM.Equipment.Label.ItemHT"}}</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.item_ht" value="{{system.item_ht}}" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>
                            {{#if equipmentPropertyChanges.item_ht.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.item_ht.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>
            </div>
            <label class="equipment-stat-card equipment-integrity-toggle" title="{{localize 'GUM.Equipment.Label.IntegrityRecordHint'}}">
                <span class="equipment-stat-heading"><i class="fas fa-shield-heart"></i><span>{{localize "GUM.Equipment.Label.IntegrityRecord"}}</span></span>
                <span class="equipment-toggle-pill"><input type="checkbox" name="system.integrity_record_enabled" {{checked system.integrity_record_enabled}}/><span>{{localize "GUM.Equipment.Label.Enabled"}}</span></span>
            </label>
        </div>

        <div class="form-section skill-details-compact equipment-details-form">
            <h4 class="section-title">{{localize "GUM.Equipment.Details.Uses"}}</h4>
            <div class="equipment-defense-grid">
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-flask"></i><span>{{localize "GUM.Equipment.Label.ConsumptionMode"}}</span></label>
                    <div class="equipment-stat-control"><div class="equipment-calculated-value"><select name="system.uses_mode" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"><option value="quantity" {{#if (eq system.uses_mode "quantity")}}selected{{/if}}>{{localize "GUM.Equipment.Label.ConsumeQuantity"}}</option><option value="charges" {{#if (eq system.uses_mode "charges")}}selected{{/if}}>{{localize "GUM.Equipment.Label.UseCharges"}}</option></select>{{#if equipmentUseChanges.mode.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentUseChanges.mode.finalLabel}}</span></div>{{/if}}</div></div>
                </div>
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-battery-full"></i><span>{{localize "GUM.Equipment.Label.MaxCharges"}}</span></label>
                    <div class="equipment-stat-control"><div class="equipment-calculated-value"><input type="number" min="0" name="system.max_uses" value="{{system.max_uses}}" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>
                        {{#if equipmentPropertyChanges.max_uses.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.max_uses.final}}</span></div>{{/if}}
                    </div></div>
                </div>
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-battery-half"></i><span>{{localize "GUM.Equipment.Label.SpentCharges"}}</span></label>
                    <div class="equipment-stat-control"><input type="number" min="0" name="system.current_uses" value="{{system.current_uses}}"/></div>
                    {{#if (eq equipmentUses.mode "charges")}}<small class="notes">{{localize "GUM.Equipment.Label.Remaining"}}: {{equipmentUses.remaining}} / {{equipmentUses.max}}</small>{{/if}}
                </div>
                <div class="equipment-stat-card"><label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Reserve.Hint'}}"><i class="fas fa-battery-three-quarters"></i><span>{{localize "GUM.Equipment.Reserve.ShowAs"}}</span></label><div class="equipment-stat-control"><div class="equipment-calculated-value"><select name="system.charge_reserve_type" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"><option value="" {{#unless system.charge_reserve_type}}selected{{/unless}}>{{localize "GUM.Equipment.Reserve.None"}}</option><option value="combat" {{#if (eq system.charge_reserve_type "combat")}}selected{{/if}}>{{localize "GUM.Equipment.Reserve.Combat"}}</option><option value="power" {{#if (eq system.charge_reserve_type "power")}}selected{{/if}}>{{localize "GUM.Equipment.Reserve.Power"}}</option><option value="spell" {{#if (eq system.charge_reserve_type "spell")}}selected{{/if}}>{{localize "GUM.Equipment.Reserve.Spell"}}</option></select>{{#if equipmentUseChanges.reserveType.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentUseChanges.reserveType.finalLabel}}</span></div>{{/if}}</div></div></div>
                <div class="equipment-stat-card"><label class="equipment-stat-heading"><i class="fas fa-tag"></i><span>{{localize "GUM.Equipment.Reserve.Name"}}</span></label><div class="equipment-stat-control"><div class="equipment-calculated-value"><input type="text" name="system.charge_reserve_name" value="{{system.charge_reserve_name}}" placeholder="{{localize 'GUM.Equipment.Reserve.NamePlaceholder'}}" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>{{#if equipmentUseChanges.reserveName.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentUseChanges.reserveName.finalLabel}}</span></div>{{/if}}</div></div></div>
                <div class="equipment-stat-card"><label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Reserve.VisibilityHint'}}"><i class="fas fa-eye"></i><span>{{localize "GUM.Equipment.Reserve.Visibility"}}</span></label><div class="equipment-stat-control"><div class="equipment-calculated-value"><select name="system.charge_reserve_scope" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"><option value="any" {{#if (eq system.charge_reserve_scope "any")}}selected{{/if}}>{{localize "GUM.Equipment.Reserve.Any"}}</option><option value="carried" {{#if (eq system.charge_reserve_scope "carried")}}selected{{/if}}>{{localize "GUM.Equipment.Reserve.Carried"}}</option><option value="equipped" {{#if (eq system.charge_reserve_scope "equipped")}}selected{{/if}}>{{localize "GUM.Equipment.Reserve.Equipped"}}</option><option value="stored" {{#if (eq system.charge_reserve_scope "stored")}}selected{{/if}}>{{localize "GUM.Equipment.Reserve.Stored"}}</option><option value="active" {{#if (eq system.charge_reserve_scope "active")}}selected{{/if}}>{{localize "GUM.Equipment.Reserve.Active"}}</option></select>{{#if equipmentUseChanges.reserveScope.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentUseChanges.reserveScope.finalLabel}}</span></div>{{/if}}</div></div></div>
                <label class="equipment-stat-card equipment-consume-toggle" title="{{localize 'GUM.Equipment.Label.ChargeHint'}}">
                    <span class="equipment-stat-heading"><i class="fas fa-box-open"></i><span>{{localize "GUM.Equipment.Label.ConsumeUnit"}}</span></span>
                    <span class="equipment-toggle-pill"><input type="checkbox" name="system.consume_quantity_when_empty" {{checked system.consume_quantity_when_empty}}/><span>{{localize "GUM.Equipment.Label.Enabled"}}</span></span>
                </label>
            </div>
        </div>

        <div class="form-section skill-details-compact equipment-details-form">
            <h4 class="section-title">{{localize "GUM.Equipment.Details.UseDefense"}}</h4>
            <div class="equipment-defense-grid">
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Label.Holdout'}}"><i class="fas fa-user-secret"></i><span>{{localize "GUM.Equipment.Label.Holdout"}}</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.holdout" value="{{system.holdout}}" placeholder="0" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>
                            {{#if equipmentPropertyChanges.holdout.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.holdout.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Label.EquipTime'}}"><i class="fas fa-stopwatch"></i><span>{{localize "GUM.Equipment.Label.EquipTime"}}</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.equip_time" value="{{system.equip_time}}" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>
                            {{#if equipmentPropertyChanges.equip_time.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.equip_time.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="{{localize 'GUM.Equipment.Label.DefenseBonus'}}"><i class="fas fa-shield-alt"></i><span>{{localize "GUM.Equipment.Label.DefenseBonus"}}</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.defense_bonus" value="{{system.defense_bonus}}" title="{{localize 'GUM.Equipment.Label.BaseValue'}}"/>
                            {{#if equipmentPropertyChanges.defense_bonus.changed}}<div class="equipment-final-value" title="{{localize 'GUM.Equipment.Label.FinalValue'}}"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.defense_bonus.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>
                {{#if (and (eq item.type "equipment") (ne equipmentPropertyChanges.defense_bonus.final 0))}}
                <label class="equipment-stat-card equipment-defense-bonus-toggle" title="{{localize 'GUM.Equipment.Label.DefenseBonusActiveHint'}}">
                    <span class="equipment-stat-heading"><i class="fas fa-shield-alt"></i><span>{{localize "GUM.Equipment.Label.DefenseBonusActive"}}</span></span>
                    <span class="equipment-toggle-pill"><input type="checkbox" name="system.defense_bonus_active" {{checked system.defense_bonus_active}}/><span>{{localize "GUM.Equipment.Label.Enabled"}}</span></span>
                </label>
                {{/if}}
            </div>
        </div>

        {{#if (eq item.type "equipment")}}
        <div class="form-section skill-details-compact equipment-details-form">
            <h4 class="section-title">{{localize "GUM.Equipment.Details.Capacities"}}</h4>
            <div class="equipment-container-toggle">
                <label class="custom-checkbox inline-checkbox">
                    <input type="checkbox" name="system.is_container" {{checked system.is_container}} />
                    <i class="fas fa-box-open"></i>
                    <span>{{localize "GUM.Equipment.Label.Container"}}</span>
                </label>
            </div>

            <div class="equipment-capacity-grid">
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-weight-hanging"></i><span>{{localize "GUM.Equipment.Label.CapacityWeight"}}</span></label>
                    <div class="equipment-stat-control">
                        <input type="number" step="0.01" min="0" name="system.container.max_weight" value="{{system.container.max_weight}}" />
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-expand-arrows-alt"></i><span>{{localize "GUM.Equipment.Label.Width"}}</span></label>
                    <div class="equipment-stat-control">
                        <input type="number" step="0.1" min="0" name="system.container.dimensions_cm.width" value="{{system.container.dimensions_cm.width}}" />
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-expand-arrows-alt"></i><span>{{localize "GUM.Equipment.Label.Height"}}</span></label>
                    <div class="equipment-stat-control">
                        <input type="number" step="0.1" min="0" name="system.container.dimensions_cm.height" value="{{system.container.dimensions_cm.height}}" />
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-expand-arrows-alt"></i><span>{{localize "GUM.Equipment.Label.Depth"}}</span></label>
                    <div class="equipment-stat-control">
                        <input type="number" step="0.1" min="0" name="system.container.dimensions_cm.depth" value="{{system.container.dimensions_cm.depth}}" />
                    </div>
                </div>
            </div>
        </div>
        {{/if}}
    </div>
{{/inline}}

{{!-- ======================================================== --}}
{{!--        NOVA ABA DE EFEITOS (ESTRUTURA VERSÃO 3)        --}}
{{!-- ======================================================== --}}
{{#*inline "effectsTab"}}
    <div class="effects-tab-layout">
        <div class="effects-columns">

        {{!-- ================================================== --}}
        {{!-- EM SUCESSO --}}
        {{!-- ================================================== --}}
        <div class="effects-block">
            <div class="effects-block-header">
            <h4 class="effects-block-title">{{localize "GUM.ItemEffects.Success"}}</h4>
            <a class="effects-add-button add-effect" data-target-list="activationEffects.success" title="{{localize 'GUM.ItemEffects.AddSuccess'}}"><i class="fas fa-plus"></i></a>
            </div>

            <ol class="effects-line-list">
            {{#each system.preparedEffects.activation.success as |effect|}}
                <li class="effects-line-item" data-list-name="activationEffects.success" data-effect-id="{{effect.id}}">
                <div class="effects-line effects-line-basic">
                    {{!-- Coluna: ícone + nome --}}
                    <div class="effects-cell effects-identity">
                    <img src="{{effect.img}}" class="effects-icon" />
                    <div class="effects-text">
                        <div class="effects-name">{{effect.name}}</div>
                    </div>
                    </div>

                    {{!-- Coluna: destinatário --}}
                    <div class="effects-cell effects-recipient">
                    <div class="effects-label">{{localize "GUM.ItemEffects.Recipient"}}</div>
                    <select name="system.activationEffects.success.{{effect.id}}.recipient">
                        <option value="self" {{#if (eq effect.recipient 'self')}}selected{{/if}}>{{localize "GUM.ItemEffects.Self"}}</option>
                        <option value="target" {{#if (eq effect.recipient 'target')}}selected{{/if}}>{{localize "GUM.ItemEffects.Target"}}</option>
                    </select>
                    </div>

                    {{!-- Coluna: ações --}}
                    <div class="effects-cell effects-actions">
                    <span class="effects-controls">
                        <a class="view-original-effect" title="{{localize 'GUM.ItemEffects.ViewOriginal'}}" data-uuid="{{effect.uuid}}"><i class="fas fa-eye"></i></a>
                        <a class="delete-effect" title="{{localize 'GUM.ItemEffects.RemoveEffect'}}"><i class="fas fa-trash"></i></a>
                    </span>
                    </div>
                </div>
                </li>
            {{else}}
                <li class="effects-empty">{{localize "GUM.ItemEffects.NoEffect"}}</li>
            {{/each}}
            </ol>
            {{#if canUseItemAttachmentDrops}}<div class="item-attachment-dropzone" data-attachment-type="effect" data-target-list="activationEffects.success"><i class="fas fa-arrow-down" aria-hidden="true"></i><span>{{localize "GUM.ItemAttachments.DropEffect"}}</span></div>{{/if}}

        </div>

        {{!-- ================================================== --}}
        {{!-- EM FALHA --}}
        {{!-- ================================================== --}}
        <div class="effects-block">
            <div class="effects-block-header">
            <h4 class="effects-block-title">{{localize "GUM.ItemEffects.Failure"}}</h4>
            <a class="effects-add-button add-effect" data-target-list="activationEffects.failure" title="{{localize 'GUM.ItemEffects.AddFailure'}}"><i class="fas fa-plus"></i></a>
            </div>

            <ol class="effects-line-list">
            {{#each system.preparedEffects.activation.failure as |effect|}}
