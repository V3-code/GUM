{{#*inline "magicConsumptionEditor"}}
<div class="skill-dashboard-section magic-consumption-editor">
    <div class="magic-consumption-editor__header">
        <h4 class="skill-dashboard-section-title"><i class="fas fa-battery-quarter" aria-hidden="true"></i> {{localize "GUM.MagicConsumption.Title"}}</h4>
        <button type="button" class="add-magic-consumption-group"><i class="fas fa-plus"></i> {{localize "GUM.MagicConsumption.AddGroup"}}</button>
    </div>
    <p class="magic-consumption-editor__hint">{{localize "GUM.MagicConsumption.EditorHint"}}</p>
    <datalist id="magic-consumption-source-names">
        {{#each magicConsumptionSourceOptions as |option|}}<option value="{{option.name}}" data-source-key="{{option.key}}" data-source-type="{{option.type}}">{{option.type}} · {{option.current}}</option>{{/each}}
    </datalist>
    {{#each consumptionGroups as |group|}}
    <article class="magic-consumption-group" data-consumption-group-id="{{group.id}}">
        <header class="magic-consumption-group__header">
            <label class="magic-consumption-group__name">
                <i class="fas fa-coins" aria-hidden="true"></i>
                <input type="text" name="system.consumptionGroups.{{group.id}}.name" value="{{group.name}}" placeholder="{{localize 'GUM.MagicConsumption.GroupName'}}" aria-label="{{localize 'GUM.MagicConsumption.GroupName'}}"/>
            </label>
            <button type="button" class="delete-magic-consumption-group" title="{{localize 'GUM.MagicConsumption.DeleteGroup'}}"><i class="fas fa-trash"></i></button>
        </header>
        <div class="spell-power-core-grid magic-consumption-group__main">
            <div class="skill-dashboard-card skill-dashboard-field-card">
                <div class="skill-dashboard-card-heading"><i class="fas fa-flag-checkered" aria-hidden="true"></i><span>{{localize "GUM.MagicConsumption.Trigger"}}</span></div>
                <div class="skill-dashboard-card-control">
                    <select name="system.consumptionGroups.{{group.id}}.trigger" aria-label="{{localize 'GUM.MagicConsumption.Trigger'}}">
                        <option value="attempt" {{#if (eq group.trigger "attempt")}}selected{{/if}}>{{localize "GUM.MagicConsumption.TriggerAttempt"}}</option>
                        <option value="success" {{#if (eq group.trigger "success")}}selected{{/if}}>{{localize "GUM.MagicConsumption.TriggerSuccess"}}</option>
                        <option value="failure" {{#if (eq group.trigger "failure")}}selected{{/if}}>{{localize "GUM.MagicConsumption.TriggerFailure"}}</option>
                    </select>
                </div>
            </div>
            <div class="skill-dashboard-card skill-dashboard-field-card">
                <div class="skill-dashboard-card-heading"><i class="fas fa-hashtag" aria-hidden="true"></i><span>{{localize "GUM.MagicConsumption.Amount"}}</span></div>
                <div class="skill-dashboard-card-control">
                    <input type="number" min="0.000001" step="any" name="system.consumptionGroups.{{group.id}}.amount" value="{{group.amount}}" aria-label="{{localize 'GUM.MagicConsumption.Amount'}}"/>
                </div>
            </div>
        </div>
        <div class="skill-dashboard-toggles magic-consumption-group__options">
            <label class="skill-dashboard-toggle-card">
                <i class="fas fa-pen-to-square skill-dashboard-toggle-icon" aria-hidden="true"></i>
                <span class="skill-dashboard-toggle-label">{{localize "GUM.MagicConsumption.VariableAmount"}}</span>
                <input type="checkbox" name="system.consumptionGroups.{{group.id}}.variableAmount" {{checked group.variableAmount}}>
            </label>
            <label class="skill-dashboard-toggle-card">
                <i class="fas fa-circle-question skill-dashboard-toggle-icon" aria-hidden="true"></i>
                <span class="skill-dashboard-toggle-label">{{localize "GUM.MagicConsumption.Confirm"}}</span>
                <input type="checkbox" name="system.consumptionGroups.{{group.id}}.confirm" {{checked group.confirm}}>
            </label>
        </div>
        <div class="magic-consumption-sources">
            <div class="magic-consumption-sources__header">
                <strong><i class="fas fa-code-branch" aria-hidden="true"></i> {{localize "GUM.MagicConsumption.AlternativeSources"}}</strong>
                <button type="button" class="add-magic-consumption-source" title="{{localize 'GUM.MagicConsumption.AlternativeSources'}}"><i class="fas fa-plus"></i></button>
            </div>
            {{#each group.sources as |source|}}
            <div class="skill-dashboard-card magic-consumption-source" data-consumption-source-id="{{source.id}}">
                <div class="skill-dashboard-card-control magic-consumption-source__controls">
                    <select class="magic-consumption-source-type" name="system.consumptionGroups.{{group.id}}.sources.{{source.id}}.type" aria-label="{{localize 'GUM.MagicConsumption.PaymentSource'}}">
                        <option value="hp" {{#if (eq source.type "hp")}}selected{{/if}}>{{localize "GUM.MagicConsumption.SourceHP"}}</option>
                        <option value="fp" {{#if (eq source.type "fp")}}selected{{/if}}>{{localize "GUM.MagicConsumption.SourceFP"}}</option>
                        <option value="spell_reserve" {{#if (eq source.type "spell_reserve")}}selected{{/if}}>{{localize "GUM.MagicConsumption.SourceSpellReserve"}}</option>
                        <option value="power_reserve" {{#if (eq source.type "power_reserve")}}selected{{/if}}>{{localize "GUM.MagicConsumption.SourcePowerReserve"}}</option>
                        <option value="combat_tracker" {{#if (eq source.type "combat_tracker")}}selected{{/if}}>{{localize "GUM.MagicConsumption.SourceCombatTracker"}}</option>
                        <option value="item_quantity" {{#if (eq source.type "item_quantity")}}selected{{/if}}>{{localize "GUM.MagicConsumption.SourceItemQuantity"}}</option>
                    </select>
                    <input class="magic-consumption-source-name" type="text" list="magic-consumption-source-names" name="system.consumptionGroups.{{group.id}}.sources.{{source.id}}.name" value="{{source.name}}" placeholder="{{localize 'GUM.MagicConsumption.SourceNameHint'}}" aria-label="{{localize 'GUM.MagicConsumption.SourceNameHint'}}" {{#if (or (eq source.type "hp") (eq source.type "fp"))}}disabled{{/if}}/>
                    <input class="magic-consumption-source-key" type="hidden" name="system.consumptionGroups.{{group.id}}.sources.{{source.id}}.sourceKey" value="{{source.sourceKey}}"/>
                </div>
                <button type="button" class="delete-magic-consumption-source" title="{{localize 'GUM.MagicConsumption.DeleteSource'}}"><i class="fas fa-times"></i></button>
            </div>
            {{/each}}
        </div>
    </article>
    {{else}}
    <p class="magic-consumption-editor__empty">{{localize "GUM.MagicConsumption.Empty"}}</p>
    {{/each}}
</div>
{{/inline}}

{{!-- ============================================= --}}
{{!-- INÍCIO DA ESTRUTURA DAS FICHAS                --}}
{{!-- ============================================= --}}
<form class="{{cssClass}} gum-item-sheet effect-sheet" autocomplete="off">

{{!-- Cabeçalho da Ficha --}}
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
  <div class="header-info">
    <div class="header-main-line">
      <textarea name="name" rows="1" placeholder="{{localize 'GUM.Equipment.Header.ItemName'}}">{{item.name}}</textarea>
    </div>
    <div class="header-subline">
      <span class="item-type-tag">{{#if (eq item.type "equipment")}}{{localize "GUM.Equipment.Header.Equipment"}}{{else if (eq item.type "eqp_modifier")}}{{localize "GUM.Equipment.Header.Modifier"}}{{else if (eq item.type "spell")}}{{localize "GUM.SpellPower.ItemTypeSpell"}}{{else if (eq item.type "power")}}{{localize "GUM.SpellPower.ItemTypePower"}}{{else}}{{lookup (object
        melee_weapon="Arma C.C." ranged_weapon="Arma L.D."
        equipment="Equipamento" skill="Perícia"
        advantage="Vantagem" disadvantage="Desvantagem" modifier="Modificador" eqp_modifier="Mod. Equip." gm_modifier="GM MOD") item.type}}{{/if}}</span>
    </div>
    <span class="header-divider" aria-hidden="true"></span>
  </div>
</header>

{{!-- NOVA ESTRUTURA COM ABAS --}}
<section class="sheet-content">

  {{!-- 1. Navegação das Abas (CORRIGIDA) --}}
  <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-tab="description">{{localize "GUM.Equipment.Tab.Description"}}</a>
        {{#unless (eq item.type "eqp_modifier")}}<a class="item" data-tab="details">{{localize "GUM.Equipment.Tab.Details"}}</a>{{/unless}}
        {{#if (eq item.type "eqp_modifier")}}
        <a class="item" data-tab="adjustments">{{localize "GUM.EquipmentModifier.Tab.Adjustments"}}</a>
        <a class="item" data-tab="equipment-features">{{localize "GUM.EquipmentModifier.Tab.Features"}}</a>
        {{/if}}
        {{#if (or (eq item.type "advantage") (eq item.type "disadvantage"))}}
        <a class="item" data-tab="social">{{localize "GUM.Social.Tab"}}</a>
        {{/if}}

        {{#if (eq item.type "spell")}}
        <a class="item" data-tab="casting">{{localize "GUM.SpellPower.TabCasting"}}</a>
        {{/if}}
        {{#if (eq item.type "power")}}
        <a class="item" data-tab="activation">{{localize "GUM.SpellPower.TabActivation"}}</a>
        {{/if}}
       
        {{!-- Bloco 2: Aba "Modos de Ataque" para Equipamentos --}}
        {{#if (eq item.type "equipment")}}
        <a class="item" data-tab="attacks">{{localize "GUM.Equipment.Tab.Attacks"}}</a>
        {{/if}}

        {{!-- Bloco 2.1: Aba "Proteção" para Equipamentos --}}
        {{#if (eq item.type "equipment")}}
        <a class="item" data-tab="protection">{{localize "GUM.Equipment.Tab.Protection"}}</a>
        {{/if}}
        
        {{!-- Bloco 3: Aba "Efeitos" (lógica original) --}}
        {{#if (or (eq item.type "skill") (eq item.type "spell") (eq item.type "power") (eq item.type "equipment") (eq item.type "advantage") (eq item.type "disadvantage"))}}
        <a class="item" data-tab="effects">{{localize "GUM.Equipment.Tab.Effects"}}</a>
        {{/if}}
        
        {{!-- Bloco 4: Aba "Modificadores" (lógica original) --}}
        {{#if (or (eq item.type "advantage") (eq item.type "disadvantage") (eq item.type "power"))}}
        <a class="item" data-tab="modifiers">Modificadores</a>
        {{/if}}
 

        {{!-- Aba Pré-definido para Perícias --}}
        {{#if (eq item.type "skill")}}
        <a class="item" data-tab="predefined">Pré-definido</a>
        {{/if}}

        {{!-- Aba Mods para Equipamentos e Armaduras --}}
        {{#if (eq item.type "equipment")}}
