            <div class="tab active" data-tab="description" data-group="primary">
                <div class="description-tab">
                    <div class="description-grid">

                        <div
                            class="form-group"
                            style="flex-direction: row; text-align: center;"
                        >
                            <label title="{{localize 'GUM.EffectSheet.BookPageReference'}}">
                                <a class="open-reference-link" title="{{localize 'GUM.EffectSheet.OpenReference'}}">
                                    <i class="fas fa-book-open"></i>
                                </a>
                                REF
                            </label>

                            <div class="input-row">
                                <input
                                    type="text"
                                    name="system.ref"
                                    value="{{system.ref}}"
                                    placeholder="{{localize 'GUM.EffectSheet.ExampleReference'}}"
                                />
                            </div>
                        </div>

                        <div class="form-section description-section itemdesc-block">
                            <details class="itemdesc-panel" open>
                                <summary class="itemdesc-block-header">
                                    <h4 class="itemdesc-block-title">
                                        {{localize "GUM.EffectSheet.ChatSummary"}}
                                    </h4>
                                </summary>

                                {{#if editable}}
                                    <span class="itemdesc-header-actions">
                                        <button
                                            type="button"
                                            class="toggle-editor itemdesc-edit-button"
                                            data-field="system.chat_description"
                                        >
                                            <i class="fas fa-pen"></i>
                                        </button>
                                    </span>
                                {{/if}}

                                <div class="itemdesc-content">
                                    <div class="description-view itemdesc-inner">
                                        {{{enrichedChatDescription}}}
                                    </div>

                                    <div
                                        class="description-editor itemdesc-inner"
                                        style="display: none;"
                                    >
                                        {{editor
                                            system.chat_description
                                            target="system.chat_description"
                                            engine="prosemirror"
                                            owner=owner
                                            editable=editable
                                        }}

                                        <div class="description-actions">
                                            <button
                                                type="button"
                                                class="save-description"
                                                data-field="system.chat_description"
                                            >
                                                <i class="fas fa-save"></i>
                                                {{localize "GUM.EffectSheet.Save"}}
                                            </button>

                                            <button
                                                type="button"
                                                class="expand-description"
                                                data-expanded="false"
                                            >
                                                <i class="fas fa-expand"></i>
                                                {{localize "GUM.EffectSheet.Expand"}}
                                            </button>

                                            <button
                                                type="button"
                                                class="cancel-description"
                                            >
                                                <i class="fas fa-times"></i>
                                                {{localize "GUM.EffectSheet.Cancel"}}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </details>
                        </div>

                        <div class="form-section description-section itemdesc-block">
                            <details class="itemdesc-panel" open>
                                <summary class="itemdesc-block-header">
                                    <h4 class="itemdesc-block-title">
                                        {{localize "GUM.EffectSheet.FullDescription"}}
                                    </h4>
                                </summary>

                                {{#if editable}}
                                    <span class="itemdesc-header-actions">
                                        <button
                                            type="button"
                                            class="toggle-editor itemdesc-edit-button"
                                            data-field="system.description"
                                        >
                                            <i class="fas fa-pen"></i>
                                        </button>
                                    </span>
                                {{/if}}

                                <div class="itemdesc-content">
                                    <div class="description-view itemdesc-inner">
                                        {{{enrichedDescription}}}
                                    </div>

                                    <div
                                        class="description-editor itemdesc-inner"
                                        style="display: none;"
                                    >
                                        {{editor
                                            system.description
                                            target="system.description"
                                            engine="prosemirror"
                                            owner=owner
                                            editable=editable
                                        }}

                                        <div class="description-actions">
                                            <button
                                                type="button"
                                                class="save-description"
                                                data-field="system.description"
                                            >
                                                <i class="fas fa-save"></i>
                                                {{localize "GUM.EffectSheet.Save"}}
                                            </button>

                                            <button
                                                type="button"
                                                class="expand-description"
                                                data-expanded="false"
                                            >
                                                <i class="fas fa-expand"></i>
                                                {{localize "GUM.EffectSheet.Expand"}}
                                            </button>

                                            <button
                                                type="button"
                                                class="cancel-description"
                                            >
                                                <i class="fas fa-times"></i>
                                                {{localize "GUM.EffectSheet.Cancel"}}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </details>
                        </div>
                    </div>
                </div>
            </div>

