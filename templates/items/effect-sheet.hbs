<form class="{{cssClass}} gum-item-sheet effect-sheet" autocomplete="off">

    {{!-- ========================================================= --}}
    {{!-- CABEÇALHO                                                  --}}
    {{!-- ========================================================= --}}
    <header class="sheet-header">
        <img
            class="profile-img"
            src="{{item.img}}"
            data-edit="img"
            title="{{item.name}}"
        />

        <div class="header-info">
            <div class="header-main-line">
                <textarea
                    name="name"
                    rows="1"
                    placeholder="{{localize 'GUM.EffectSheet.ItemName'}}"
                >{{item.name}}</textarea>
            </div>

            <div class="header-subline">
                <span class="item-type-tag">{{localize "GUM.EffectSheet.Effect"}}</span>
            </div>

            <span class="header-divider" aria-hidden="true"></span>
        </div>
    </header>

    {{!-- ========================================================= --}}
    {{!-- ABAS                                                       --}}
    {{!-- ========================================================= --}}
    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item active" data-tab="description">{{localize "GUM.EffectSheet.Description"}}</a>
        <a class="item" data-tab="configuracao">{{localize "GUM.EffectSheet.Configuration"}}</a>
        <a class="item" data-tab="efeitos-ativos">{{localize "GUM.EffectSheet.ActiveEffects"}}</a>
        <a class="item" data-tab="regiao-dinamica">{{localize "GUM.DynamicRegion.Tab"}}</a>
    </nav>

    <main class="sheet-body">
        <div class="sheet-body-content effect-sheet-body">

            {{! ===================================================== }}
            {{! ABA: EFEITOS ATIVOS                                   }}
            {{! ===================================================== }}
            <div class="tab" data-tab="efeitos-ativos" data-group="primary">
                <section class="effect-premium-workspace">

                    <div class="effect-premium-toolbar">
                        <div class="effect-premium-toolbar-title">

                            <div class="effect-premium-toolbar-copy">
                                <h4>{{localize "GUM.EffectSheet.EffectActions"}}</h4>
                                <span class="effect-premium-toolbar-subtitle">
                                    {{localize "GUM.EffectSheet.EffectActionsHint"}}
                                </span>
                            </div>

                            <span class="effect-premium-count">
                                {{effectActionsCountLabel}}
                            </span>
                        </div>

                        <button
                            type="button"
                            class="add-effect-action effect-premium-add-action"
                        >
                            <i class="fas fa-plus" aria-hidden="true"></i>
                            {{localize "GUM.EffectSheet.AddAction"}}
                        </button>
                    </div>

                    {{#if effectActions.length}}
                        <div class="effect-premium-action-list">

                            {{#each effectActions as |action|}}
                                <details
                                    class="effect-action-details effect-premium-action"
                                    data-action-index="{{action.index}}"
                                    {{#if action.isExpanded}}open{{/if}}
                                >
                                    <summary class="effect-premium-action-header">
                                        <span class="effect-premium-action-number">
                                            {{action.displayIndex}}
                                        </span>

                                        <div class="effect-premium-action-copy">
                                            <div class="effect-premium-action-title-row">
                                                <span class="effect-premium-action-title">
                                                    {{action.titleText}}
                                                </span>

                                                <span class="effect-premium-action-type {{action.typeClass}}">
                                                    <i class="{{action.typeIcon}}" aria-hidden="true"></i>
                                                    {{action.typeLabel}}
                                                </span>
                                            </div>

                                            <span class="effect-premium-action-meta">
                                                {{action.summaryText}}
                                            </span>
                                        </div>

                                        <div class="effect-premium-action-controls">
                                            <button
                                                type="button"
                                                class="remove-effect-action js-summary-action effect-premium-icon-button"
                                                data-index="{{action.index}}"
                                                title="{{localize 'GUM.EffectSheet.RemoveAction'}}"
                                                aria-label="{{localize 'GUM.EffectSheet.RemoveAction'}} {{action.displayIndex}}"
                                            >
                                                <i class="fas fa-trash" aria-hidden="true"></i>
                                            </button>

                                            <i
                                                class="fas fa-chevron-down effect-premium-chevron"
                                                aria-hidden="true"
                                            ></i>
                                        </div>
                                    </summary>

                                    <div class="effect-premium-action-body">
                                        <input type="hidden" name="system.actions.{{action.index}}.id" value="{{action.id}}" />

                                        {{!-- IDENTIFICAÇÃO DA AÇÃO --}}
                                        <div class="effect-premium-identification-grid">

                                            <div class="effect-premium-field">
                                                <label class="effect-premium-field-label">
                                                    <i class="fas fa-tag" aria-hidden="true"></i>
                                                    {{localize "GUM.EffectSheet.AppliedEffectName"}}
                                                </label>

                                                <div class="effect-premium-field-control">
                                                    <input
                                                        type="text"
                                                        name="system.actions.{{action.index}}.label"
                                                        value="{{action.label}}"
                                                         placeholder="{{localize 'GUM.EffectSheet.ExampleStPenalty'}}"
                                                    />
                                                    <p class="effect-premium-field-hint">
                                                        {{localize "GUM.EffectSheet.AppliedEffectNameHint"}}
                                                    </p>
                                                </div>
                                            </div>

                                            <div class="effect-premium-field">
                                                <label class="effect-premium-field-label">
                                                    <i class="fas fa-layer-group" aria-hidden="true"></i>
                                                    {{localize "GUM.EffectSheet.Type"}}
                                                </label>

                                                <div class="effect-premium-field-control">
                                                    <select name="system.actions.{{action.index}}.type">
                                                        <option
                                                            value="attribute"
                                                            {{#if (eq action.type "attribute")}}selected{{/if}}
                                                        >
                                                            {{localize "GUM.EffectSheet.AttributeModifier"}}
                                                        </option>

                                                        <option
                                                            value="status"
                                                            {{#if (eq action.type "status")}}selected{{/if}}
                                                        >
                                                            {{localize "GUM.EffectSheet.Status"}}
                                                        </option>

                                                        <option
                                                            value="resource_change"
                                                            {{#if (eq action.type "resource_change")}}selected{{/if}}
                                                        >
                                                            {{localize "GUM.EffectSheet.ResourceChange"}}
                                                        </option>

                                                        <option
                                                            value="resource_create"
                                                            {{#if (eq action.type "resource_create")}}selected{{/if}}
                                                        >
                                                            {{localize "GUM.EffectSheet.CreateResource"}}
                                                        </option>

                                                        <option
                                                            value="roll_modifier"
                                                            {{#if (eq action.type "roll_modifier")}}selected{{/if}}
                                                        >
                                                            {{localize "GUM.EffectSheet.RollModifier"}}
                                                        </option>

                                                        <option value="skill_modifier" {{#if (eq action.type "skill_modifier")}}selected{{/if}}>
                                                            {{localize "GUM.EffectSheet.ActionType.SkillModifier"}}
                                                        </option>

                                                        <option value="combat_modifier" {{#if (eq action.type "combat_modifier")}}selected{{/if}}>
                                                            {{localize "GUM.EffectSheet.CombatModeModifier"}}
                                                        </option>

                                                        <option value="damage_roll" {{#if (eq action.type "damage_roll")}}selected{{/if}}>
                                                            {{localize "GUM.EffectSheet.DamageRoll"}}
                                                        </option>

                                                        <option
                                                            value="chat"
                                                            {{#if (eq action.type "chat")}}selected{{/if}}
                                                        >
                                                            {{localize "GUM.EffectSheet.ChatMessage"}}
                                                        </option>

                                                        <option
                                                            value="macro"
                                                            {{#if (eq action.type "macro")}}selected{{/if}}
                                                        >
                                                            {{localize "GUM.EffectSheet.Macro"}}
                                                        </option>

                                                        <option
                                                            value="flag"
                                                            {{#if (eq action.type "flag")}}selected{{/if}}
                                                        >
                                                            {{localize "GUM.EffectSheet.Flag"}}
                                                        </option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div
                                            class="
                                                effect-premium-type-panel
                                                {{#if (eq action.type "roll_modifier")}}is-complex{{/if}}
                                                {{#if (eq action.type "skill_modifier")}}is-complex{{/if}}
                                                {{#if (eq action.type "combat_modifier")}}is-complex{{/if}}
                                                {{#if (eq action.type "damage_roll")}}is-complex is-damage{{/if}}
                                                {{#if (eq action.type "chat")}}is-chat{{/if}}
                                            "
                                        >
                                            {{! ============================================= }}
                                            {{! TIPO: MODIFICADOR DE ATRIBUTO                  }}
                                            {{! ============================================= }}
                                            {{#if (eq action.type "attribute")}}
                                                <div class="effect-premium-grid effect-premium-grid-attribute-main">

                                                    <div class="effect-premium-field is-primary">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-code-branch" aria-hidden="true"></i>
                                                            {{localize "GUM.EffectSheet.Path"}}
                                                        </label>

                                                        <div class="effect-premium-field-control">
                                                            <div class="effect-path-input-row">
                                                                <input
                                                                    type="text"
                                                                    class="effect-code-input"
                                                                    name="system.actions.{{action.index}}.path"
                                                                    value="{{action.path}}"
                                                                    placeholder="{{localize 'GUM.EffectSheet.ExampleAttributePath'}}"
                                                                />
                                                                <button type="button" class="open-effect-path-picker effect-premium-icon-button" data-target-input="system.actions.{{action.index}}.path" data-operation-input="system.actions.{{action.index}}.operation" title="{{localize 'GUM.EffectSheet.SelectSupportedPath'}}" aria-label="{{localize 'GUM.EffectSheet.SelectPath'}}"><i class="fas fa-sitemap" aria-hidden="true"></i></button>
                                                            </div>
                                                            <p class="effect-premium-field-hint">{{localize "GUM.EffectSheet.PathHint"}}</p>
                                                        </div>
                                                    </div>

                                                    <div class="effect-premium-field">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-calculator" aria-hidden="true"></i>
                                                            {{localize "GUM.EffectSheet.Operation"}}
                                                        </label>

                                                        <div class="effect-premium-field-control">
                                                            <select name="system.actions.{{action.index}}.operation">
                                                                <option
                                                                    value="ADD"
                                                                    {{#if (eq action.operation "ADD")}}selected{{/if}}
                                                                >
                                                                    ADD/SUB
                                                                </option>

                                                                <option
                                                                    value="OVERRIDE"
                                                                    {{#if (eq action.operation "OVERRIDE")}}selected{{/if}}
                                                                >
                                                                    {{localize "GUM.EffectSheet.Set"}}
                                                                </option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="effect-premium-grid effect-premium-grid-single">
                                                    <div class="effect-premium-field effect-premium-expression-card">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-code" aria-hidden="true"></i>
                                                              {{#if (eq action.value_mode "per_origin_level")}}{{localize "GUM.EffectSheet.ValuePerLevel"}}{{else}}{{localize "GUM.EffectSheet.ValueOrExpression"}}{{/if}}
                                                        </label>

                                                        <div class="effect-premium-field-control">
                                                            <textarea
                                                                rows="1"
                                                                class="effect-code-input effect-expression-input effect-resizable-code-input"
                                                                name="system.actions.{{action.index}}.value"
                                                                placeholder="{{localize 'GUM.EffectSheet.ExampleValueExpression'}}"
                                                                title="{{localize 'GUM.EffectSheet.ValueFormulaDiceHint'}}"
                                                                aria-describedby="effect-attribute-value-help-{{action.index}}"
                                                            >{{action.value}}</textarea>

                                                            <p
                                                                id="effect-attribute-value-help-{{action.index}}"
                                                                class="effect-premium-field-hint"
                                                            >
                                                                {{localize "GUM.EffectSheet.EvaluatedOnApplyPrefix"}} <code>se(possui("Item"), 2, 1)</code>, <code>nivel("Item")</code>, <code>quantidade("Item")</code>, <code>equipado("Item")</code> {{localize "GUM.EffectSheet.And"}} <code>status("id")</code>.
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                 <div class="effect-premium-grid effect-premium-grid-single">
                                                    <div class="effect-premium-field">
                                                        <label class="effect-premium-field-label">{{localize "GUM.EffectSheet.ValueScaling"}}</label>
                                                        <div class="effect-premium-field-control">
                                                            <select name="system.actions.{{action.index}}.value_mode">
                                                                <option value="fixed" {{#if (eq action.value_mode "fixed")}}selected{{/if}}>{{localize "GUM.EffectSheet.FixedValue"}}</option>
                                                                <option value="per_origin_level" {{#if (eq action.value_mode "per_origin_level")}}selected{{/if}}>{{localize "GUM.EffectSheet.PerSourceItemLevel"}}</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="effect-premium-grid effect-premium-grid-single">
                                                    <div class="effect-premium-field">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-message" aria-hidden="true"></i>
                                                            {{localize "GUM.EffectSheet.ChatValueDisplay"}}
                                                        </label>
                                                        <div class="effect-premium-field-control">
                                                            <select name="system.actions.{{action.index}}.attribute_chat_visibility">
                                                                <option value="public" {{#if (eq action.attribute_chat_visibility "public")}}selected{{/if}}>{{localize "GUM.EffectSheet.Public"}}</option>
                                                                <option value="owners" {{#if (eq action.attribute_chat_visibility "owners")}}selected{{/if}}>{{localize "GUM.EffectSheet.PrivateOwnersGM"}}</option>
                                                                <option value="gm" {{#if (eq action.attribute_chat_visibility "gm")}}selected{{/if}}>{{localize "GUM.EffectSheet.GMOnlyBlind"}}</option>
                                                                <option value="none" {{#if (eq action.attribute_chat_visibility "none")}}selected{{/if}}>{{localize "GUM.EffectSheet.DoNotShow"}}</option>
                                                            </select>
                                                            <p class="effect-premium-field-hint">{{localize "GUM.EffectSheet.VisibilityHint"}}</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            {{/if}}

                                            {{! TIPO: MODIFICAR HABILIDADES (legado: skill_modifier) }}
                                            {{#if (eq action.type "skill_modifier")}}
                                                <div class="effect-premium-roll-compact effect-specialized-action effect-ability-modifier">
                                                    <div class="effect-specialized-grid effect-ability-primary-grid">
                                                        <div class="effect-premium-field">
                                                            <label class="effect-premium-field-label">{{localize "GUM.EffectSheet.AbilityType"}}</label>
                                                            <div class="effect-premium-field-control">
                                                                <select name="system.actions.{{action.index}}.ability_kind">
                                                                    <option value="skill" {{#if (eq action.ability_kind "skill")}}selected{{/if}}>{{localize "GUM.EffectSheet.AbilityKind.skill"}}</option>
                                                                    <option value="spell" {{#if (eq action.ability_kind "spell")}}selected{{/if}}>{{localize "GUM.EffectSheet.AbilityKind.spell"}}</option>
                                                                    <option value="power" {{#if (eq action.ability_kind "power")}}selected{{/if}}>{{localize "GUM.EffectSheet.AbilityKind.power"}}</option>
                                                                    <option value="all" {{#if (eq action.ability_kind "all")}}selected{{/if}}>{{localize "GUM.EffectSheet.AbilityKind.all"}}</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="effect-premium-field">
                                                            <label class="effect-premium-field-label">{{localize "GUM.EffectSheet.Affect"}}</label>
                                                            <div class="effect-premium-field-control">
                                                                <select name="system.actions.{{action.index}}.skill_scope">
                                                                    <option value="all" {{#if (eq action.skill_scope "all")}}selected{{/if}}>{{localize "GUM.EffectSheet.AllAbilities"}}</option>
                                                                    <option value="specific" {{#if (eq action.skill_scope "specific")}}selected{{/if}}>{{localize "GUM.EffectSheet.SpecificTypes"}}</option>
                                                                    <option value="attribute" {{#if (eq action.skill_scope "attribute")}}selected{{/if}}>{{localize "GUM.EffectSheet.AttributeBasedAbilities"}}</option>
                                                                    <option value="classification" {{#if (eq action.skill_scope "classification")}}selected{{/if}}>{{localize "GUM.EffectSheet.ClassifiedAbilities"}}</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="effect-ability-scope-body">
                                                        <div class="effect-premium-field effect-ability-specific-field" data-ability-scope="specific" {{#unless (eq action.skill_scope "specific")}}hidden{{/unless}}>
                                                            <label class="effect-premium-field-label">{{localize "GUM.EffectSheet.SpecificTypes"}}</label>
                                                            <div class="effect-premium-field-control">
                                                                <input type="text" name="system.actions.{{action.index}}.skill_targets" value="{{action.skill_targets}}" placeholder="{{localize 'GUM.EffectSheet.ExampleAbilities'}}" {{#unless (eq action.skill_scope "specific")}}disabled{{/unless}}/>
                                                            </div>
                                                        </div>
                                                        <div class="effect-premium-field effect-ability-attribute-field" data-ability-scope="attribute" {{#unless (eq action.skill_scope "attribute")}}hidden{{/unless}}>
                                                            <label class="effect-premium-field-label">{{localize "GUM.EffectSheet.BaseAttribute"}}</label>
                                                            <div class="effect-premium-field-control">
                                                                <select name="system.actions.{{action.index}}.skill_attribute" {{#unless (eq action.skill_scope "attribute")}}disabled{{/unless}}><option value="st" {{#if (eq action.skill_attribute "st")}}selected{{/if}}>ST</option><option value="dx" {{#if (eq action.skill_attribute "dx")}}selected{{/if}}>DX</option><option value="iq" {{#if (eq action.skill_attribute "iq")}}selected{{/if}}>IQ</option><option value="ht" {{#if (eq action.skill_attribute "ht")}}selected{{/if}}>HT</option><option value="per" {{#if (eq action.skill_attribute "per")}}selected{{/if}}>Per</option><option value="vont" {{#if (eq action.skill_attribute "vont")}}selected{{/if}}>Vont</option></select>
                                                            </div>
                                                        </div>
                                                        <div class="effect-specialized-grid effect-specialized-grid-two effect-ability-classification-grid" data-ability-scope="classification" {{#unless (eq action.skill_scope "classification")}}hidden{{/unless}}>
                                                            <div class="effect-premium-field"><label class="effect-premium-field-label">{{localize "GUM.SpellPower.Source"}}</label><div class="effect-premium-field-control"><input type="text" name="system.actions.{{action.index}}.ability_sources" value="{{action.ability_sources}}" placeholder="{{localize 'GUM.EffectSheet.ExampleAbilitySources'}}" {{#unless (eq action.skill_scope "classification")}}disabled{{/unless}}/></div></div>
                                                            <div class="effect-premium-field"><label class="effect-premium-field-label">{{localize "GUM.EffectSheet.ClassificationGroup"}}</label><div class="effect-premium-field-control"><input type="text" name="system.actions.{{action.index}}.ability_groups" value="{{action.ability_groups}}" placeholder="{{localize 'GUM.EffectSheet.ExampleAbilityGroups'}}" {{#unless (eq action.skill_scope "classification")}}disabled{{/unless}}/></div></div>
                                                            <div class="effect-premium-field"><label class="effect-premium-field-label">{{localize "GUM.EffectSheet.SheetGroup"}}</label><div class="effect-premium-field-control"><input type="text" name="system.actions.{{action.index}}.ability_sheet_groups" value="{{action.ability_sheet_groups}}" placeholder="{{localize 'GUM.EffectSheet.ExampleAbilitySheetGroups'}}" {{#unless (eq action.skill_scope "classification")}}disabled{{/unless}}/></div></div>
                                                            <div class="effect-premium-field"><label class="effect-premium-field-label">{{localize "GUM.SpellPower.School"}}</label><div class="effect-premium-field-control"><input type="text" name="system.actions.{{action.index}}.ability_schools" value="{{action.ability_schools}}" placeholder="{{localize 'GUM.EffectSheet.ExampleAbilitySchools'}}" {{#unless (eq action.skill_scope "classification")}}disabled{{/unless}}/></div></div>
                                                            <div class="effect-premium-field"><label class="effect-premium-field-label">{{localize "GUM.SpellPower.Class"}}</label><div class="effect-premium-field-control"><input type="text" name="system.actions.{{action.index}}.ability_classes" value="{{action.ability_classes}}" placeholder="{{localize 'GUM.EffectSheet.ExampleAbilityClasses'}}" {{#unless (eq action.skill_scope "classification")}}disabled{{/unless}}/></div></div>
                                                        </div>
                                                    </div>

                                                    <div class="effect-premium-field effect-ability-value-field">
                                                            <label class="effect-premium-field-label"><i class="fas fa-plus"></i> {{localize "GUM.EffectSheet.Value"}}</label>
                                                            <div class="effect-premium-field-control"><textarea rows="1" class="effect-code-input effect-resizable-code-input effect-ability-value-input" name="system.actions.{{action.index}}.modifier_value" placeholder="{{localize 'GUM.EffectSheet.ExampleConditionalBonus'}}">{{action.modifier_value}}</textarea><p class="effect-premium-field-hint">{{localize "GUM.EffectSheet.ConditionalValueHint"}}</p></div>
                                                    </div>

                                                    <div class="effect-specialized-grid effect-ability-options-grid">
                                                        <div class="effect-premium-field">
                                                            <label class="effect-premium-field-label">{{localize "GUM.EffectSheet.Scaling"}}</label>
                                                            <div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.modifier_value_mode"><option value="fixed" {{#if (eq action.modifier_value_mode "fixed")}}selected{{/if}}>{{localize "GUM.EffectSheet.FixedValue"}}</option><option value="per_origin_level" {{#if (eq action.modifier_value_mode "per_origin_level")}}selected{{/if}}>{{localize "GUM.EffectSheet.PerSourceItemLevel"}}</option></select></div>
                                                        </div>
                                                        <div class="effect-premium-field">
                                                            <label class="effect-premium-field-label">{{localize "GUM.EffectSheet.Display"}}</label>
                                                            <div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.modifier_nh_display_mode"><option value="roll_only" {{#if (eq action.modifier_nh_display_mode "roll_only")}}selected{{/if}}>{{localize "GUM.EffectSheet.RollOnly"}}</option><option value="include_in_nh" {{#if (eq action.modifier_nh_display_mode "include_in_nh")}}selected{{/if}}>{{localize "GUM.EffectSheet.IncludeInNh"}}</option></select></div>
                                                        </div>
                                                        <div class="effect-premium-field">
                                                            <label class="effect-premium-field-label">{{localize "GUM.EffectSheet.ApplyTo"}}</label>
                                                            <div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.modifier_application_side">{{#each ../rollModifierApplicationOptions as |opt|}}<option value="{{opt.id}}" {{#if (eq opt.id ../modifier_application_side)}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            {{/if}}

                                            {{! TIPO: MODIFICAR MODO DE COMBATE }}
                                            {{#if (eq action.type "combat_modifier")}}
                                                <div class="effect-premium-roll-compact effect-specialized-action">
                                                    <div class="effect-specialized-grid effect-specialized-grid-two">
                                                        <div class="effect-premium-field"><label class="effect-premium-field-label">{{localize "GUM.EffectSheet.AffectedModes"}}</label><div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.combat_scope"><option value="all" {{#if (eq action.combat_scope "all")}}selected{{/if}}>{{localize "GUM.EffectSheet.AllModes"}}</option><option value="melee" {{#if (eq action.combat_scope "melee")}}selected{{/if}}>{{localize "GUM.EffectSheet.Melee"}}</option><option value="ranged" {{#if (eq action.combat_scope "ranged")}}selected{{/if}}>{{localize "GUM.EffectSheet.Ranged"}}</option><option value="specific" {{#if (eq action.combat_scope "specific")}}selected{{/if}}>{{localize "GUM.EffectSheet.SpecificItemsModes"}}</option></select></div></div>
                                                        <div class="effect-premium-field"><label class="effect-premium-field-label">{{localize "GUM.EffectSheet.ApplyTo"}}</label><div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.modifier_application_side">{{#each ../rollModifierApplicationOptions as |opt|}}<option value="{{opt.id}}" {{#if (eq opt.id ../modifier_application_side)}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select></div></div>
                                                    </div>

                                                    <div class="effect-specialized-grid effect-specialized-grid-three">
                                                        <div class="effect-premium-field {{#unless (eq action.combat_scope "specific")}}is-disabled{{/unless}}"><label class="effect-premium-field-label">{{localize "GUM.EffectSheet.ItemWeapon"}}</label><div class="effect-premium-field-control"><input type="text" name="system.actions.{{action.index}}.combat_source_item_ids" value="{{action.combat_source_item_ids}}" placeholder="{{localize 'GUM.EffectSheet.ExampleItemWeapon'}}" {{#unless (eq action.combat_scope "specific")}}disabled{{/unless}}/></div></div>
