            {{! ===================================================== }}
            <div class="tab" data-tab="configuracao" data-group="primary">

                <div
                    class="effect-row-grid effect-duration-grid is-two-col-rows"
                    style="margin: 5px;"
                >
                    <div class="effect-field effect-field-row">
                        <div class="effect-label">{{localize "GUM.EffectSheet.TokenIcon"}}</div>

                        <select name="system.tokenIconPolicy">
                            {{#each tokenIconPolicyOptions as |policy|}}
                                <option
                                    value="{{policy.id}}"
                                    {{#if (eq ../system.tokenIconPolicy policy.id)}}selected{{/if}}
                                >
                                    {{policy.label}}
                                </option>
                            {{/each}}
                        </select>
                    </div>

                 <div class="effect-field effect-field-row">
                        <div class="effect-label">{{localize "GUM.EffectSheet.ConditionStacking"}}</div>

                        <select
                            name="system.conditionStackingMode"
                            title="{{localize 'GUM.EffectSheet.ConditionStackingHint'}}"
                        >
                            {{#each conditionStackingModeOptions as |mode|}}
                                <option
                                    value="{{mode.id}}"
                                    {{#if (eq ../system.conditionStackingMode mode.id)}}selected{{/if}}
                                >
                                    {{mode.label}}
                                </option>
                            {{/each}}
                        </select>
                    </div>
                </div>

                {{#if (eq system.conditionStackingMode "unique")}}
                    <p class="hint" style="margin: 0 10px 10px;">
                        {{localize "GUM.EffectSheet.ConditionStackingExplanation"}}
                    </p>
                {{/if}}
                {{#if (eq system.conditionStackingMode "refresh")}}
                    <p class="hint" style="margin: 0 10px 10px;">
                        {{localize "GUM.EffectSheet.StackingRefreshExplanation"}}
                    </p>
                {{/if}}

 {{!-- DURAÇÃO E EXPIRAÇÃO --}}
                    <section class="effect-card effect-section effect-duration-section">
                        <div class="effect-section-header">
                            <h4 class="effect-section-title">
                                {{localize "GUM.EffectSheet.EffectDuration"}}
                            </h4>

                            <div class="effect-section-select">
                                <select
                                    class="duration-mode-select"
                                    name="system.duration._uiMode"
                                >
                                    <option
                                        value="permanent"
                                        {{#if system.duration.isPermanent}}selected{{/if}}
                                    >
                                        {{localize "GUM.EffectSheet.Permanent"}}
                                    </option>

                                    <option
                                        value="combat"
                                        {{#if (and (not system.duration.isPermanent) system.duration.inCombat)}}selected{{/if}}
                                    >
                                        {{localize "GUM.EffectSheet.TemporaryCombat"}}
                                    </option>
                                </select>
                            </div>
                        </div>

                        <input
                            type="checkbox"
                            class="duration-hidden"
                            name="system.duration.isPermanent"
                            {{checked system.duration.isPermanent}}
                        />

                        <input
                            type="checkbox"
                            class="duration-hidden"
                            name="system.duration.inCombat"
                            {{checked system.duration.inCombat}}
                        />

                        <div class="effect-section-body">
                            <p class="hint">
                                {{localize "GUM.EffectSheet.PersistentDurationHint"}}
                            </p>

                            {{#unless hasPersistentActions}}
                                <p class="hint effect-duration-state-hint">
                                    {{localize "GUM.EffectSheet.NoPersistentActionsHint"}}
                                </p>
                            {{/unless}}

                            {{#if hasInstantActions}}
                                <p class="hint effect-duration-state-hint">
                                    {{localize "GUM.EffectSheet.InstantActionsDurationHint"}}
                                </p>
                            {{/if}}

                            {{#if (and system.duration.isPermanent hasPersistentActions)}}
                                <p class="hint">
                                    {{localize "GUM.EffectSheet.PassiveEffectHint"}}
                                </p>
                            {{/if}}

                            {{#unless system.duration.isPermanent}}
                                {{#if system.duration.inCombat}}
                                    <div class="effect-row-grid effect-duration-grid is-two-col-rows">

                                        <div class="effect-field effect-field-row">
                                            <div class="effect-label">
                                                {{localize "GUM.EffectSheet.CountStart"}}
                                            </div>

                                            <select
                                                class="effect-dropmenu-text"
                                                name="system.duration.startMode"
                                            >
                                                <option
                                                    value="apply"
                                                    {{#if (eq system.duration.startMode "apply")}}selected{{/if}}
                                                >
                                                    {{localize "GUM.EffectSheet.OnApply"}}
                                                </option>

                                                <option
                                                    value="nextTurnStart"
                                                    {{#if (eq system.duration.startMode "nextTurnStart")}}selected{{/if}}
                                                >
                                                    {{localize "GUM.EffectSheet.NextTurnStart"}}
                                                </option>
                                            </select>
                                        </div>

                                        <div class="effect-field effect-field-row">
                                            <div class="effect-label">
                                                {{localize "GUM.EffectSheet.RoundsSeconds"}}
                                            </div>

                                            <input
                                                type="number"
                                                name="system.duration.value"
                                                value="{{system.duration.value}}"
                                                min="1"
                                            />
                                        </div>

                                        <div class="effect-field effect-field-row">
                                            <div class="effect-label">
                                                {{localize "GUM.EffectSheet.CountEnd"}}
                                            </div>

                                            <select name="system.duration.endMode">
                                                <option
                                                    value="turnStart"
                                                    {{#if (eq system.duration.endMode "turnStart")}}selected{{/if}}
                                                >
                                                    {{localize "GUM.EffectSheet.FinalTurnStart"}}
                                                </option>

                                                <option
                                                    value="turnEnd"
                                                    {{#if (eq system.duration.endMode "turnEnd")}}selected{{/if}}
                                                >
                                                    {{localize "GUM.EffectSheet.FinalTurnEnd"}}
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                {{/if}}
                            {{/unless}}
                        </div>
                    </section>

                {{!-- BARREIRA DE RESISTÊNCIA --}}
                <section class="effect-card effect-section effect-resistance-section">
                    <div class="effect-section-header">
                        <h4 class="effect-section-title">
                            {{localize "GUM.EffectSheet.ResistanceBarrier"}}
                        </h4>

                        <label
                            class="effect-section-toggle"
                            title="{{localize 'GUM.EffectSheet.EnableBarrier'}}"
                        >
                            <input
                                type="checkbox"
                                name="system.resistanceRoll.isResisted"
                                {{checked system.resistanceRoll.isResisted}}
                            />
                            <span></span>
                        </label>
                    </div>

                    <div
                        class="
                             effect-section-body effect-resistance-body
                            {{#unless system.resistanceRoll.isResisted}}is-muted{{/unless}}
                        "
                    >
                        <div
                            class="effect-field effect-field-full"
                            style="margin-bottom: 10px;"
                        >
                            <div class="effect-label">
                                {{localize "GUM.EffectSheet.ResistanceCardText"}}
                            </div>

                            <textarea
                                name="system.resistanceRoll.chatText"
                                rows="2"
                                placeholder="{{localize 'GUM.EffectSheet.Optional'}}"
                                {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                            >{{system.resistanceRoll.chatText}}</textarea>
                        </div>

                        <div class="effect-row-grid resistance-settings-row">
                            <div class="effect-field resistance-setting-card resistance-mode-field">
                                <div class="effect-label">{{localize "GUM.EffectSheet.ApplicationMode"}}</div>
                                <select name="system.resistanceRoll.mode" {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}>
                                    <option value="simple" {{#unless isConditionalResistance}}selected{{/unless}}>{{localize "GUM.EffectSheet.SimpleApplyAll"}}</option>
                                    <option value="conditional" {{#if isConditionalResistance}}selected{{/if}}>{{localize "GUM.EffectSheet.ConditionalResults"}}</option>
                                </select>
                            </div>

                            <div class="effect-field resistance-setting-card resistance-visibility-field">
                                <div class="effect-label">{{localize "GUM.EffectSheet.TestVisibility"}}</div>
                                <select name="system.resistanceRoll.chatVisibility" {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}>
                                    <option value="public" {{#if (eq system.resistanceRoll.chatVisibility "public")}}selected{{/if}}>{{localize "GUM.EffectSheet.PublicEveryone"}}</option>
                                    <option value="owners" {{#unless (or (eq system.resistanceRoll.chatVisibility "public") (eq system.resistanceRoll.chatVisibility "target"))}}selected{{/unless}}>{{localize "GUM.EffectSheet.TargetAndGM"}}</option>
                                    <option value="target" {{#if (eq system.resistanceRoll.chatVisibility "target")}}selected{{/if}}>{{localize "GUM.EffectSheet.TargetOnly"}}</option>
                                </select>
                            </div>
                        </div>

                        <div class="effect-row-grid effect-resistance-grid">

                            <div class="effect-field {{#if isConditionalResistance}}is-hidden{{/if}}">
                                <div class="effect-label">
                                    {{localize "GUM.EffectSheet.ApplyEffectTo"}}
                                </div>

                                <select
                                    name="system.resistanceRoll.applyOn"
                                    {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                                >
                                    <option
                                        value="failure"
                                        {{#if (eq system.resistanceRoll.applyOn "failure")}}selected{{/if}}
                                    >
                                        {{localize "GUM.EffectSheet.OnFailure"}}
                                    </option>

                                    <option
                                        value="success"
                                        {{#if (eq system.resistanceRoll.applyOn "success")}}selected{{/if}}
                                    >
                                        {{localize "GUM.EffectSheet.OnSuccess"}}
                                    </option>
                                </select>
                            </div>

                            <div class="effect-field">
                                <div class="effect-label">{{localize "GUM.EffectSheet.Attribute"}}</div>

                                <input
                                    type="text"
                                    name="system.resistanceRoll.attribute"
                                    value="{{system.resistanceRoll.attribute}}"
                                    {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                                />
                            </div>

                            <div class="effect-field {{#if isConditionalResistance}}is-hidden{{/if}}">
                                <div class="effect-label">{{localize "GUM.EffectSheet.MinimumMarginShort"}}</div>

                                <input
                                    type="text"
                                    name="system.resistanceRoll.margin"
                                    value="{{system.resistanceRoll.margin}}"
                                    placeholder="{{localize 'GUM.EffectSheet.Optional'}}"
                                    {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                                />
                            </div>
                        </div>

                        <div
                            class="effect-field"
                            style="margin-bottom: 15px;"
                        >
                            <div class="effect-label">{{localize "GUM.EffectSheet.Modifier"}}</div>

                            <textarea
                                rows="1"
                                class="effect-code-input effect-resizable-code-input"
                                name="system.resistanceRoll.modifier"
                                {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                            >{{system.resistanceRoll.modifier}}</textarea>
                        </div>

                        {{#if isConditionalResistance}}
                            <div class="resistance-branches">
                                <div class="resistance-branches-header">
                                    <div>{{localize "GUM.EffectSheet.ResultsAllMatching"}}</div>
                                    <button type="button" class="add-resistance-branch"><i class="fas fa-plus"></i> {{localize "GUM.EffectSheet.AddOutcome"}}</button>
                                </div>
                                {{#each resistanceBranches as |branch|}}
                                    <article class="resistance-branch" data-branch-index="{{branch.index}}">
                                        <input type="hidden" name="system.resistanceRoll.branches.{{branch.index}}.id" value="{{branch.id}}">
                                        <div class="resistance-branch-heading">
                                            <input type="text" name="system.resistanceRoll.branches.{{branch.index}}.label" value="{{branch.label}}" aria-label="{{localize 'GUM.EffectSheet.OutcomeName'}}">
                                            <button type="button" class="move-resistance-branch" data-index="{{branch.index}}" data-direction="-1" title="{{localize 'GUM.EffectSheet.MoveUp'}}"><i class="fas fa-arrow-up"></i></button>
                                            <button type="button" class="move-resistance-branch" data-index="{{branch.index}}" data-direction="1" title="{{localize 'GUM.EffectSheet.MoveDown'}}"><i class="fas fa-arrow-down"></i></button>
                                            <button type="button" class="remove-resistance-branch" data-index="{{branch.index}}" title="{{localize 'GUM.EffectSheet.RemoveOutcome'}}"><i class="fas fa-trash"></i></button>
                                        </div>
                                        <div class="resistance-branch-condition">
                                            <span class="resistance-condition-label">{{localize "GUM.EffectSheet.Condition"}}</span>
                                            <select name="system.resistanceRoll.branches.{{branch.index}}.condition.type" aria-label="{{localize 'GUM.EffectSheet.ConditionType'}}">
                                                <option value="outcome" {{#unless branch.isOtherwise}}selected{{/unless}}>{{localize "GUM.EffectSheet.TestOutcome"}}</option>
                                                <option value="otherwise" {{#if branch.isOtherwise}}selected{{/if}}>{{localize "GUM.EffectSheet.Otherwise"}}</option>
                                            </select>
                                            <select name="system.resistanceRoll.branches.{{branch.index}}.condition.outcome" aria-label="{{localize 'GUM.EffectSheet.TestOutcome'}}" {{#if branch.isOtherwise}}disabled{{/if}}>
                                                <option value="failure" {{#if branch.isFailure}}selected{{/if}}>{{localize "GUM.EffectSheet.Failure"}}</option>
                                                <option value="success" {{#if branch.isSuccess}}selected{{/if}}>{{localize "GUM.EffectSheet.Success"}}</option>
                                                <option value="critical-failure" {{#if branch.isCriticalFailure}}selected{{/if}}>{{localize "GUM.RollRequest.CriticalFailure"}}</option>
                                                <option value="critical-success" {{#if branch.isCriticalSuccess}}selected{{/if}}>{{localize "GUM.RollRequest.CriticalSuccess"}}</option>
                                            </select>
                                            <label>{{localize "GUM.EffectSheet.MinimumMargin"}} <input type="number" min="0" step="1" name="system.resistanceRoll.branches.{{branch.index}}.condition.minimumMargin" value="{{branch.condition.minimumMargin}}" {{#if branch.isOtherwise}}disabled{{/if}}></label>
                                            <label>{{localize "GUM.EffectSheet.MaximumMargin"}} <input type="number" min="0" step="1" name="system.resistanceRoll.branches.{{branch.index}}.condition.maximumMargin" value="{{branch.maximumMargin}}" placeholder="{{localize 'GUM.EffectSheet.NoLimit'}}" {{#if branch.isOtherwise}}disabled{{/if}}></label>
                                        </div>
                                        <input type="hidden" name="system.resistanceRoll.branches.{{branch.index}}.actionIds" value="{{branch.actionIdsCsv}}">
                                        <div class="resistance-branch-actions">
                                            <span class="resistance-action-summary">{{branch.actionSummary}}</span>
                                            <button type="button" class="select-resistance-actions" data-index="{{branch.index}}"><i class="fas fa-search"></i> {{localize "GUM.EffectSheet.SelectActions"}}</button>
                                        </div>
                                    </article>
                                {{else}}
                                    <p class="hint">{{localize "GUM.EffectSheet.AddOutcomeHint"}}</p>
                                {{/each}}
                            </div>
                        {{/if}}

                        <label class="custom-checkbox block effect-inline-checkbox">
                            <input
                                type="checkbox"
                                name="system.resistanceRoll.skipPromptCard"
                                {{checked system.resistanceRoll.skipPromptCard}}
                                {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                            />

                            <span>
                                {{localize "GUM.EffectSheet.SkipPromptHint"}}
                            </span>
                        </label>

                        <div class="effect-field effect-field-full" style="margin-bottom: 15px;">
                            <div class="effect-purpose-control resistance-purpose-control">
                                <input type="hidden" name="system.resistanceRoll.requestedPurposeIds" value="{{resistancePurposeIdsCsv}}" />
                                <div class="resistance-purpose-heading">
                                    <div class="effect-label">{{localize "GUM.EffectSheet.TestPurposes"}}</div>
                                    <button type="button" class="open-purpose-picker resistance-purpose-add" data-target-input="system.resistanceRoll.requestedPurposeIds" data-attribute-input="system.resistanceRoll.attribute" {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}><i class="fas fa-pen-nib" aria-hidden="true"></i> {{localize "GUM.EffectSheet.EditPurposes"}}</button>
                                </div>
                                <div class="resistance-purpose-list{{#unless resistancePurposeLabels.length}} is-empty{{/unless}}" aria-live="polite">
                                    {{#each resistancePurposeLabels as |purposeLabel|}}
                                        <span class="resistance-purpose-item">{{purposeLabel}}</span>
                                    {{else}}
                                        <span class="resistance-purpose-empty">{{localize "GUM.EffectSheet.NoPurposesAdded"}}</span>
                                    {{/each}}
                                </div>
                            </div>
                        </div>


                     </div>
                </section>

                <section class="effect-automation-reference" aria-labelledby="effect-automation-reference-title">
                    <div class="effect-automation-reference-heading" id="effect-automation-reference-title">
                        <i class="fas fa-link" aria-hidden="true"></i>
                        <span>{{localize "GUM.EffectSheet.AutomationIntegration"}}</span>
                    </div>
                    <p class="effect-automation-reference-hint">{{localize "GUM.EffectSheet.AutomationIntegrationHint"}}</p>

                    <div class="effect-automation-reference-list">
                        <label class="effect-automation-reference-row">
                            <span>{{localize "GUM.EffectSheet.EffectItemUuid"}}</span>
                            <span class="effect-automation-reference-control">
                                <input type="text" value="{{effectItemUuid}}" readonly aria-label="{{localize 'GUM.EffectSheet.EffectItemUuid'}}" />
                                <button type="button" class="copy-effect-automation-uuid" data-uuid="{{effectItemUuid}}" title="{{localize 'GUM.EffectSheet.CopyUuid'}}" aria-label="{{localize 'GUM.EffectSheet.CopyUuid'}}">
                                    <i class="fas fa-paste" aria-hidden="true"></i>
                                </button>
                            </span>
                        </label>

                        <label class="effect-automation-reference-row">
                            <span>{{localize "GUM.EffectSheet.ActiveEffectBridgeUuid"}}</span>
                            <span class="effect-automation-reference-control">
                                <input type="text" value="{{activeEffectBridgeUuid}}" readonly placeholder="{{localize 'GUM.EffectSheet.ActiveEffectBridgeUnavailable'}}" aria-label="{{localize 'GUM.EffectSheet.ActiveEffectBridgeUuid'}}" />
                                <button type="button" class="copy-effect-automation-uuid" data-uuid="{{activeEffectBridgeUuid}}" title="{{localize 'GUM.EffectSheet.CopyUuid'}}" aria-label="{{localize 'GUM.EffectSheet.CopyUuid'}}" {{#unless hasActiveEffectBridge}}disabled{{/unless}}>
                                    <i class="fas fa-paste" aria-hidden="true"></i>
                                </button>
                            </span>
                        </label>
                    </div>
                </section>
            </div>
        </div>
    </main>
</form>
