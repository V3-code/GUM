{
  "title": "GUM (Não Oficial)",
  "id": "gum",
  "version": "1.6.1-beta",
  "description": "Ferramenta não oficial e gratuita para uso de GURPS no Foundry VTT. Criada por fã, sem fins lucrativos e sem conteúdo de publicações de GURPS.",
  "authors": [
    {
      "name": "Victor Valentim",
      "url": "https://github.com/V3-code"
    }
  ],
  "languages": [
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "documentTypes": {
    "RegionBehavior": {
      "applyEffect": {}
    }
  },
  "grid": {
    "distance": 1,
    "units": "m"
  },
  "primaryTokenAttribute": "attributes.hp",
  "secondaryTokenAttribute": "attributes.fp",
  "initiative": "@attributes.basic_speed.final + (@attributes.dx.final/100) + (1d6/1000)",
  "esmodules": [
    "scripts/main.js",
    "scripts/journal-pdf.js",
    "scripts/gum-data.js",
    "module/config.js",
    "module/item/gurps-item-sheet.js",
    "module/actor/gurps-actor-sheet.js",
    "scripts/apps/condition-builder.js",
    "scripts/apps/effect-builder.js",
    "scripts/apps/effect-sheet.js",
    "scripts/effects-engine.js",
    "scripts/apps/trigger-sheet.js",
    "scripts/apps/condition-sheet.js",
    "scripts/apps/damage-application.js",
    "module/settings.js",
    "module/apps/roll-prompt.js",
    "module/apps/gm-screen.js",
    "module/apps/gm-modifier-browser.js",
    "module/apps/modifier-browser.js",
    "module/apps/effect-browser.js",
    "module/apps/template-browser.js",
    "module/apps/eqp-modifier-browser.js",
    "module/apps/trigger-browser.js",
    "module/apps/importers.js",
    "module/apps/content-source-config.js"
  ],
  "styles": [
    "styles/styles.css",
    "styles/browsers.css",
    "styles/item-sheet.css",
    "styles/damage-application.css",
    "styles/roll-prompt.css",
    "styles/gm-screen.css",
    "styles/test-request.css",
    "styles/conditions.css",
    "styles/condition-builder.css",
    "styles/hex-occupancy.css"
  ],
  "packs": [],
  "license": "https://raw.githubusercontent.com/V3-code/GUM/master/LICENSE.md",
  "url": "https://github.com/V3-code/GUM",
  "manifest": "https://raw.githubusercontent.com/V3-code/GUM/master/system.json",
  "download": "https://github.com/V3-code/GUM/releases/download/v1.6.1-beta/gum.zip",
  "readme": "https://raw.githubusercontent.com/V3-code/GUM/master/README.md",
  "changelog": "https://raw.githubusercontent.com/V3-code/GUM/master/CHANGELOG.md",
  "bugs": "https://github.com/V3-code/GUM/issues"
}
